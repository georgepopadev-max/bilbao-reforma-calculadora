{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/blog/subvencion-accesibilidad-bilbao/",
      "destination": "/blog/subvencion-accesibilidad-bilbao.html"
    },
    {
      "source": "/blog/subvencion-accesibilidad-donostia/",
      "destination": "/blog/subvencion-accesibilidad-donostia.html"
    },
    {
      "source": "/blog/subvencion-cambio-calderas-vitoria/",
      "destination": "/blog/subvencion-cambio-calderas-vitoria.html"
    },
    {
      "source": "/blog/subvencion-cambio-ventanas-bilbao/",
      "destination": "/blog/subvencion-cambio-ventanas-bilbao.html"
    },
    {
      "source": "/blog/subvencion-eficiencia-energetica-bilbao/",
      "destination": "/blog/subvencion-eficiencia-energetica-bilbao.html"
    },
    {
      "source": "/blog/subvencion-fachadas-bilbao/",
      "destination": "/blog/subvencion-fachadas-bilbao.html"
    },
    {
      "source": "/blog/subvencion-rehabilitacion-energetica-donostia/",
      "destination": "/blog/subvencion-rehabilitacion-energetica-donostia.html"
    }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}