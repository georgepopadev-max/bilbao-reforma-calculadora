{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/vitoria/blog/subvenciones-reformas-vitoria(\\.html)?",
      "destination": "/blog/subvenciones-reformas-vitoria",
      "permanent": true
    },
    {
      "source": "/donostia/blog/subvenciones-reformas-donostia(\\.html)?",
      "destination": "/blog/subvenciones-reformas-donostia",
      "permanent": true
    },
    {
      "source": "/donostia/blog/bano-reforma-donostia(\\.html)?",
      "destination": "/donostia/blog/reforma-bano-donostia-precios-2026",
      "permanent": true
    },
    {
      "source": "/vitoria/blog/pintar-piso-vitoria(\\.html)?",
      "destination": "/blog/pintar-piso-vitoria",
      "permanent": true
    },
    {
      "source": "/blog/licencias-obra-bilbao(\\.html)?",
      "destination": "/blog/licencias-obra-bilbao-2026",
      "permanent": true
    },
    {
      "source": "/blog/licencias-obra-2026(\\.html)?",
      "destination": "/blog/licencias-obra-bilbao-2026",
      "permanent": true
    },
    {
      "source": "/blog/licencias-obra-mayor-bilbao-2026(\\.html)?",
      "destination": "/blog/licencias-obra-bilbao-2026",
      "permanent": true
    },
    {
      "source": "/presupuesto-pintura-piso(\\.html)?",
      "destination": "/presupuesto-pintura-piso-bilbao",
      "permanent": true
    },
    {
      "source": "/donostia/calcular-reforma/:path*",
      "destination": "/donostia/calculadora",
      "permanent": true
    },
    {
      "source": "/donostia/calcular-reforma(\\.html)?",
      "destination": "/donostia/calculadora",
      "permanent": true
    },
    {
      "source": "/vitoria/calcular-reforma/:path*",
      "destination": "/vitoria/calculadora",
      "permanent": true
    },
    {
      "source": "/vitoria/calcular-reforma(\\.html)?",
      "destination": "/vitoria/calculadora",
      "permanent": true
    },
    {
      "source": "/calculadora/index.html",
      "destination": "/calculadora",
      "permanent": true
    },
    {
      "source": "/empresas/index.html",
      "destination": "/empresas",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/donostia/index.html",
      "destination": "/donostia",
      "permanent": true
    },
    {
      "source": "/vitoria/index.html",
      "destination": "/vitoria",
      "permanent": true
    },
    {
      "source": "/donostia/calculadora/index.html",
      "destination": "/donostia/calculadora",
      "permanent": true
    },
    {
      "source": "/donostia/empresas/index.html",
      "destination": "/donostia/empresas",
      "permanent": true
    },
    {
      "source": "/donostia/blog/index.html",
      "destination": "/donostia/blog",
      "permanent": true
    },
    {
      "source": "/vitoria/calculadora/index.html",
      "destination": "/vitoria/calculadora",
      "permanent": true
    },
    {
      "source": "/vitoria/empresas/index.html",
      "destination": "/vitoria/empresas",
      "permanent": true
    },
    {
      "source": "/donostia/calculadora/bano",
      "destination": "/donostia/calculadora/bano-donostia",
      "permanent": true
    },
    {
      "source": "/donostia/calculadora/cocina",
      "destination": "/donostia/calculadora/cocina-donostia",
      "permanent": true
    },
    {
      "source": "/donostia/calculadora/pintura",
      "destination": "/donostia/calculadora/pintura-donostia",
      "permanent": true
    },
    {
      "source": "/donostia/calculadora/suelo",
      "destination": "/donostia/calculadora/suelo-donostia",
      "permanent": true
    },
    {
      "source": "/donostia/calculadora/integral",
      "destination": "/donostia/calculadora/integral-donostia",
      "permanent": true
    },
    {
      "source": "/vitoria/calculadora/bano",
      "destination": "/vitoria/calculadora/bano-vitoria",
      "permanent": true
    },
    {
      "source": "/vitoria/calculadora/cocina",
      "destination": "/vitoria/calculadora/cocina-vitoria",
      "permanent": true
    },
    {
      "source": "/vitoria/calculadora/pintura",
      "destination": "/vitoria/calculadora/pintura-vitoria",
      "permanent": true
    },
    {
      "source": "/vitoria/calculadora/suelo",
      "destination": "/vitoria/calculadora/suelo-vitoria",
      "permanent": true
    },
    {
      "source": "/vitoria/calculadora/integral",
      "destination": "/vitoria/calculadora/integral-vitoria",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bilbao/blog/(.+?)(\\.html)?",
      "destination": "/blog/$1",
      "permanent": true
    },
    {
      "source": "/bilbao/blog(\\.html|/index\\.html|/)?",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/bilbao/calculadora/(.+?)(\\.html)?",
      "destination": "/calculadora/$1",
      "permanent": true
    },
    {
      "source": "/bilbao/calculadora(\\.html|/index\\.html|/)?",
      "destination": "/calculadora",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
