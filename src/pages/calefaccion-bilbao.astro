---
import HubLayout from '../layouts/HubLayout.astro';

const items = [
  { title: 'Precio Calefacción Bilbao 2026 | Guía Completa', href: '/blog/precio-calefaccion-bilbao.html', description: 'Precio calefacción desde 3.500€. Compara gas, aerotermia y suelo radiante.', category: 'CALEFACCIÓN', readTime: '9 min' },
  { title: 'Tipos Calefacción Bilbao 2026 | Guía', href: '/blog/tipos-calefaccion-bilbao.html', description: 'Gas, aerotermia, suelo radiante, biomasa. Compara precios.', category: 'CALEFACCIÓN', readTime: '8 min' },
  { title: 'Suelo Radiante Bilbao 2026 | Guía + Precio', href: '/blog/suelo-radiante-ventajas-bilbao.html', description: 'Precio 70-100€/m², ventajas, instalación y subvenciones 2026.', category: 'CALEFACCIÓN', readTime: '9 min' },
  { title: 'Instalación Suelo Radiante Bilbao 2026 | Precio', href: '/blog/instalacion-suelo-radiante-bilbao.html', description: 'Proceso paso a paso y precio desglosado.', category: 'CALEFACCIÓN', readTime: '10 min' },
  { title: 'Aerotermia Bilbao 2026 | Ventajas y Precio', href: '/blog/aerotermia-bilbao-ventajas.html', description: 'Ventajas, precio 12.000-18.000€ y subvenciones 2026.', category: 'CALEFACCIÓN', readTime: '10 min' },
  { title: 'Aerotermia Precio Bilbao 2026 | Guía Completa', href: '/blog/aerotermia-precio-bilbao.html', description: 'Ahorro energético hasta 70% y ayudas Plan Rehabilitación.', category: 'CALEFACCIÓN', readTime: '10 min' },
  { title: 'Cambiar Caldera Bilbao 2026 | Precio y Subvenciones', href: '/blog/cambio-caldera-bilbao.html', description: 'Precio 3.500-7.000€. Tipos y subvenciones 2026.', category: 'CALEFACCIÓN', readTime: '9 min' },
  { title: 'Suelo Radiante vs Radiadores Bilbao', href: '/blog/suelo-radiante-vs-calefaccion.html', description: 'Comparativa real, precio, eficiencia y cuándo conviene.', category: 'CALEFACCIÓN', readTime: '8 min' },
  { title: 'Subvenciones Calefacción Bilbao 2026 | Ayudas', href: '/blog/subvenciones-calefaccion-bilbao.html', description: 'Plan Next Generation, Gobierno Vasco, Ayto Bilbao. Hasta 6.000€.', category: 'CALEFACCIÓN', readTime: '9 min' },
  { title: 'Fontanero Bilbao 2026 | Precios y Servicios', href: '/blog/fontanero-bilbao.html', description: 'Precio 30-50€/h. Servicios urgentes, calefacción, reformas baño.', category: 'FONTANERÍA', readTime: '8 min' },
];

const faqs = [
  { q: '¿Cuánto cuesta instalar calefacción en un piso de 80m² en Bilbao?', a: 'El precio varía según el sistema: radiadores de gas natural desde 4.500€; aerotermia desde 12.000€; suelo radiante desde 6.400€ (solo instalación). El coste total con aerotermia y suelo radiante puede alcanzar los 18.000-22.000€.' },
  { q: '¿Qué sistema de calefacción es más eficiente en Bilbao?', a: 'La aerotermia es el sistema más eficiente: hasta un 70% menos de consumo que el gas natural. Combinada con suelo radiante, es la opción óptima para climatización en el clima de Bilbao.' },
  { q: '¿Hay subvenciones para instalar calefacción en Bilbao en 2026?', a: 'Sí. El Plan Rehabilitación Energética Next Generation cubre hasta el 40% de la inversión. El Gobierno Vasco añade hasta 12.000€ por vivienda para aerotermia. El Ayuntamiento de Bilbao bonifica el IBI hasta un 50% durante 5 años.' },
  { q: '¿Suelo radiante o radiadores? ¿Qué conviene más?', a: 'El suelo radiante es más eficiente y confortable, pero requiere obra de reforma del suelo. Los radiadores son más baratos de instalar y suficientes para edificios con buen aislamiento. La mejor opción depende de tu presupuesto y si ya vas a cambiar el suelo.' },
  { q: '¿Cuánto tarda la instalación de suelo radiante en un piso?', a: 'La instalación de suelo radiante en un piso de 80m² suele tardar entre 5 y 7 días laborables de obra, más 7-10 días de curado del mortero antes de encender el sistema.' },
];
---
<HubLayout
  title="Calefacción Bilbao 2026 | Guía + Empresas"
  description="Calefacción en Bilbao 2026: tipos, precios y empresas. Guía completa de gas, aerotermia, suelo radiante y biomasa. Subvenciones hasta 40%."
  canonical="https://www.bilbaoreforma.es/calefaccion-bilbao.html"
  category="calefaccion"
  city="bilbao"
  datePublished="2026-07-03"
  dateModified="2026-07-03"
  items={items}
  faqs={faqs}
  ogImage="https://www.bilbaoreforma.es/images/og/bilbao-og.jpg"
  ogImageAlt="Calefacción Bilbao 2026"
>
  <main style="max-width: 1100px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="font-size: 0.875rem; color: var(--color-gris); margin-bottom: 1.5rem;">
      <a href="/index.html" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span style="margin: 0 0.5rem;">›</span>
      <a href="/blog/index.html" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span style="margin: 0 0.5rem;">›</span>
      <span>Calefacción Bilbao</span>
    </nav>

    <header style="margin-bottom: 2.5rem;">
      <h1 style="font-family: var(--font-inter); font-size: clamp(1.625rem, 5vw, 2.5rem); font-weight: 700; color: var(--color-grafito); margin-bottom: 1rem; line-height: 1.2;">
        Calefacción en Bilbao 2026 | Guía Completa + Empresas
      </h1>
      <p style="font-size: 1.125rem; color: var(--color-gris); line-height: 1.6; max-width: 800px;">
        Guía actualizada de calefacción en Bilbao: tipos de sistemas, precios reales de instalación y comparación entre gas, aerotermia, suelo radiante y biomasa. Empresas especializadas y subvenciones vigentes en 2026.
      </p>
    </header>

    <section style="background: var(--color-crema); border-radius: var(--radius-card); padding: 2rem; margin-bottom: 3rem;">
      <h2 style="font-family: var(--font-inter); font-size: clamp(1.25rem, 4vw, 1.75rem); font-weight: 600; color: var(--color-grafito); margin-bottom: 1rem;">
        Comparativa de sistemas de calefacción en Bilbao 2026
      </h2>
      <p style="font-size: 1rem; color: var(--color-gris); margin-bottom: 1.25rem; line-height: 1.6;">
        Estos son los rangos de precio y características de los principales sistemas de calefacción disponibles en Bilbao:
      </p>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; background: white; border-radius: var(--radius-card); overflow: hidden;">
          <thead>
            <tr style="background: var(--color-terracota); color: white;">
              <th style="padding: 0.875rem; text-align: left; font-weight: 600;">Sistema</th>
              <th style="padding: 0.875rem; text-align: left; font-weight: 600;">Precio instalación</th>
              <th style="padding: 0.875rem; text-align: left; font-weight: 600;">Ahorro vs gas</th>
              <th style="padding: 0.875rem; text-align: left; font-weight: 600;">Ventajas</th>
              <th style="padding: 0.875rem; text-align: left; font-weight: 600;">Inconvenientes</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 0.875rem; font-weight: 600;">Caldera gas natural</td>
              <td style="padding: 0.875rem;">3.500 – 6.000 €</td>
              <td style="padding: 0.875rem;">—</td>
              <td style="padding: 0.875rem;">Económico, infraestructura existente</td>
              <td style="padding: 0.875rem;">Emisiones CO2, precio gas variable</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee; background: #f9f9f9;">
              <td style="padding: 0.875rem; font-weight: 600;">Aerotermia</td>
              <td style="padding: 0.875rem;">12.000 – 18.000 €</td>
              <td style="padding: 0.875rem;">Hasta 70%</td>
              <td style="padding: 0.875rem;">Máximo ahorro, refrigeración, renovables</td>
              <td style="padding: 0.875rem;">Mayor inversión inicial</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 0.875rem; font-weight: 600;">Suelo radiante</td>
              <td style="padding: 0.875rem;">70 – 100 €/m²</td>
              <td style="padding: 0.875rem;">15 – 20%</td>
              <td style="padding: 0.875rem;">Confort uniforme, invisible</td>
              <td style="padding: 0.875rem;">Obra de reforma del suelo</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee; background: #f9f9f9;">
              <td style="padding: 0.875rem; font-weight: 600;">Biomasa (pellet)</td>
              <td style="padding: 0.875rem;">6.000 – 12.000 €</td>
              <td style="padding: 0.875rem;">20 – 40%</td>
              <td style="padding: 0.875rem;">Energía renovable, coste estable</td>
              <td style="padding: 0.875rem;">Necesita espacio silo</td>
            </tr>
            <tr>
              <td style="padding: 0.875rem; font-weight: 600;">Gasoil</td>
              <td style="padding: 0.875rem;">4.500 – 7.000 €</td>
              <td style="padding: 0.875rem;">—</td>
              <td style="padding: 0.875rem;">Independencia red gas</td>
              <td style="padding: 0.875rem;">Precio volátil, mantenimiento</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.875rem; color: var(--color-gris); margin-top: 1rem; font-style: italic;">
        * Precios orientativos IVA no incluido para viviendas de 80-100m² en Bilbao 2026. Fuente: iAlarife 2026, Txeberri.
      </p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: var(--font-inter); font-size: clamp(1.25rem, 4vw, 1.75rem); font-weight: 600; color: var(--color-grafito); margin-bottom: 1rem;">
        Guías de calefacción en Bilbao 2026
      </h2>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.7; margin-bottom: 1.5rem;">
        Estos 10 artículos cubren todos los aspectos de la calefacción en Bilbao:
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
        {items.map(child => (
          <a href={child.href} style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.5rem; box-shadow: var(--shadow-card); display: block;">
            <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem; align-items: center;">
              <span style="font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; color: var(--color-terracota); padding: 0.125rem 0; border-bottom: 1.5px solid var(--color-terracota);">{child.category}</span>
              <span style="font-size: 0.75rem; color: var(--color-gris);">{child.readTime}</span>
            </div>
            <h3 style="font-family: var(--font-inter); font-size: 1.125rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.5rem; line-height: 1.3;">{child.title}</h3>
            <p style="font-size: 0.875rem; color: var(--color-gris); line-height: 1.5;">{child.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: var(--font-inter); font-size: clamp(1.25rem, 4vw, 1.75rem); font-weight: 600; color: var(--color-grafito); margin-bottom: 1rem;">
        Calefacción por ciudad
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
        <a href="/blog/tipos-calefaccion-bilbao.html" style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.25rem; box-shadow: var(--shadow-card); display: block; text-align: center;">
          <h3 style="font-family: var(--font-inter); font-size: 1.125rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.25rem;">Bilbao</h3>
          <p style="font-size: 0.875rem; color: var(--color-gris);">9 artículos</p>
        </a>
        <a href="/blog/tipos-calefaccion-donostia.html" style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.25rem; box-shadow: var(--shadow-card); display: block; text-align: center;">
          <h3 style="font-family: var(--font-inter); font-size: 1.125rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.25rem;">Donostia</h3>
          <p style="font-size: 0.875rem; color: var(--color-gris);">1 artículo</p>
        </a>
        <a href="/blog/tipos-calefaccion-vitoria.html" style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.25rem; box-shadow: var(--shadow-card); display: block; text-align: center;">
          <h3 style="font-family: var(--font-inter); font-size: 1.125rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.25rem;">Vitoria</h3>
          <p style="font-size: 0.875rem; color: var(--color-gris);">1 artículo</p>
        </a>
      </div>
    </section>

    <section style="background: var(--color-crema); border-radius: var(--radius-card); padding: 2rem; margin-bottom: 3rem;">
      <h2 style="font-family: var(--font-inter); font-size: clamp(1.25rem, 4vw, 1.75rem); font-weight: 600; color: var(--color-grafito); margin-bottom: 1rem;">
        Subvenciones calefacción Bilbao 2026
      </h2>
      <p style="font-size: 1rem; color: var(--color-gris); margin-bottom: 1.25rem; line-height: 1.6;">
        Las ayudas para instalar calefacción eficiente en Bilbao en 2026 son las más generosas de la historia:
      </p>
      <ul style="list-style: none; padding: 0; margin: 0;">
        <li style="display: flex; gap: 0.75rem; margin-bottom: 0.875rem; align-items: flex-start;">
          <span style="color: var(--color-terracota); font-weight: 700; min-width: 120px;">Next Generation</span>
          <span style="color: var(--color-gris);">Hasta 40% de la inversión en aerotermia y suelo radiante</span>
        </li>
        <li style="display: flex; gap: 0.75rem; margin-bottom: 0.875rem; align-items: flex-start;">
          <span style="color: var(--color-terracota); font-weight: 700; min-width: 120px;">Gobierno Vasco</span>
          <span style="color: var(--color-gris);">Hasta 12.000€ por vivienda para aerotermia (programa PREE)</span>
        </li>
        <li style="display: flex; gap: 0.75rem; margin-bottom: 0.875rem; align-items: flex-start;">
          <span style="color: var(--color-terracota); font-weight: 700; min-width: 120px;">Ayto Bilbao</span>
          <span style="color: var(--color-gris);">Bonificación IBI hasta 50% durante 5 años para energías renovables</span>
        </li>
        <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <span style="color: var(--color-terracota); font-weight: 700; min-width: 120px;">ICIO</span>
          <span style="color: var(--color-gris);">Exención total del Impuesto de Construcciones para mejoras de eficiencia energética</span>
        </li>
      </ul>
      <div style="margin-top: 1.25rem;">
        <a href="/blog/subvenciones-calefaccion-bilbao.html" style="display: inline-block; color: var(--color-terracota); font-weight: 600; text-decoration: none; border-bottom: 1.5px solid var(--color-terracota);">Ver guía completa de subvenciones →</a>
      </div>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: var(--font-inter); font-size: clamp(1.25rem, 4vw, 1.75rem); font-weight: 600; color: var(--color-grafito); margin-bottom: 1rem;">
        Empresas especializadas en calefacción en Bilbao
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
        <a href="/empresas/eraber.html" style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.25rem; box-shadow: var(--shadow-card); display: block;">
          <h3 style="font-family: var(--font-inter); font-size: 1rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.25rem;">Eraber Reformas</h3>
          <p style="font-size: 0.8125rem; color: var(--color-gris);">Climatización y fontanería</p>
        </a>
        <a href="/empresas/reformas-fernandez.html" style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.25rem; box-shadow: var(--shadow-card); display: block;">
          <h3 style="font-family: var(--font-inter); font-size: 1rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.25rem;">Reformas Fernández</h3>
          <p style="font-size: 0.8125rem; color: var(--color-gris);">Calderas y calefacción</p>
        </a>
        <a href="/empresas/vascol-reformas.html" style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.25rem; box-shadow: var(--shadow-card); display: block;">
          <h3 style="font-family: var(--font-inter); font-size: 1rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.25rem;">Vascol Reformas</h3>
          <p style="font-size: 0.8125rem; color: var(--color-gris);">Aerotermia y suelo radiante</p>
        </a>
        <a href="/empresas/reformas-zunzunegui.html" style="text-decoration: none; background: white; border-radius: var(--radius-card); padding: 1.25rem; box-shadow: var(--shadow-card); display: block;">
          <h3 style="font-family: var(--font-inter); font-size: 1rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.25rem;">Reformas Zunzunegui</h3>
          <p style="font-size: 0.8125rem; color: var(--color-gris);">Fontanería y calefacción</p>
        </a>
      </div>
    </section>

    <section style="background: var(--color-terracota); color: white; padding: 2rem; border-radius: var(--radius-card); text-align: center; margin-bottom: 2rem;">
      <h2 style="font-family: var(--font-inter); font-size: clamp(1.25rem, 4vw, 1.75rem); font-weight: 700; margin-bottom: 1rem;">
        Calcula tu presupuesto de calefacción
      </h2>
      <p style="font-size: 1.0625rem; margin-bottom: 1.5rem; opacity: 0.95;">
        Obtén una estimación personalizada de tu reforma de calefacción en Bilbao. Sin registro.
      </p>
      <a href="/calculadora/index.html" style="display: inline-block; background: white; color: var(--color-terracota); padding: 0.875rem 2rem; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 1rem;">
        Ir a la calculadora →
      </a>
    </section>

  </main>
</HubLayout>
