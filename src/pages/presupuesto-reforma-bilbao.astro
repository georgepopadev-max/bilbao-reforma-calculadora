---
/**
 * Presupuesto Reforma Bilbao
 * A3 Zone
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Presupuesto Reforma Bilbao',
  description: 'Calcula el presupuesto orientativo de tu reforma en Bilbao 2026.',
  url: 'https://www.bilbaoreforma.es/presupuesto-reforma-bilbao.html',
  areaServed: { '@type': 'City', name: 'Bilbao' },
};
---

<BaseLayout
  title="Presupuesto Reforma Bilbao 2026"
  description="Calcula el presupuesto orientativo de tu reforma en Bilbao. Más de 50 empresas verificadas en Bizkaia."
  canonical="https://www.bilbaoreforma.es/presupuesto-reforma-bilbao.html"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <header class="site-header">
    <div class="header-container">
      <a href="/index.html" class="header-logo">
        <svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span class="header-logo-text">Bilbao Reforma</span>
      </a>
      <nav class="header-nav">
        <a href="/calculadora/index.html" class="header-nav-link">Calculadora</a>
        <a href="/blog/index.html" class="header-nav-link">Blog</a>
        <a href="/empresas/index.html" class="header-nav-link">Empresas</a>
        <a href="/contacto.html" class="header-nav-link header-nav-link-cta">Contacto</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section style="max-width:800px;margin:4rem auto;padding:0 1.5rem;text-align:center;">
      <h1 style="font-family:'Playfair Display',serif;font-size:2.5rem;margin-bottom:1rem;">Presupuesto Reforma Bilbao</h1>
      <p style="font-size:1.1rem;color:#555;margin-bottom:2rem;">Usa nuestra calculadora gratuita para obtener un presupuesto orientativo en menos de 2 minutos.</p>
      <a href="/calculadora/index.html" style="display:inline-flex;align-items:center;gap:0.5rem;padding:1rem 2rem;background:#C45C3E;color:white;border-radius:8px;font-weight:600;text-decoration:none;font-size:1.1rem;">
        Abrir calculadora →
      </a>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-bottom">
        <p class="footer-copyright">© 2025–2026 Bilbao Reforma.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
