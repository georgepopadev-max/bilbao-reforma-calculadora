---
/**
 * Reformas Bilbao — Bilbao Reforma hub
 * A3 Zone
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Reformas Bilbao',
  description: 'Guía completa de reformas en Bilbao 2026. Precios, empresas, tipos de reforma y consejos.',
  url: 'https://www.bilbaoreforma.es/reformas-bilbao.html',
  areaServed: { '@type': 'City', name: 'Bilbao' },
};
---

<BaseLayout
  title="Reformas Bilbao 2026 | Guía Completa de Precios y Empresas"
  description="Guía completa de reformas en Bilbao 2026. Calcula presupuestos, compara empresas y descubre precios por tipo de reforma."
  canonical="https://www.bilbaoreforma.es/reformas-bilbao.html"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <header class="site-header">
    <div class="header-container">
      <a href="/index.html" class="header-logo">
        <svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span class="header-logo-text">Bilbao Reforma</span>
      </a>
      <nav class="header-nav">
        <a href="/calculadora/index.html" class="header-nav-link">Calculadora</a>
        <a href="/blog/index.html" class="header-nav-link">Blog</a>
        <a href="/empresas/index.html" class="header-nav-link">Empresas</a>
        <a href="/contacto.html" class="header-nav-link header-nav-link-cta">Contacto</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section style="max-width:800px;margin:4rem auto;padding:0 1.5rem;">
      <h1 style="font-family:'Playfair Display',serif;font-size:2.5rem;margin-bottom:1rem;">Reformas en Bilbao 2026</h1>
      <p style="font-size:1.1rem;line-height:1.7;color:#555;margin-bottom:2rem;">Guía completa para reformas en Bilbao y Bizkaia. Encuentra presupuestos orientativos, empresas verificadas y consejos para tu reforma.</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:3rem;">
        <a href="/calculadora/integral-bilbao.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
          <h3 style="font-size:1.1rem;margin-bottom:0.5rem;">🏗️ Reforma Integral</h3>
          <p style="font-size:0.9rem;color:#666;">Desde 700 €/m²</p>
        </a>
        <a href="/calculadora/bano-bilbao.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
          <h3 style="font-size:1.1rem;margin-bottom:0.5rem;">🚿 Reforma de Baño</h3>
          <p style="font-size:0.9rem;color:#666;">Desde 2.500 €</p>
        </a>
        <a href="/calculadora/cocina-bilbao.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
          <h3 style="font-size:1.1rem;margin-bottom:0.5rem;">🍳 Reforma de Cocina</h3>
          <p style="font-size:0.9rem;color:#666;">Desde 5.000 €</p>
        </a>
      </div>

      <h2 style="font-family:'Playfair Display',serif;font-size:1.8rem;margin-bottom:1rem;">Precios por tipo de reforma en Bilbao</h2>
      <table style="width:100%;border-collapse:collapse;margin-bottom:2rem;">
        <thead><tr style="background:#f5f5f5;"><th style="padding:0.75rem;text-align:left;">Tipo</th><th style="padding:0.75rem;text-align:left;">Precio orientativo</th></tr></thead>
        <tbody>
          <tr><td style="padding:0.75rem;border-bottom:1px solid #eee;">Reforma integral</td><td style="padding:0.75rem;border-bottom:1px solid #eee;"><strong>700–1.400 €/m²</strong></td></tr>
          <tr><td style="padding:0.75rem;border-bottom:1px solid #eee;">Reforma de baño</td><td style="padding:0.75rem;border-bottom:1px solid #eee;"><strong>3.000–12.000 €</strong></td></tr>
          <tr><td style="padding:0.75rem;border-bottom:1px solid #eee;">Reforma de cocina</td><td style="padding:0.75rem;border-bottom:1px solid #eee;"><strong>5.000–16.000 €</strong></td></tr>
          <tr><td style="padding:0.75rem;border-bottom:1px solid #eee;">Pintura</td><td style="padding:0.75rem;border-bottom:1px solid #eee;"><strong>8–20 €/m²</strong></td></tr>
          <tr><td style="padding:0.75rem;">Cambio de suelo</td><td style="padding:0.75rem;"><strong>25–130 €/m²</strong></td></tr>
        </tbody>
      </table>

      <a href="/calculadora/index.html" class="cta-button cta-button-primary" style="display:inline-flex;align-items:center;gap:0.5rem;padding:1rem 2rem;background:#C45C3E;color:white;border-radius:8px;font-weight:600;text-decoration:none;">
        Calcular presupuesto gratis →
      </a>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-bottom">
        <p class="footer-copyright">© 2025–2026 Bilbao Reforma.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
