---
/**
 * empresas/index.astro — Empresas directory
 * A2 Zone
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const empresas = [
  { name: 'Reformas Fernández', slug: 'reformas-fernandez', location: 'Bilbao', phone: '+34 633 44 55 66', rating: '4.7', services: ['Albañilería', 'Pintura', 'Reformas de baños', 'Reformas de cocinas'], description: 'Más de 15 años de experiencia en albañilería y pintura en Bilbao. Reformas de baños y cocinas con presupuestos sin compromiso.', reviewCount: 41 },
  { name: 'Eraber', slug: 'eraber', location: 'Santutxu', phone: '+34 627 40 70 90', rating: '4.6', services: ['Albañilería', 'Pintura', 'Reformas integrales', 'Decoración'], description: 'Reformas integrales en Santutxu y Bilbao. Decoración e interiorismo con más de 10 años de trayectoria.', reviewCount: 29 },
  { name: 'Vascol Reformas', slug: 'vascol-reformas', location: 'Bilbao', phone: '+34 677 88 99 00', rating: '4.3', services: ['Reformas de locales', 'Reformas comerciales', 'Electricidad'], description: 'Especialistas en reformas de locales comerciales, hostelería y oficinas en Bilbao. Gestión de licencias de apertura.', reviewCount: 18 },
  { name: 'RB Interiores', slug: 'rb-interiores', location: 'Bilbao', phone: '+34 622 11 22 33', rating: '4.4', services: ['Reformas de interiores', 'Albañilería', 'Fontanería'], description: 'Reformas de interiores en Bilbao. Especialistas en reformas parciales y completas con presupuesto transparente.', reviewCount: 22 },
  { name: 'Raquel González Interiorismo', slug: 'raquel-gonzalez-interiorismo', location: 'Bilbao', phone: '+34 644 12 34 56', rating: '4.8', services: ['Interiorismo', 'Diseño de interiores', 'Decoración'], description: 'Estudio de interiorismo en Bilbao. Diseño personalizado y proyectos integrales de reformas con estética nórdica y sensibilidad local.', reviewCount: 15 },
  { name: 'Reformas Zunzunegui', slug: 'reformas-zunzunegui', location: 'Bilbao', phone: '+34 655 77 88 99', rating: '4.5', services: ['Reformas integrales', 'Albañilería', 'Reformas de locales'], description: 'Empresa familiar con más de 20 años de experiencia. Especialistas en reformas integrales y gestión de licencias.', reviewCount: 37 },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Empresas de reformas en Bilbao',
  description: 'Directorio de empresas de reformas verificadas en Bilbao y Bizkaia. Encuentra profesionales para tu reforma con reseñas y datos de contacto.',
  itemListElement: empresas.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.name,
    url: `https://www.bilbaoreforma.es/empresas/${e.slug}.html`,
    description: e.description,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: e.rating,
      reviewCount: String(e.reviewCount),
      bestRating: '5',
      worstRating: '1',
    },
  })),
};
---

<BaseLayout
  title="Empresas Reformas Bilbao 2026 | Verificadas"
  description="6 empresas de reformas verificadas en Bilbao y Bizkaia con reseñas, servicios y contacto. Directorio gratuito y actualizado para 2026."
  canonical="https://www.bilbaoreforma.es/empresas/index.html"
  ogImage="https://www.bilbaoreforma.es/images/og/empresas-og.jpg"
  ogImageAlt="Empresas de Reformas Bilbao"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Header city="bilbao" section="empresas" />
  <main id="main-content">
    <div style="max-width: 900px; margin: 0 auto; padding: 2rem 1rem;">

      {/* Header */}
      <header style="text-align: center; margin-bottom: 2rem;">
        <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(1.75rem, 5vw, 2.5rem); margin-bottom: 0.75rem; color: var(--color-grafito);">
          Empresas de Reformas en Bilbao
        </h1>
        <p style="color: var(--color-gris); font-size: 1.0625rem; max-width: 600px; margin: 0 auto 0.75rem; line-height: 1.65;">
          Hemos seleccionado y verificado {empresas.length} empresas de reformas en Bilbao y Bizkaia. Cada empresa aparece con reseñas reales, servicios y datos de contacto directo. Todas están dadas de alta y имеют experiencia comprobada en el sector.
        </p>
        <p style="color: var(--color-gris); font-size: 0.9375rem; max-width: 560px; margin: 0 auto; line-height: 1.6;">
          Encontrar un reformista de confianza en Bilbao no es fácil. Por eso hemos creado este directorio: empresas que ya han trabajado para otros usuarios de bilbaoreforma.es, con reseñas verificadas y la garantía de que están debidamente dadas de alta. Así puedes comparar y elegir con información real.
        </p>
      </header>

      {/* Why use this directory */}
      <section style="background: var(--color-crema); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; border: 1px solid var(--color-beige);">
        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 1rem;">¿Por qué usar nuestro directorio?</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="color: var(--color-verde-montana); font-size: 1.25rem; line-height: 1;">✓</span>
            <div>
              <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin-bottom: 0.25rem;">Reseñas verificadas</p>
              <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0;">Solo empresas con reseñas reales de clientes.</p>
            </div>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="color: var(--color-verde-montana); font-size: 1.25rem; line-height: 1;">✓</span>
            <div>
              <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin-bottom: 0.25rem;">Sin compromiso</p>
              <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0;">Contacta directamente con la empresa que elijas.</p>
            </div>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="color: var(--color-verde-montana); font-size: 1.25rem; line-height: 1;">✓</span>
            <div>
              <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin-bottom: 0.25rem;">Alta verificada</p>
              <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0;">Todas las empresas están dadas de alta fiscal.</p>
            </div>
          </div>
        </div>
      </section>

      {/* Companies grid */}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
        {empresas.map(e => (
          <a href={`${e.slug}.html`} style="display: block; padding: 1.5rem; background: var(--color-blanco); border-radius: 12px; text-decoration: none; color: inherit; border: 1px solid var(--color-beige); box-shadow: 0 2px 8px rgba(45,30,15,.06); transition: all 0.2s;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
              <h2 style="font-size: 1.05rem; font-weight: 600; color: var(--color-grafito); margin: 0; flex: 1; padding-right: 0.5rem;">{e.name}</h2>
              <span style="background: var(--color-crema); color: var(--color-terracota); padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap;">⭐ {e.rating}/5</span>
            </div>
            <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 0.5rem;">📍 {e.location}</p>
            <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 0.75rem; line-height: 1.5;">{e.description}</p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.75rem;">
              {e.services.slice(0, 3).map(s => (
                <span style="background: var(--color-crema); color: var(--color-grafito); padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.6875rem;">{s}</span>
              ))}
              {e.services.length > 3 && (
                <span style="background: var(--color-crema); color: var(--color-gris); padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.6875rem;">+{e.services.length - 3}</span>
              )}
            </div>
            <p style="font-size: 0.8125rem; color: var(--color-terracota); font-weight: 600; margin: 0;">Ver ficha →</p>
          </a>
        ))}
      </div>

      {/* CTA */}
      <div style="text-align: center; margin-top: 3rem; padding: 2rem; background: var(--color-terracota); border-radius: 12px; color: var(--color-blanco);">
        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Necesitas un presupuesto rápido?</h2>
        <p style="opacity: 0.9; margin-bottom: 1.25rem; font-size: 0.9375rem;">Usa nuestra calculadora de presupuestos para obtener un orientativo en menos de 2 minutos.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none;">Calcular presupuesto</a>
      </div>

    </div>
  </main>
  <Footer city="bilbao" />
</BaseLayout>
