const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Empresas de reformas en Bilbao',
  description: `Directorio de ${empresas.length} empresas de reformas verificadas en Bilbao y Bizkaia. Encuentra profesionales para tu reforma con reseñas y datos de contacto directo.`,
  numberOfItems: empresas.length,
  itemListElement: empresas.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.name,
    url: `https://www.bilbaoreforma.es/empresas/${e.slug}.html`,
    description: e.description,
  })),
};

function renderCard(e: typeof empresas[0]): string {
  const hasFicha = empresasConFicha.has(e.slug);
  const telLink = `tel:${e.phone.replace(/\s/g, '')}`;

  if (hasFicha) {
    return `<a href="${e.slug}.html" class="company-card" data-specializations="${e.specializations.join(',')}" style="display: block; padding: 1.5rem; background: var(--color-blanco); border-radius: 12px; text-decoration: none; color: inherit; border: 1px solid var(--color-beige); box-shadow: 0 2px 8px rgba(45,30,15,.06); transition: all 0.2s;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
        <h2 style="font-size: 1.05rem; font-weight: 600; color: var(--color-grafito); margin: 0; flex: 1; padding-right: 0.5rem; line-height: 1.3;">${e.name}</h2>
        <span style="background: var(--color-crema); color: var(--color-terracota); padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; flex-shrink: 0;">⭐ ${e.rating}/5</span>
      </div>
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 0.5rem;">📍 ${e.location}</p>
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 0.75rem; line-height: 1.5;">${e.description}</p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.75rem;">
        ${e.services.slice(0, 3).map(s => `<span style="background: var(--color-crema); color: var(--color-grafito); padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.6875rem;">${s}</span>`).join('')}
        ${e.services.length > 3 ? `<span style="background: var(--color-crema); color: var(--color-gris); padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.6875rem;">+${e.services.length - 3}</span>` : ''}
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <p style="font-size: 0.8125rem; color: var(--color-terracota); font-weight: 600; margin: 0;">Ver ficha →</p>
        <p style="font-size: 0.75rem; color: var(--color-gris); margin: 0;">${e.reviewCount} reseñas</p>
      </div>
    </a>`;
  } else {
    return `<div class="company-card" data-specializations="${e.specializations.join(',')}" style="display: block; padding: 1.5rem; background: var(--color-blanco); border-radius: 12px; border: 1px solid var(--color-beige); box-shadow: 0 2px 8px rgba(45,30,15,.06); transition: all 0.2s;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
        <h2 style="font-size: 1.05rem; font-weight: 600; color: var(--color-grafito); margin: 0; flex: 1; padding-right: 0.5rem; line-height: 1.3;">${e.name}</h2>
        <span style="background: var(--color-crema); color: var(--color-terracota); padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; flex-shrink: 0;">⭐ ${e.rating}/5</span>
      </div>
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 0.5rem;">📍 ${e.location}</p>
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 0.75rem; line-height: 1.5;">${e.description}</p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.75rem;">
        ${e.services.slice(0, 3).map(s => `<span style="background: var(--color-crema); color: var(--color-grafito); padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.6875rem;">${s}</span>`).join('')}
        ${e.services.length > 3 ? `<span style="background: var(--color-crema); color: var(--color-gris); padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.6875rem;">+${e.services.length - 3}</span>` : ''}
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <a href="${telLink}" style="font-size: 0.8125rem; color: var(--color-terracota); font-weight: 600; margin: 0; text-decoration: none;">📞 Llamar</a>
        <p style="font-size: 0.75rem; color: var(--color-gris); margin: 0;">${e.reviewCount} reseñas</p>
      </div>
    </div>`;
  }
}
---

<BaseLayout
  title={`${empresas.length} Empresas Reformas Bilbao 2026 | Verificadas`}
  description={`${empresas.length} empresas de reformas verificadas en Bilbao y Bizkaia. Filtra por especialidad: integrales, baños, cocinas, electricidad, fontanería, pintura y más.`}
  canonical="https://www.bilbaoreforma.es/empresas/index.html"
  ogImage="https://www.bilbaoreforma.es/images/og/empresas-og.jpg"
  ogImageAlt="Empresas de Reformas Bilbao"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Header city="bilbao" section="empresas" />
  <main id="main-content">
    <div style="max-width: 1100px; margin: 0 auto; padding: 2rem 1rem;">

      <header style="text-align: center; margin-bottom: 2rem;">
        <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(1.75rem, 5vw, 2.5rem); margin-bottom: 0.75rem; color: var(--color-grafito);">
          Empresas de Reformas en Bilbao
        </h1>
        <p style="color: var(--color-gris); font-size: 1.0625rem; max-width: 600px; margin: 0 auto 0.75rem; line-height: 1.65;">
          Hemos seleccionado y verificado <strong>{empresas.length} empresas</strong> de reformas en Bilbao y Bizkaia. Cada empresa tiene reseñas reales, servicios y datos de contacto directo.
        </p>
        <p style="color: var(--color-gris); font-size: 0.9375rem; max-width: 560px; margin: 0 auto; line-height: 1.6;">
          Encontrar un reformista de confianza en Bilbao no es fácil. Por eso hemos creado este directorio: empresas que ya han trabajado para otros usuarios de bilbaoreforma.es, con reseñas verificadas y la garantía de que están debidamente dadas de alta.
        </p>
      </header>

      {/* Why use this directory */}
      <section style="background: var(--color-crema); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; border: 1px solid var(--color-beige);">
        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 1rem;">¿Por qué usar nuestro directorio?</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="color: var(--color-verde-montana); font-size: 1.25rem; line-height: 1;">✓</span>
            <div>
              <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin-bottom: 0.25rem;">Reseñas verificadas</p>
              <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0;">Solo empresas con reseñas de clientes reales.</p>
            </div>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="color: var(--color-verde-montana); font-size: 1.25rem; line-height: 1;">✓</span>
            <div>
              <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin-bottom: 0.25rem;">Sin compromiso</p>
              <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0;">Contacta directamente con la empresa que elijas.</p>
            </div>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="color: var(--color-verde-montana); font-size: 1.25rem; line-height: 1;">✓</span>
            <div>
              <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin-bottom: 0.25rem;">Alta verificada</p>
              <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0;">Todas las empresas están dadas de alta fiscal.</p>
            </div>
          </div>
        </div>
      </section>

      {/* Filter tabs */}
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;" id="filterTabs">
        <button class="filter-tab active" data-filter="all">Todas</button>
        <button class="filter-tab" data-filter="integral">Integrales</button>
        <button class="filter-tab" data-filter="bano">Baños</button>
        <button class="filter-tab" data-filter="cocina">Cocinas</button>
        <button class="filter-tab" data-filter="electricidad">Electricidad</button>
        <button class="filter-tab" data-filter="fontaneria">Fontanería</button>
        <button class="filter-tab" data-filter="pintura">Pintura</button>
        <button class="filter-tab" data-filter="suelo">Suelos</button>
        <button class="filter-tab" data-filter="local">Locales</button>
      </div>

      {/* Companies grid */}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;" id="companiesGrid">
        {empresas.map(e => (
          <Fragment set:html={renderCard(e)} />
        ))}
      </div>

      {/* CTA */}
      <div style="text-align: center; margin-top: 3rem; padding: 2rem; background: var(--color-terracota); border-radius: 12px; color: var(--color-blanco);">
        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿No sabes qué tipo de reforma necesitas?</h2>
        <p style="opacity: 0.9; margin-bottom: 1.25rem; font-size: 0.9375rem;">Usa nuestra calculadora de presupuestos para obtener un orientativo en menos de 2 minutos.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none;">Calcular presupuesto →</a>
      </div>

    </div>
  </main>
  <Footer city="bilbao" />
</BaseLayout>

<style>
  .filter-tab {
    padding: 0.4rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--color-beige);
    background: var(--color-blanco);
    color: var(--color-grafito);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    font-family: var(--font-inter);
  }
  .filter-tab:hover { border-color: var(--color-terracota); color: var(--color-terracota); }
  .filter-tab.active {
    background: var(--color-terracota);
    color: white;
    border-color: var(--color-terracota);
  }
  .company-card:hover {
    border-color: var(--color-terracota);
    box-shadow: 0 4px 16px rgba(196,92,62,.12);
    transform: translateY(-2px);
  }
</style>

<script>
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.company-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = (tab as HTMLElement).dataset.filter;
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      cards.forEach(card => {
        const el = card as HTMLElement;
        const specs = el.dataset.specializations || '';
        el.style.display = (filter === 'all' || specs.includes(filter || '')) ? 'block' : 'none';
      });
    });
  });
</script>
