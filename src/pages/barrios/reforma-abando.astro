---
import BaseLayout from '../../layouts/BaseLayout.astro';
const barrio = { name: 'Abando', slug: 'abando', multiplicador: 1.20, agePreset: 'old', description: 'Abando es el barrio financiero y comercial de Bilbao, con edificios de los años 1940 a 1980, muchos de ellos protegidos. Edificios céntricos con buena comunicación pero complicada licencia de obra. El multiplicador del 20% refleja la complejidad de trabajar en un barrio prime con normativas de Protección del Patrimonio Histórico.' };
const schema = { '@context': 'https://schema.org', '@type': 'Place', name: 'Abando Bilbao', geo: { '@type': 'GeoCoordinates', latitude: 43.2630, longitude: -2.9350 }, description: barrio.description };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' }, { '@type': 'ListItem', position: 2, name: 'Barrios', item: 'https://www.bilbaoreforma.es/barrios/' }, { '@type': 'ListItem', position: 3, name: 'Abando', item: 'https://www.bilbaoreforma.es/barrios/reforma-abando.html' }] };
---
<BaseLayout title={`Reformas Abando Bilbao 2026 | Calculadora`} description={`Calcula tu reforma en Abando Bilbao 2026. Multiplicador ×1.20 (edificios protegidos). Empresas del barrio. Gratis.`} canonical={`https://www.bilbaoreforma.es/barrios/reforma-abando.html`} ogImage="https://www.bilbaoreforma.es/images/og/bilbao-og.jpg" ogImageAlt="Reformas Abando Bilbao">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} /></Fragment>
  <header class="site-header"><div class="header-container"><a href="/index.html" class="header-logo"><svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg><span class="header-logo-text">Bilbao Reforma</span></a><nav class="header-nav"><a href="/calculadora/index.html" class="header-nav-link">Calculadora</a><a href="/blog/index.html" class="header-nav-link">Blog</a><a href="/empresas/index.html" class="header-nav-link">Empresas</a><a href="/contacto.html" class="header-nav-link header-nav-link-cta">Contacto</a></nav></div></header>
  <main id="main-content">
    <section style="max-width:700px;margin:4rem auto;padding:0 1.5rem;">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol style="display:flex;gap:0.5rem;list-style:none;padding:0;margin:0 0 2rem;font-size:0.9rem;color:#888;"><li><a href="/index.html">Bilbao Reforma</a></li><li>›</li><li><a href="/barrios/">Barrios</a></li><li>›</li><li aria-current="page">Abando</li></ol></nav>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.75rem,5vw,2.5rem);margin-bottom:1rem;">Reformas en Abando, Bilbao</h1>
      <div style="background:#7D8B6A;color:white;display:inline-block;padding:0.5rem 1rem;border-radius:20px;font-size:1.1rem;margin-bottom:1.5rem;font-weight:600;">×1.20 sobre precio base</div>
      <p style="font-size:1.1rem;line-height:1.8;color:#333;margin-bottom:1.5rem;">{barrio.description}</p>
      <div style="background:#f9f9f9;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;">
        <h2 style="font-size:1.2rem;margin-bottom:0.75rem;">Datos clave de Abando</h2>
        <ul style="color:#555;line-height:1.8;list-style:none;padding:0;margin:0">
          <li><strong>Precio medio vivienda:</strong> 4.815 €/m² (Idealista ene 2026)</li>
          <li><strong>Antigüedad típica edificios:</strong> 1940–1980</li>
          <li><strong>Tipo reforma más demandada:</strong> Reforma integral + fachadas</li>
          <li><strong>Multiplicador:</strong> ×1.20</li>
        </ul>
      </div>
      <div style="background:#f9f9f9;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;">
        <h2 style="font-size:1.2rem;margin-bottom:0.75rem;">Empresas que trabajan en Abando</h2>
        <p style="color:#666;margin-bottom:1rem;">Empresas verificadas con experiencia en reformas en el barrio de Abando y edificios protegidos:</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem">
          <li><a href="/empresas/reformas-fernandez.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Reformas Fernández →</a> — Especialistas en reformas integrales en zona centro</li>
          <li><a href="/empresas/eraber.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Eraber Reformas →</a> — Reformas con experiencia en edificios céntricos</li>
          <li><a href="/empresas/raquel-gonzalez-interiorismo.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Raquel González Interiorismo →</a> — Diseño y reforma integral premium</li>
        </ul>
      </div>
      <a href="/calculadora/index.html?barrio=abando" style="display:inline-block;padding:0.75rem 1.5rem;background:#C45C3E;color:white;border-radius:8px;font-weight:600;text-decoration:none;">Calcular en Abando →</a>
    </section>
  </main>
  <footer class="site-footer"><div class="footer-container"><div class="footer-bottom"><p class="footer-copyright">© 2025–2026 Bilbao Reforma.</p></div></div></footer>
</BaseLayout>