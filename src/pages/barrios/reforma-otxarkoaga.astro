---
import BaseLayout from '../../layouts/BaseLayout.astro';
const barrio = { name: 'Otxarkoaga', slug: 'otxarkoaga', multiplicador: 0.85, agePreset: 'old', description: 'Otxarkoaga es un barrio de promoción pública en la zona norte de Bilbao, con edificios de los años 1960 a 1980 de vivienda social. Los precios de reforma más bajos de Bilbao, con un multiplicador del 0.85 que permite ahorros significativos. Ideal para propietarios con presupuestos limitados que necesitan renovar baños, cocinas o pintura sin grandes obras.' };
const schema = { '@context': 'https://schema.org', '@type': 'Place', name: 'Otxarkoaga Bilbao', geo: { '@type': 'GeoCoordinates', latitude: 43.2480, longitude: -2.9100 }, description: barrio.description };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' }, { '@type': 'ListItem', position: 2, name: 'Barrios', item: 'https://www.bilbaoreforma.es/barrios/' }, { '@type': 'ListItem', position: 3, name: 'Otxarkoaga', item: 'https://www.bilbaoreforma.es/barrios/reforma-otxarkoaga.html' }] };
---
<BaseLayout title={`Reformas Otxarkoaga Bilbao 2026`} description={`Calcula tu reforma en Otxarkoaga Bilbao. Multiplicador ×0.85. Barrio más económico para reformas. Empresas del barrio.`} canonical={`https://www.bilbaoreforma.es/barrios/reforma-otxarkoaga.html`} ogImage="https://www.bilbaoreforma.es/images/og/bilbao-og.jpg" ogImageAlt="Reformas Otxarkoaga Bilbao">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} /></Fragment>
  <header class="site-header"><div class="header-container"><a href="/index.html" class="header-logo"><svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg><span class="header-logo-text">Bilbao Reforma</span></a><nav class="header-nav"><a href="/calculadora/index.html" class="header-nav-link">Calculadora</a><a href="/blog/index.html" class="header-nav-link">Blog</a><a href="/empresas/index.html" class="header-nav-link">Empresas</a><a href="/contacto.html" class="header-nav-link header-nav-link-cta">Contacto</a></nav></div></header>
  <main id="main-content">
    <section style="max-width:700px;margin:4rem auto;padding:0 1.5rem;">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol style="display:flex;gap:0.5rem;list-style:none;padding:0;margin:0 0 2rem;font-size:0.9rem;color:#888;"><li><a href="/index.html">Bilbao Reforma</a></li><li>›</li><li><a href="/barrios/">Barrios</a></li><li>›</li><li aria-current="page">Otxarkoaga</li></ol></nav>
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.75rem,5vw,2.5rem);margin-bottom:1rem;">Reformas en Otxarkoaga, Bilbao</h1>
      <div style="background:#7D8B6A;color:white;display:inline-block;padding:0.5rem 1rem;border-radius:20px;font-size:1.1rem;margin-bottom:1.5rem;font-weight:600;">×0.85 sobre precio base</div>
      <p style="font-size:1.1rem;line-height:1.8;color:#333;margin-bottom:1.5rem;">{barrio.description}</p>
      <div style="background:#f9f9f9;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;">
        <h2 style="font-size:1.2rem;margin-bottom:0.75rem;">Datos clave de Otxarkoaga</h2>
        <ul style="color:#555;line-height:1.8;list-style:none;padding:0;margin:0">
          <li><strong>Precio medio vivienda:</strong> 2.000 €/m² (datos del mercado)</li>
          <li><strong>Antigüedad típica edificios:</strong> 1960–1980 (vivienda social)</li>
          <li><strong>Tipo reforma más demandada:</strong> Reforma funcional</li>
          <li><strong>Multiplicador:</strong> ×0.85</li>
        </ul>
      </div>
      <div style="background:#f9f9f9;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;">
        <h2 style="font-size:1.2rem;margin-bottom:0.75rem;">Empresas que trabajan en Otxarkoaga</h2>
        <p style="color:#666;margin-bottom:1rem;">Empresas con experiencia en reformas en el barrio de Otxarkoaga:</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem">
          <li><a href="/empresas/vascol-reformas.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Vascol Reformas →</a> — Reformas funcionales a buen precio</li>
          <li><a href="/empresas/reformas-zunzunegui.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Reformas Zunzunegui →</a> — Fontanería y reformas</li>
          <li><a href="/empresas/rb-interiores.html" style="color:#C45C3E;font-weight:600;text-decoration:none">RB Interiores →</a> — Interiorismo y reformas</li>
        </ul>
      </div>
      <a href="/calculadora/index.html?barrio=otxarkoaga" style="display:inline-block;padding:0.75rem 1.5rem;background:#C45C3E;color:white;border-radius:8px;font-weight:600;text-decoration:none;">Calcular en Otxarkoaga →</a>
    </section>
  </main>
  <footer class="site-footer"><div class="footer-container"><div class="footer-bottom"><p class="footer-copyright">© 2025–2026 Bilbao Reforma.</p></div></div></footer>

      <div style="background:#f9f9f9;padding:1.5rem;border-radius:12px;margin:1.5rem 0;">
        <h2 style="font-size:1.2rem;margin-bottom:0.75rem;">Ver También</h2>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem">

          <li><a href="/calculadora/index.html?barrio=otxarkoaga" style="color:#C45C3E;font-weight:600;text-decoration:none">Calcular reforma en Otxarkoaga →</a></li>
          <li><a href="/barrios/" style="color:#C45C3E;font-weight:600;text-decoration:none">Ver todos los barrios de Bilbao →</a></li>
        </ul>
        <h3 style="font-size:1rem;margin:1rem 0 0.5rem 0;">Otros barrios cercanos</h3>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.4rem">
          <li><a href="/barrios/reforma-begona.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Reformas en Begoña Bilbao →</a></li>
          <li><a href="/barrios/reforma-rekalde.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Reformas en Rekalde Bilbao →</a></li>
          <li><a href="/barrios/reforma-basurto.html" style="color:#C45C3E;font-weight:600;text-decoration:none">Reformas en Basurto Bilbao →</a></li>
        </ul>
      </div>
  </BaseLayout>