---
/**
 * Calculadora Index — Bilbao Reforma
 * A3 Zone
 */
import CalculadoraLayout from '../../layouts/CalculadoraLayout.astro';
---

<CalculadoraLayout
  title="Calculadora Reformas Bilbao 2026"
  description="Calcula el presupuesto orientativo de tu reforma en Bilbao 2026. Gratis, sin registro, en menos de 2 minutos."
  canonical="https://www.bilbaoreforma.es/calculadora/index.html"
  city="bilbao"
  calculatorType="integral"
>
  <!-- Wizard Steps (inline for now — will be hydrated by calculator TS) -->
  <div class="calculator-intro-editorial" style="max-width:760px;margin:2rem auto;padding:0 1.5rem;text-align:center;">
    <h2>Calculadora de Reformas en Bilbao 2026</h2>
    <p>Obtén un <strong>presupuesto orientativo para tu reforma en Bilbao</strong> en menos de 2 minutos. Datos basados en precios reales de empresas de reformas en Bizkaia, actualizados 2026.</p>
  </div>

  <!-- CTA cards -->
  <div style="max-width:800px;margin:0 auto 2rem;padding:0 1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;">
    <a href="/calculadora/bano-bilbao.html" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#7D8B6A;color:white;padding:1rem 1.5rem;border-radius:var(--radius-card,8px);text-decoration:none;font-weight:500;">
      <span>🚿 Baño</span>
      <span>desde 2.500 € →</span>
    </a>
    <a href="/calculadora/cocina-bilbao.html" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#C45C3E;color:white;padding:1rem 1.5rem;border-radius:var(--radius-card,8px);text-decoration:none;font-weight:500;">
      <span>🍳 Cocina</span>
      <span>desde 5.000 € →</span>
    </a>
    <a href="/calculadora/pintura-bilbao.html" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:#C4B8A8;color:white;padding:1rem 1.5rem;border-radius:var(--radius-card,8px);text-decoration:none;font-weight:500;">
      <span>🎨 Pintura</span>
      <span>desde 8 €/m² →</span>
    </a>
  </div>

  <!-- Hidden inputs for result -->
  <input type="hidden" id="totalPrice" name="totalPrice" value="" />
  <input type="hidden" id="priceRange" name="priceRange" value="" />

  <!-- Wizard Container -->
  <div class="calculator-wrapper" style="max-width:700px;margin:0 auto;padding:0 1rem 4rem;">
    <!-- Progress Bar -->
    <div class="progress-container" id="progressContainer">
      <div class="progress-steps">
        <div class="progress-step active" data-step="1">
          <span class="progress-step-number">1</span>
          <span class="progress-step-label">Tipo</span>
        </div>
        <div class="progress-step" data-step="2">
          <span class="progress-step-number">2</span>
          <span class="progress-step-label">Metros</span>
        </div>
        <div class="progress-step" data-step="3">
          <span class="progress-step-number">3</span>
          <span class="progress-step-label">Edificio</span>
        </div>
        <div class="progress-step" data-step="4">
          <span class="progress-step-number">4</span>
          <span class="progress-step-label">Calidad</span>
        </div>
        <div class="progress-step" data-step="5">
          <span class="progress-step-number">5</span>
          <span class="progress-step-label">Extras</span>
        </div>
        <div class="progress-step" data-step="6">
          <span class="progress-step-number">6</span>
          <span class="progress-step-label">Resultado</span>
        </div>
      </div>
      <div class="progress-bar-track">
        <div class="progress-bar-fill" id="progressBarFill" style="width: 16.6%"></div>
      </div>
    </div>

    <!-- Wizard steps -->
    <div class="wizard-container" id="wizardContainer">

      <!-- STEP 1: Reform Type -->
      <div class="wizard-step active" id="step1" data-step="1">
        <div class="step-header">
          <h1 class="step-title">¿Qué tipo de reforma necesitas?</h1>
          <p class="step-subtitle">Selecciona una opción o combina varias estancias</p>
        </div>

        <!-- Scope Cards -->
        <div class="scope-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.75rem;margin-bottom:1.5rem;">
          <div class="age-option" data-scope="basic" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">🏠 Reforma básica</div>
              <div class="age-option-desc">550–700 €/m²</div>
            </div>
          </div>
          <div class="age-option" data-scope="medium" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">🏡 Reforma media</div>
              <div class="age-option-desc">700–950 €/m²</div>
            </div>
          </div>
          <div class="age-option" data-scope="integral" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">🏗️ Reforma integral</div>
              <div class="age-option-desc">900–1.300 €/m²</div>
            </div>
          </div>
          <div class="age-option" data-scope="luxury" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">✨ Reforma premium</div>
              <div class="age-option-desc">1.300–1.600 €/m²</div>
            </div>
          </div>
        </div>

        <p style="text-align:center;color:#888;font-size:0.9rem;margin-bottom:1.5rem;">— o selecciona estancias individuales —</p>

        <!-- Individual Room Cards -->
        <div class="type-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:0.75rem;">
          <div class="type-card card" data-reform="painting" role="button" tabindex="0" aria-pressed="false">
            <div class="card-icon">🎨</div>
            <div class="card-title">Pintura</div>
            <div class="card-desc">8–20 €/m²</div>
          </div>
          <div class="type-card card" data-reform="flooring" role="button" tabindex="0" aria-pressed="false">
            <div class="card-icon">🪵</div>
            <div class="card-title">Suelo</div>
            <div class="card-desc">25–130 €/m²</div>
          </div>
          <div class="type-card card" data-reform="bathroom" role="button" tabindex="0" aria-pressed="false">
            <div class="card-icon">🚿</div>
            <div class="card-title">Baño</div>
            <div class="card-desc">desde 2.500 €</div>
          </div>
          <div class="type-card card" data-reform="kitchen" role="button" tabindex="0" aria-pressed="false">
            <div class="card-icon">🍳</div>
            <div class="card-title">Cocina</div>
            <div class="card-desc">desde 5.000 €</div>
          </div>
        </div>

        <nav class="wizard-nav">
          <button class="wizard-nav-btn wizard-nav-btn-next" id="btn-next" type="button">
            Siguiente →
          </button>
        </nav>
      </div>

      <!-- STEP 2: Surface Area -->
      <div class="wizard-step" id="step2" data-step="2">
        <div class="step-header">
          <h1 class="step-title">¿Cuántos metros cuadrados tiene la vivienda?</h1>
          <p class="step-subtitle">Indica la superficie total a reformar</p>
        </div>
        <div class="meters-input-group">
          <div class="meters-value-display">
            <span class="meters-value-number" id="metersDisplayValue">80</span>
            <span class="meters-value-unit">m²</span>
          </div>
          <input type="number" id="metersInput" class="meters-input" value="80" min="20" max="500" aria-label="Metros cuadrados" />
          <input type="range" id="metersSlider" class="meters-slider" min="20" max="500" value="80" aria-label="Slider de metros cuadrados" />
          <div class="meters-presets">
            <button class="meters-preset-btn" data-meters="45" type="button">Estudio (~45m²)</button>
            <button class="meters-preset-btn" data-meters="70" type="button">Piso 2 hab (~70m²)</button>
            <button class="meters-preset-btn" data-meters="90" type="button">Piso 3 hab (~90m²)</button>
            <button class="meters-preset-btn" data-meters="110" type="button">Piso 4 hab (~110m²)</button>
          </div>
        </div>
        <nav class="wizard-nav">
          <button class="wizard-nav-btn wizard-nav-btn-back" id="btn-prev" type="button">← Atrás</button>
          <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Siguiente →</button>
        </nav>
      </div>

      <!-- STEP 3: Building Age -->
      <div class="wizard-step" id="step3" data-step="3">
        <div class="step-header">
          <h1 class="step-title">¿Qué antigüedad tiene el edificio?</h1>
          <p class="step-subtitle">Los edificios antiguos pueden necesitar renovación de instalaciones</p>
        </div>
        <div class="age-options" id="ageOptions">
          <div class="age-option selected" data-age="new" role="button" tabindex="0" aria-pressed="true">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">Menos de 20 años</div>
              <div class="age-option-desc">Instalaciones modernas</div>
            </div>
            <span class="age-option-badge">×1.00</span>
          </div>
          <div class="age-option" data-age="moderate" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">20–40 años</div>
              <div class="age-option-desc">Posible renovación parcial</div>
            </div>
            <span class="age-option-badge">×1.05</span>
          </div>
          <div class="age-option" data-age="old" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">40–70 años</div>
              <div class="age-option-desc">Tuberías y electricidad pueden necesitarse</div>
            </div>
            <span class="age-option-badge">×1.15</span>
          </div>
          <div class="age-option" data-age="historic" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">Más de 70 años / Casco Viejo</div>
              <div class="age-option-desc">Acceso difícil, materiales especiales</div>
            </div>
            <span class="age-option-badge">×1.30</span>
          </div>
        </div>
        <nav class="wizard-nav">
          <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
          <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Siguiente →</button>
        </nav>
      </div>

      <!-- STEP 4: Quality -->
      <div class="wizard-step" id="step4" data-step="4">
        <div class="step-header">
          <h1 class="step-title">¿Qué nivel de calidad quieres?</h1>
          <p class="step-subtitle">La calidad de los materiales determina el precio final</p>
        </div>
        <div class="age-options" id="qualityOptions">
          <div class="age-option" data-quality="basic" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">Básica</div>
              <div class="age-option-desc">Leroy Merlin, marca blanca</div>
            </div>
            <span class="age-option-badge">×0.80</span>
          </div>
          <div class="age-option selected" data-quality="medium" role="button" tabindex="0" aria-pressed="true">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">Media</div>
              <div class="age-option-desc">Cosentino, Porcelanosa media, Roca</div>
            </div>
            <span class="age-option-badge">×1.00</span>
          </div>
          <div class="age-option" data-quality="premium" role="button" tabindex="0" aria-pressed="false">
            <div class="age-option-radio"></div>
            <div class="age-option-content">
              <div class="age-option-title">Premium</div>
              <div class="age-option-desc">Dekton, Villeroy & Boch, Hansgrohe</div>
            </div>
            <span class="age-option-badge">×1.40</span>
          </div>
        </div>
        <nav class="wizard-nav">
          <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
          <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Siguiente →</button>
        </nav>
      </div>

      <!-- STEP 5: Extras -->
      <div class="wizard-step" id="step5" data-step="5">
        <div class="step-header">
          <h1 class="step-title">¿Algún extra?</h1>
          <p class="step-subtitle">Selecciona elementos adicionales (opcional)</p>
        </div>
        <div class="extras-grid" id="extrasGrid">
          <div class="extra-checkbox-item" data-extra="windows" role="button" tabindex="0" aria-pressed="false">
            <div class="extra-checkbox">
              <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="extra-content">
              <div class="extra-title">Ventanas PVC</div>
              <div class="extra-desc">4 unidades de media</div>
            </div>
            <div class="extra-bottom-row">
              <span class="extra-price">350–700 €/ud</span>
            </div>
          </div>
          <div class="extra-checkbox-item" data-extra="terrace" role="button" tabindex="0" aria-pressed="false">
            <div class="extra-checkbox">
              <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="extra-content">
              <div class="extra-title">Terraza/Balcón</div>
              <div class="extra-desc">Opcional</div>
            </div>
            <div class="extra-bottom-row">
              <span class="extra-price">250–550 €/m²</span>
            </div>
          </div>
          <div class="extra-checkbox-item" data-extra="radiantFloor" role="button" tabindex="0" aria-pressed="false">
            <div class="extra-checkbox">
              <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="extra-content">
              <div class="extra-title">Suelo radiante</div>
              <div class="extra-desc">Opcional</div>
            </div>
            <div class="extra-bottom-row">
              <span class="extra-price">70–140 €/m²</span>
            </div>
          </div>
          <div class="extra-checkbox-item" data-extra="domotics" role="button" tabindex="0" aria-pressed="false">
            <div class="extra-checkbox">
              <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="extra-content">
              <div class="extra-title">Domótica</div>
              <div class="extra-desc">Opcional</div>
            </div>
            <div class="extra-bottom-row">
              <span class="extra-price">1.000–3.000 €</span>
            </div>
          </div>
          <div class="extra-checkbox-item" data-extra="aerothermia" role="button" tabindex="0" aria-pressed="false">
            <div class="extra-checkbox">
              <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="extra-content">
              <div class="extra-title">Aerotermia</div>
              <div class="extra-desc">Opcional</div>
            </div>
            <div class="extra-bottom-row">
              <span class="extra-price">4.500–10.000 €</span>
            </div>
          </div>
        </div>
        <nav class="wizard-nav">
          <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
          <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Calcular Presupuesto →</button>
        </nav>
      </div>

      <!-- STEP 6: Result -->
      <div class="wizard-step" id="step6" data-step="6">
        <div class="result-container">
          <div class="result-header">
            <span class="result-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Presupuesto estimado
            </span>
            <h1 class="result-title">Tu reforma cuesta entre</h1>
            <div class="result-range">
              <span class="result-range-low" id="resultRangeLow">—</span>
              <span class="result-range-separator">—</span>
              <span class="result-range-high" id="resultRangeHigh">—</span>
            </div>
          </div>

          <div class="result-breakdown">
            <h2 class="result-breakdown-title">Desglose orientativo</h2>
            <div id="resultBreakdownBars"></div>
          </div>

          <div class="result-comparison">
            <div class="result-comparison-title">Precio medio en Bilbao</div>
            <div class="result-comparison-value" id="resultComparisonValue">— €/m²</div>
            <div class="result-comparison-label" id="resultComparisonLabel">para reforma media</div>
          </div>

          <div class="result-ctas">
            <button class="cta-button cta-button-primary" type="button" id="downloadPdfBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
              Descargar PDF
            </button>
            <button class="cta-button cta-button-secondary" type="button" id="requestQuotesBtn">
              Solicitar 3 presupuestos
            </button>
          </div>

          <div class="result-disclaimer">
            ⚠️ Este presupuesto es orientativo y puede variar ±15% según las características específicas de tu reforma. Solicita presupuestos personalizados a empresas locales.
            <br><br>
            Precios sin IVA (10% IVA reducido para reformas de vivienda).
          </div>

          <nav class="wizard-nav">
            <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Modificar</button>
            <button class="wizard-nav-btn wizard-nav-btn-next" type="button" onclick="window.BilbaoCalc?.restart()">Nuevo cálculo →</button>
          </nav>
        </div>
      </div>

    </div>
  </div>
</CalculadoraLayout>

<style is:global>
  /* Minimal wizard styles (until A1 provides full styles.css) */
  .wizard-step { display: none; }
  .wizard-step.active { display: block; }
  .progress-step { cursor: pointer; }
  .age-option, .type-card, .extra-checkbox-item { cursor: pointer; }
</style>
