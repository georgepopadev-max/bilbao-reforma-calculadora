---
/**
 * Calculadora Index — Bilbao Reforma
 *
 * Selector simple de tipo de reforma. Las 5 calculadoras específicas
 * tienen sus propios wizards detallados.
 */
import CalculadoraLayout from '../../layouts/CalculadoraLayout.astro';
---

<CalculadoraLayout
  title="Calculadora Reformas Bilbao 2026 | Gratis"
  description="Calcula tu reforma en Bilbao en 2 min: baño, cocina, integral, pintura o suelo. Datos reales, sin registro. Empresas verificadas."
  canonical="https://www.bilbaoreforma.es/calculadora/"
>
  <main class="calculator-selector">
    <header class="selector-header">
      <h1>Calculadora de Reformas en Bilbao</h1>
      <p class="selector-subtitle">
        Obtén un <strong>presupuesto orientativo</strong> en menos de 2 minutos.
        Elige qué quieres reformar y la calculadora específica te guiará paso a paso.
      </p>
    </header>

    <section class="calculator-grid" aria-label="Tipos de reforma disponibles">
      <a href="/calculadora/integral-bilbao.html" class="calc-card calc-card-integral">
        <div class="calc-card-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
        <h2 class="calc-card-title">Reforma Integral</h2>
        <p class="calc-card-desc">Renovación completa de vivienda o local. Incluye albañilería, fontanería, electricidad, suelos y acabados.</p>
        <span class="calc-card-price">desde <strong>700 €/m²</strong></span>
        <span class="calc-card-cta">Calcular →</span>
      </a>

      <a href="/calculadora/bano-bilbao.html" class="calc-card calc-card-bano">
        <div class="calc-card-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h11"/><path d="M12 6h0"/><path d="M9 17v-2a2 2 0 0 1 2-2h2"/></svg></div>
        <h2 class="calc-card-title">Reforma de Baño</h2>
        <p class="calc-card-desc">Sanitarios, alicatado, fontanería y electricidad del baño. Incluye instalación de ducha o bañera.</p>
        <span class="calc-card-price">desde <strong>2.500 €</strong></span>
        <span class="calc-card-cta">Calcular →</span>
      </a>

      <a href="/calculadora/cocina-bilbao.html" class="calc-card calc-card-cocina">
        <div class="calc-card-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg></div>
        <h2 class="calc-card-title">Reforma de Cocina</h2>
        <p class="calc-card-desc">Muebles, encimera, electrodomésticos, fontanería y albañilería. Distribución abierta o cerrada.</p>
        <span class="calc-card-price">desde <strong>5.000 €</strong></span>
        <span class="calc-card-cta">Calcular →</span>
      </a>

      <a href="/calculadora/pintura-bilbao.html" class="calc-card calc-card-pintura">
        <div class="calc-card-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 11h2m-2 0v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6m14 0V7a2 2 0 0 0-2-2H9L7 3v2M5 11h14"/></svg></div>
        <h2 class="calc-card-title">Pintura</h2>
        <p class="calc-card-desc">Pintura interior y exterior, techos, carpintería. Acabados lisos, texturados, temple.</p>
        <span class="calc-card-price">desde <strong>8 €/m²</strong></span>
        <span class="calc-card-cta">Calcular →</span>
      </a>

      <a href="/calculadora/suelo-bilbao.html" class="calc-card calc-card-suelo">
        <div class="calc-card-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></div>
        <h2 class="calc-card-title">Cambio de Suelo</h2>
        <p class="calc-card-desc">Madera, porcelánico, microcemento, piedra natural. Incluye retirada del anterior.</p>
        <span class="calc-card-price">desde <strong>25 €/m²</strong></span>
        <span class="calc-card-cta">Calcular →</span>
      </a>
    </section>

    <section class="selector-extras">
      <h2>¿Necesitas ayuda para decidir?</h2>
      <div class="extras-grid">
        <article class="extra-help">
          <h3>📞 Asesoramiento gratis</h3>
          <p>Llamadas sin compromiso para ayudarte a elegir el tipo de reforma según tu caso.</p>
          <a href="tel:+34642147856" class="extra-link">Llamar +34 642 147 856 →</a>
        </article>
        <article class="extra-help">
          <h3>📖 Guías completas</h3>
          <p>Lee nuestro blog con precios actualizados 2026, plazos y consejos por tipo de reforma.</p>
          <a href="/blog/" class="extra-link">Ver blog de reformas →</a>
        </article>
        <article class="extra-help">
          <h3>🏢 Empresas verificadas</h3>
          <p>Directorio de empresas de reformas con reviews reales de clientes en Bilbao, Donostia y Vitoria.</p>
          <a href="/empresas/" class="extra-link">Ver empresas →</a>
        </article>
      </div>
    </section>

    <section class="selector-disclaimer">
      <p>⚠️ Los precios son orientativos y se calculan en base a datos reales del mercado vasco 2026. Para presupuestos personalizados, solicita 3 cotizaciones a empresas locales verificadas.</p>
    </section>
  </main>
</CalculadoraLayout>

<style>
  .calculator-selector {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .selector-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .selector-header h1 {
    font-family: var(--font-playfair);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-grafito);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .selector-subtitle {
    font-size: 1.0625rem;
    color: var(--color-gris);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .calc-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 1.75rem 1.5rem;
    background: var(--color-blanco);
    border: 2px solid var(--color-beige);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .calc-card:hover {
    border-color: var(--color-terracota);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(196, 92, 62, 0.12);
  }

  .calc-card-integral {
    border-top: 4px solid var(--color-verde-montana);
  }

  .calc-card-bano {
    border-top: 4px solid #4A90B8;
  }

  .calc-card-cocina {
    border-top: 4px solid var(--color-terracota);
  }

  .calc-card-pintura {
    border-top: 4px solid #B89D5F;
  }

  .calc-card-suelo {
    border-top: 4px solid #8B6F47;
  }

  .calc-card-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1;
    color: var(--color-terracota);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .calc-card-title {
    font-family: var(--font-playfair);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-grafito);
    margin-bottom: 0.625rem;
  }

  .calc-card-desc {
    font-size: 0.9375rem;
    color: var(--color-gris);
    line-height: 1.55;
    margin-bottom: 1rem;
    flex: 1;
  }

  .calc-card-price {
    font-size: 0.875rem;
    color: var(--color-grafito);
    margin-bottom: 1rem;
  }

  .calc-card-price strong {
    color: var(--color-terracota);
    font-weight: 700;
    font-size: 1rem;
  }

  .calc-card-cta {
    display: inline-block;
    padding: 0.625rem 1.25rem;
    background: var(--color-crema);
    color: var(--color-terracota);
    border-radius: var(--radius-button);
    font-weight: 600;
    font-size: 0.9375rem;
    align-self: flex-start;
    transition: all var(--transition-base);
  }

  .calc-card:hover .calc-card-cta {
    background: var(--color-terracota);
    color: var(--color-blanco);
  }

  .selector-extras {
    background: var(--color-crema);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    margin-bottom: 3rem;
  }

  .selector-extras h2 {
    font-family: var(--font-playfair);
    font-size: 1.5rem;
    color: var(--color-grafito);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .extras-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .extra-help {
    padding: 1.25rem;
    background: var(--color-blanco);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .extra-help h3 {
    font-family: var(--font-playfair);
    font-size: 1.125rem;
    color: var(--color-grafito);
    margin-bottom: 0.5rem;
  }

  .extra-help p {
    color: var(--color-gris);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .extra-link {
    color: var(--color-terracota);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .extra-link:hover {
    text-decoration: underline;
  }

  .selector-disclaimer {
    background: rgba(196, 92, 62, 0.05);
    border-left: 4px solid var(--color-terracota);
    border-radius: var(--radius-card);
    padding: 1rem 1.5rem;
  }

  .selector-disclaimer p {
    color: var(--color-grafito);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .calculator-selector { padding: 2rem 1rem; }
    .calculator-grid { grid-template-columns: 1fr; }
  }
</style>
