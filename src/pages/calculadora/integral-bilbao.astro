---
/**
 * Calculadora Reforma Integral Bilbao — Whole-home renovation calculator
 * A3 Zone
 * No minimum clamp — price varies too much by size
 */
import CalculadoraLayout from '../../layouts/CalculadoraLayout.astro';
import Calculator from '../../components/calculator/Calculator.astro';
---

<CalculadoraLayout
  title="Calculadora Reforma Integral Bilbao 2026"
  description="Calculadora de Reforma Integral en Bilbao 2026 — Presupuesto orientativo desde 700 €/m². Reforma completa de piso o vivienda."
  canonical="https://www.bilbaoreforma.es/calculadora/integral-bilbao.html"
  city="bilbao"
  calculatorType="integral"
>
  <!-- CTA banner -->
  <div class="calculator-cta-banner">
    <a href="/calculadora/index.html">
      <span>🏠 ¿Sabes qué tipo de reforma necesitas? Usa nuestra calculadora paso a paso</span>
      <span>→ Calcular</span>
    </a>
  </div>

  <!-- Editorial intro -->
  <div class="calculator-intro-editorial">
    <h2>Reforma Integral en Bilbao: desde 700 €/m²</h2>
    <p>La reforma integral incluye todas las estancias: cocina, baños, pintura, suelo e instalaciones. El precio medio en Bilbao para una reforma integral está entre <strong>700 y 1.200 €/m²</strong> dependiendo del nivel de acabados.</p>
    <p><a href="/blog/reforma-integral-bilbao.html">Leer artículo: Guía completa de la reforma integral en Bilbao</a></p>
  </div>

  <!-- Wizard -->
  <Calculator
    title="Reforma Integral en Bilbao"
    city="bilbao"
    calculatorType="integral"
  >
    <!-- STEP 1: Metros -->
    <div class="wizard-step active" id="step1" data-step="1">
      <div class="step-header">
        <h1>¿Cuántos metros tiene la vivienda?</h1>
        <p class="step-subtitle">Metros cuadrados útiles a reformar</p>
      </div>
      <div class="meters-input-group">
        <label class="meters-label" for="metersInput">Metros cuadrados</label>
        <div class="meters-value-display">
          <span class="meters-value-number" id="metersDisplayValue">75</span>
          <span class="meters-value-unit">m²</span>
        </div>
        <input type="number" id="metersInput" class="meters-input" value="75" min="20" max="300" placeholder="20–300" aria-label="Metros cuadrados de la vivienda" />
        <input type="range" id="metersSlider" class="meters-slider" min="20" max="300" value="75" aria-label="Slider de metros cuadrados" />
        <div class="meters-presets">
          <button class="meters-preset-btn" data-meters="50" type="button">Piso pequeño<br><small>~40–55 m²</small></button>
          <button class="meters-preset-btn" data-meters="75" type="button">Piso medio<br><small>~65–85 m²</small></button>
          <button class="meters-preset-btn" data-meters="120" type="button">Piso grande<br><small>~100–130 m²</small></button>
          <button class="meters-preset-btn" data-meters="200" type="button">Vivienda grande<br><small>&gt;150 m²</small></button>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Continuar →</button>
      </nav>
    </div>

    <!-- STEP 2: Estado actual -->
    <div class="wizard-step" id="step2" data-step="2">
      <div class="step-header">
        <h1>¿En qué estado está la vivienda?</h1>
        <p class="step-subtitle">Esto determina cuánto trabajo hay que hacer</p>
      </div>
      <div class="age-options" id="estadoOptions">
        <div class="age-option selected" data-value="bueno" role="button" tabindex="0" aria-pressed="true">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Buen estado general</div>
            <div class="age-option-desc">Reforma estética y pequeños cambios</div>
          </div>
          <span class="age-option-badge">×0.7</span>
        </div>
        <div class="age-option" data-value="a_renovar" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Necesita renovar</div>
            <div class="age-option-desc">Cocina/baños antiguos, pintura deteriorada</div>
          </div>
          <span class="age-option-badge">×1.0</span>
        </div>
        <div class="age-option" data-value="obra_completa" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Obra completa</div>
            <div class="age-option-desc">Todo por hacer: instalaciones, tabiques, acabados</div>
          </div>
          <span class="age-option-badge">×1.3</span>
        </div>
        <div class="age-option" data-value="casco_viejo" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Reforma total en casco viejo</div>
            <div class="age-option-desc">Edificio antiguo, sin licencias recientes</div>
          </div>
          <span class="age-option-badge">×1.5</span>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Continuar →</button>
      </nav>
    </div>

    <!-- STEP 3: Nivel de calidad -->
    <div class="wizard-step" id="step3" data-step="3">
      <div class="step-header">
        <h1>¿Qué nivel de calidad quieres?</h1>
      </div>
      <div class="age-options" id="calidadOptions">
        <div class="age-option selected" data-value="basica" role="button" tabindex="0" aria-pressed="true">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Básica / Funcional</div>
            <div class="age-option-desc">Materiales Leroy Merlin, marca blanca</div>
          </div>
          <span class="age-option-badge">700 €/m²</span>
        </div>
        <div class="age-option" data-value="media" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Calidad media</div>
            <div class="age-option-desc">Cosentino, Bosch, Grohe</div>
          </div>
          <span class="age-option-badge">950 €/m²</span>
        </div>
        <div class="age-option" data-value="alta" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Alta gama</div>
            <div class="age-option-desc">A medida, Gaggenau, Hansgrohe</div>
          </div>
          <span class="age-option-badge">1.200 €/m²</span>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Continuar →</button>
      </nav>
    </div>

    <!-- STEP 4: Distribución -->
    <div class="wizard-step" id="step4" data-step="4">
      <div class="step-header">
        <h1>¿Necesitas cambiar la distribución?</h1>
        <p class="step-subtitle">Derribar tabiques o hacer nuevos</p>
      </div>
      <div class="age-options" id="distribOptions">
        <div class="age-option selected" data-value="no" role="button" tabindex="0" aria-pressed="true">
          <div class="age-option-radio"></div>
          <div class="age-option-title">No, se mantiene la distribución actual</div>
        </div>
        <div class="age-option" data-value="paredes" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Cambio de 1–2 paredes</div>
            <div class="age-option-desc">Apertura de cocina al salón, unir habitaciones</div>
          </div>
          <span class="age-option-badge">+2.500 €</span>
        </div>
        <div class="age-option" data-value="reforma" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Reforma completa de distribución</div>
            <div class="age-option-desc">3 o más paredes nuevas o derruidas</div>
          </div>
          <span class="age-option-badge">+6.000 €</span>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Continuar →</button>
      </nav>
    </div>

    <!-- STEP 5: Instalaciones -->
    <div class="wizard-step" id="step5" data-step="5">
      <div class="step-header">
        <h1>¿Qué instalaciones hay que renovar?</h1>
      </div>
      <div class="age-options" id="instalOptions">
        <div class="age-option selected" data-value="ninguna" role="button" tabindex="0" aria-pressed="true">
          <div class="age-option-radio"></div>
          <div class="age-option-title">Instalaciones en buen estado</div>
        </div>
        <div class="age-option" data-value="electricidad" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-title">Renovar electricidad completa</div>
          <span class="age-option-badge">+3.000 €</span>
        </div>
        <div class="age-option" data-value="fontaneria" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-title">Renovar fontanería completa</div>
          <span class="age-option-badge">+2.500 €</span>
        </div>
        <div class="age-option" data-value="ambas" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-title">Electricidad + Fontanería</div>
          <span class="age-option-badge">+5.000 €</span>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Continuar →</button>
      </nav>
    </div>

    <!-- STEP 6: Acabados -->
    <div class="wizard-step" id="step6" data-step="6">
      <div class="step-header">
        <h1>¿Qué nivel de acabados?</h1>
      </div>
      <div class="age-options" id="acabadosOptions">
        <div class="age-option selected" data-value="estandar" role="button" tabindex="0" aria-pressed="true">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Estándar</div>
            <div class="age-option-desc">Pintura plástica, suelo laminado</div>
          </div>
          <span class="age-option-badge">×1.0</span>
        </div>
        <div class="age-option" data-value="bueno" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Bueno</div>
            <div class="age-option-desc">Pintura premium, parquet, cerámica símil madera</div>
          </div>
          <span class="age-option-badge">×1.15</span>
        </div>
        <div class="age-option" data-value="premium" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div>
            <div class="age-option-title">Premium</div>
            <div class="age-option-desc">Microcemento, piedra natural, papel pintado</div>
          </div>
          <span class="age-option-badge">×1.35</span>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Ver presupuesto →</button>
      </nav>
    </div>

    <!-- STEP 7: Resultado -->
    <div class="wizard-step" id="step7" data-step="7">
      <div class="result-container">
        <div class="result-header">
          <h1 class="result-title">Tu reforma integral en Bilbao cuesta entre</h1>
          <div class="result-range">
            <span class="result-range-low" id="resultRangeLow">—</span>
            <span class="result-range-separator">—</span>
            <span class="result-range-high" id="resultRangeHigh">—</span>
          </div>
        </div>
        <div class="result-breakdown">
          <p style="margin:0;font-family:var(--font-inter);font-size:0.875rem;">Precio orientativo incluye materiales y mano de obra. Puede variar según condiciones del edificio.</p>
        </div>
        <div class="result-disclaimer">
          ⚠️ Este presupuesto es orientativo y puede variar ±20% según el estado del edificio y acabados seleccionados.
        </div>
        <nav class="wizard-nav">
          <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Modificar</button>
          <button class="wizard-nav-btn wizard-nav-btn-primary" type="button" onclick="window.location.href='/calculadora/integral-bilbao.html'">Nuevo cálculo →</button>
        </nav>
      </div>
    </div>
  </Calculator>
</CalculadoraLayout>

<script>
  import { BARRIO_MULTIPLIERS, BARRIO_LABELS, formatCurrency } from '/src/scripts/calculator/index.ts';

  const urlParams = new URLSearchParams(window.location.search);
  const barrio = urlParams.get('barrio');

  if (barrio && BARRIO_LABELS[barrio as keyof typeof BARRIO_LABELS]) {
    const stepHeader = document.querySelector('#step1 .step-header');
    if (stepHeader) {
      const badge = document.createElement('div');
      badge.style.cssText = 'display:inline-block;background:var(--color-verde-montana);color:var(--color-blanco);padding:0.25rem 0.75rem;border-radius:var(--radius-pill);font-size:0.8125rem;font-weight:600;margin-bottom:0.75rem;font-family:var(--font-inter);';
      badge.textContent = 'Barrio: ' + BARRIO_LABELS[barrio as keyof typeof BARRIO_LABELS];
      stepHeader.insertBefore(badge, stepHeader.firstChild);
    }
  }

  const state = {
    metros: 75,
    estado: 'a_renovar',
    calidad: 'basica',
    distrib: 'no',
    instalaciones: 'ninguna',
    acabados: 'estandar',
  };

  function showStep(n: number) {
    document.querySelectorAll('.stepper-step').forEach(el => {
      const step = parseInt((el as HTMLElement).dataset.step || '0');
      el.classList.remove('active', 'completed');
      if (step < n) el.classList.add('completed');
      if (step === n) el.classList.add('active');
    });
    document.querySelectorAll('.wizard-step').forEach(el => {
      (el as HTMLElement).style.display = 'none';
      el.classList.remove('active');
    });
    const step = document.querySelector(`.wizard-step[data-step="${n}"]`);
    if (step) {
      (step as HTMLElement).style.display = 'block';
      step.classList.add('active');
    }
  }

  function updateSqm(val: number) {
    state.metros = val;
    const display = document.getElementById('metersDisplayValue');
    const input = document.getElementById('metersInput') as HTMLInputElement;
    const slider = document.getElementById('metersSlider') as HTMLInputElement;
    if (display) display.textContent = String(val);
    if (input) input.value = String(val);
    if (slider) slider.value = String(val);
  }

  function selectOption(containerId: string, key: string, value: string) {
    state[key as keyof typeof state] = value as any;
    const container = document.getElementById(containerId);
    if (!container) return;
    container.querySelectorAll('.age-option').forEach(opt => {
      const isSelected = opt.getAttribute('data-value') === value;
      opt.classList.toggle('selected', isSelected);
      opt.setAttribute('aria-pressed', String(isSelected));
    });
  }

  function calculateIntegral() {
    const m2 = state.metros;
    const rateMap: Record<string, number> = { basica: 700, media: 950, alta: 1200 };
    const estadoMult: Record<string, number> = { bueno: 0.7, a_renovar: 1.0, obra_completa: 1.3, casco_viejo: 1.5 };
    const distribExtra: Record<string, number> = { no: 0, paredes: 2500, reforma: 6000 };
    const instalExtra: Record<string, number> = { ninguna: 0, electricidad: 3000, fontaneria: 2500, ambas: 5000 };
    const acabadosMult: Record<string, number> = { estandar: 1.0, bueno: 1.15, premium: 1.35 };

    const rate = rateMap[state.calidad] || 700;
    const estado = estadoMult[state.estado] || 1.0;
    const acabados = acabadosMult[state.acabados] || 1.0;
    const distrib = distribExtra[state.distrib] || 0;
    const instal = instalExtra[state.instalaciones] || 0;

    let base = m2 * rate * estado * acabados + distrib + instal;

    if (barrio && BARRIO_MULTIPLIERS[barrio as keyof typeof BARRIO_MULTIPLIERS]) {
      base *= BARRIO_MULTIPLIERS[barrio as keyof typeof BARRIO_MULTIPLIERS];
    }

    const low = Math.round(base * 0.80);
    const high = Math.round(base * 1.20);

    return { low, high };
  }

  function showResult() {
    const { low, high } = calculateIntegral();
    showStep(7);
    const lowEl = document.getElementById('resultRangeLow');
    const highEl = document.getElementById('resultRangeHigh');
    if (lowEl) lowEl.textContent = formatCurrency(low) + ' €';
    if (highEl) highEl.textContent = formatCurrency(high) + ' €';
  }

  let currentStep = 1;

  document.querySelectorAll('.wizard-nav-btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep === 6) { showResult(); }
      else { currentStep++; showStep(currentStep); }
    });
  });

  document.querySelectorAll('.wizard-nav-btn-back').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentStep > 1) { currentStep--; showStep(currentStep); }
    });
  });

  const metersInput = document.getElementById('metersInput') as HTMLInputElement;
  const metersSlider = document.getElementById('metersSlider') as HTMLInputElement;
  metersInput?.addEventListener('input', () => updateSqm(parseInt(metersInput.value)));
  metersSlider?.addEventListener('input', () => updateSqm(parseInt(metersSlider.value)));

  document.querySelectorAll('.meters-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const m = parseInt((btn as HTMLButtonElement).dataset.meters || '75');
      updateSqm(m);
    });
  });

  ['bueno', 'a_renovar', 'obra_completa', 'casco_viejo'].forEach(val => {
    document.querySelectorAll(`[data-value="${val}"]`).forEach(el => {
      el.addEventListener('click', () => selectOption('estadoOptions', 'estado', val));
    });
  });

  ['basica', 'media', 'alta'].forEach(val => {
    document.querySelectorAll(`[data-value="${val}"]`).forEach(el => {
      el.addEventListener('click', () => selectOption('calidadOptions', 'calidad', val));
    });
  });

  ['no', 'paredes', 'reforma'].forEach(val => {
    document.querySelectorAll(`[data-value="${val}"]`).forEach(el => {
      el.addEventListener('click', () => selectOption('distribOptions', 'distrib', val));
    });
  });

  ['ninguna', 'electricidad', 'fontaneria', 'ambas'].forEach(val => {
    document.querySelectorAll(`[data-value="${val}"]`).forEach(el => {
      el.addEventListener('click', () => selectOption('instalOptions', 'instalaciones', val));
    });
  });

  ['estandar', 'bueno', 'premium'].forEach(val => {
    document.querySelectorAll(`[data-value="${val}"]`).forEach(el => {
      el.addEventListener('click', () => selectOption('acabadosOptions', 'acabados', val));
    });
  });

  showStep(1);
</script>
