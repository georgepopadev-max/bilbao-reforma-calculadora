  description="Calcula el presupuesto orientativo de tu reforma de baño en Bilbao. Precio real desde 2.500€ para baño completo. Sin registro, en 2 minutos."
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

