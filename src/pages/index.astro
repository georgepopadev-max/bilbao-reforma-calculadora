---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import SeoContent from '../components/home/SeoContent.astro';
import FAQ from '../components/home/FAQ.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import WhyUs from '../components/home/WhyUs.astro';
import Testimonials from '../components/home/Testimonials.astro';
import FeaturedCities from '../components/home/FeaturedCities.astro';
import VerifiedCompanies from '../components/home/VerifiedCompanies.astro';
import PopularArticles from '../components/home/PopularArticles.astro';
import FinalCTA from '../components/home/FinalCTA.astro';

// Schemas from legacy (lines 58-260 of legacy/index.html)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.bilbaoreforma.es/#organization",
  "name": "Bilbao Reforma",
  "url": "https://www.bilbaoreforma.es",
  "logo": "https://www.bilbaoreforma.es/images/logo.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+34-644-937-618",
    "contactType": "customer service",
    "areaServed": "ES",
    "availableLanguage": ["Spanish", "Basque"]
  },
  "sameAs": []
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Bilbao Reforma",
  "url": "https://www.bilbaoreforma.es",
  "publisher": { "@id": "https://www.bilbaoreforma.es/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.bilbaoreforma.es/buscar?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.bilbaoreforma.es/#business",
  "name": "Bilbao Reforma",
  "description": "Directorio de empresas de reformas verificadas y calculadora de presupuestos online para Bilbao, Donostia y Vitoria-Gasteiz.",
  "url": "https://www.bilbaoreforma.es",
  "logo": "https://www.bilbaoreforma.es/images/logo.png",
  "image": "https://www.bilbaoreforma.es/images/og/home-og.jpg",
  "telephone": "+34 642 147 856",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Gran Vía 1",
    "addressLocality": "Bilbao",
    "postalCode": "48001",
    "addressRegion": "Bizkaia",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 43.2630,
    "longitude": -2.9350
  },
  "areaServed": [
    { "@type": "City", "name": "Bilbao" },
    { "@type": "City", "name": "Donostia-San Sebastián" },
    { "@type": "City", "name": "Vitoria-Gasteiz" }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "09:00",
      "closes": "18:00"
    }
  ],
  "sameAs": []
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Reformas integrales y presupuestos online",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.bilbaoreforma.es/#business"
  },
  "areaServed": [
    { "@type": "City", "name": "Bilbao" },
    { "@type": "City", "name": "Donostia-San Sebastián" },
    { "@type": "City", "name": "Vitoria-Gasteiz" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de reforma",
    "itemListElement": [
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Reforma integral"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Reforma de baño"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Reforma de cocina"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Cambio de suelo"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Pintura de piso"}}
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta una reforma integral en Bilbao?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio medio de una reforma integral en Bilbao oscila entre 700€ y 1.400€ por metro cuadrado, dependiendo del nivel de calidad elegido. Para un piso de 80m², el presupuesto orientativo se sitúa entre 56.000€ y 112.000€. Usa nuestra calculadora para obtener un desglose personalizado por partidas."
      }
    },
    {
      "@type": "Question",
      "name": "¿La calculadora de presupuestos es gratuita?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, completamente gratuita. La calculadora de reformas de Bilbao Reforma te ofrece un presupuesto orientativo en menos de 2 minutos sin necesidad de registro, teléfono ni email. Es una herramienta informativa para ayudarte a planificar tu reforma."
      }
    },
    {
      "@type": "Question",
      "name": "¿Los precios se actualizan con el coste actual en Bilbao?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Los precios de la calculadora se basan en datos reales de empresas de reformas activas en Bilbao y Bizkaia, no en tablas genéricas de internet. Actualizamos las tarifas regularmente para reflejar el mercado local de 2026."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo contratar directamente a una empresa desde la web?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La calculadora te da un presupuesto orientativo. Si lo deseas, puedes solicitar presupuestos personalizados a empresas de reformas en Bilbao a través de nuestro directorio de empresas verificadas, todas con experiencia local demostrada."
      }
    }
  ]
};
---

<BaseLayout
  title="Calculadora de Reformas Bilbao | Gratis 2026"
  description="Calcula el presupuesto de tu reforma en Bilbao en 2 minutos. Precios reales de empresas locales. Reforma integral, cocina, baño y pintura. Sin registro."
  canonical="https://www.bilbaoreforma.es/"
  jsonSchemas={[organizationSchema, websiteSchema, localBusinessSchema, serviceSchema, faqSchema]}
  ogImage="https://www.bilbaoreforma.es/images/og/home-og.jpg"
  ogImageAlt="Reformas Bilbao 2026"
>
  <Header city="bilbao" />

  <main id="main-content">
    <Hero />
    <SeoContent />
    <FAQ />

    <!-- Content + sidebar layout -->
    <div class="home-content-layout">
      <!-- Main column -->
      <div class="home-content">
        <HowItWorks />
        <WhyUs />
        <Testimonials />
      </div>
      <!-- Sidebar -->
      <aside class="home-sidebar">
        <div class="sidebar-sticky">
          <PopularArticles />
        </div>
      </aside>
    </div>

    <FeaturedCities />
    <VerifiedCompanies />

    <!-- Internal linking: Calcula tu reforma — 5 cards to SEO landing pages -->
    <section style="background:var(--color-crema);padding:3rem 0;margin:0">
      <div style="max-width:1100px;margin:0 auto;padding:0 1.5rem">
        <h2 style="font-family:var(--font-playfair);font-size:1.75rem;font-weight:700;color:var(--color-grafito);text-align:center;margin-bottom:0.5rem">Calcula tu reforma en Bilbao</h2>
        <p style="text-align:center;color:var(--color-gris);margin-bottom:2rem;font-size:1rem">Presupuesto orientativo en 2 minutos — sin registro, sin compromiso</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem">
          <a href="/presupuesto-reforma-integral-bilbao.html" style="display:flex;flex-direction:column;align-items:center;padding:1.5rem;background:#fff;border-radius:12px;border:2px solid var(--color-beige);text-decoration:none;color:inherit;transition:all 0.2s;text-align:center">
            <span style="font-size:2rem;margin-bottom:0.75rem">🏗️</span>
            <strong style="color:var(--color-grafito);font-size:0.9375rem;margin-bottom:0.25rem">Reforma Integral</strong>
            <span style="color:var(--color-terracota);font-weight:700;font-size:0.875rem">desde 700€/m²</span>
            <span style="font-size:0.8125rem;color:var(--color-gris);margin-top:0.5rem">presupuesto reforma integral bilbao →</span>
          </a>
          <a href="/presupuesto-reforma-bano-bilbao.html" style="display:flex;flex-direction:column;align-items:center;padding:1.5rem;background:#fff;border-radius:12px;border:2px solid var(--color-beige);text-decoration:none;color:inherit;transition:all 0.2s;text-align:center">
            <span style="font-size:2rem;margin-bottom:0.75rem">🚿</span>
            <strong style="color:var(--color-grafito);font-size:0.9375rem;margin-bottom:0.25rem">Reforma de Baño</strong>
            <span style="color:var(--color-terracota);font-weight:700;font-size:0.875rem">desde 3.500 €</span>
            <span style="font-size:0.8125rem;color:var(--color-gris);margin-top:0.5rem">precio reforma baño bilbao →</span>
          </a>
          <a href="/presupuesto-reforma-cocina-bilbao.html" style="display:flex;flex-direction:column;align-items:center;padding:1.5rem;background:#fff;border-radius:12px;border:2px solid var(--color-beige);text-decoration:none;color:inherit;transition:all 0.2s;text-align:center">
            <span style="font-size:2rem;margin-bottom:0.75rem">🍳</span>
            <strong style="color:var(--color-grafito);font-size:0.9375rem;margin-bottom:0.25rem">Reforma de Cocina</strong>
            <span style="color:var(--color-terracota);font-weight:700;font-size:0.875rem">desde 5.000 €</span>
            <span style="font-size:0.8125rem;color:var(--color-gris);margin-top:0.5rem">presupuesto reforma cocina bilbao →</span>
          </a>
          <a href="/presupuesto-pintura-piso-bilbao.html" style="display:flex;flex-direction:column;align-items:center;padding:1.5rem;background:#fff;border-radius:12px;border:2px solid var(--color-beige);text-decoration:none;color:inherit;transition:all 0.2s;text-align:center">
            <span style="font-size:2rem;margin-bottom:0.75rem">🎨</span>
            <strong style="color:var(--color-grafito);font-size:0.9375rem;margin-bottom:0.25rem">Pintura</strong>
            <span style="color:var(--color-terracota);font-weight:700;font-size:0.875rem">desde 800 €</span>
            <span style="font-size:0.8125rem;color:var(--color-gris);margin-top:0.5rem">precio pintura piso bilbao →</span>
          </a>
          <a href="/presupuesto-cambio-suelo-bilbao.html" style="display:flex;flex-direction:column;align-items:center;padding:1.5rem;background:#fff;border-radius:12px;border:2px solid var(--color-beige);text-decoration:none;color:inherit;transition:all 0.2s;text-align:center">
            <span style="font-size:2rem;margin-bottom:0.75rem">🏠</span>
            <strong style="color:var(--color-grafito);font-size:0.9375rem;margin-bottom:0.25rem">Cambio de Suelo</strong>
            <span style="color:var(--color-terracota);font-weight:700;font-size:0.875rem">desde 1.200 €</span>
            <span style="font-size:0.8125rem;color:var(--color-gris);margin-top:0.5rem">precio cambio suelo bilbao →</span>
          </a>
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>

  <Footer city="bilbao" />
</BaseLayout>

<style>
  .home-content-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }
  .home-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .home-sidebar {
    min-width: 0;
  }
  .sidebar-sticky {
    position: sticky;
    top: 6rem;
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(45,30,15,0.06);
  }
  @media (max-width: 1024px) {
    .home-content-layout {
      grid-template-columns: 1fr;
    }
    .sidebar-sticky {
      position: static;
    }
  }
</style>
