  .in-content-cta { background: #FAF7F2; border-left: 3px solid #C45C3E; padding: 1rem 1.25rem; border-radius: 0 8px 8px 0; margin: 2rem 0; }
  .in-content-cta-label { display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: #C45C3E; margin-bottom: 0.25rem; }
  .in-content-cta a { font-size: 0.9375rem; color: #2D2D2D; font-weight: 500; text-decoration: none; }
  .in-content-cta a:hover { text-decoration: underline; }
