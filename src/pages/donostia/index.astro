---
/**
 * Donostia Index — Bilbao Reforma
 * A3 Zone — Full migration from legacy/donostia/index.html
 */
import CityLayout from '../../layouts/CityLayout.astro';
import HeroCity from '../../components/home/HeroCity.astro';
import HowItWorks from '../../components/home/HowItWorks.astro';
import WhyUs from '../../components/home/WhyUs.astro';
import TestimonialsCity from '../../components/home/TestimonialsCity.astro';
import VerifiedCompaniesCity from '../../components/home/VerifiedCompaniesCity.astro';
import PopularArticles from '../../components/home/PopularArticles.astro';
import FAQCity from '../../components/home/FAQCity.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';

// Schemas specific to Donostia
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.bilbaoreforma.es/#business-donostia',
  'name': 'Reforma Donostia',
  description: 'Calculadora de presupuestos de reformas en Donostia/San Sebastián y Gipuzkoa. Precios orientativos en menos de 2 minutos.',
  url: 'https://www.bilbaoreforma.es/donostia/',
  logo: 'https://www.bilbaoreforma.es/images/logo.png',
  image: 'https://www.bilbaoreforma.es/images/og/home-og.jpg',
  telephone: '+34 642 147 856',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    'addressLocality': 'Donostia-San Sebastián',
    'addressRegion': 'Gipuzkoa',
    'addressCountry': 'ES'
  },
  areaServed: [
    { '@type': 'City', 'name': 'Donostia-San Sebastián' },
    { '@type': 'State', 'name': 'Gipuzkoa' }
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'],
      opens: '09:00',
      closes: '18:00'
    }
  ],
  sameAs: []
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Reformas integrales y presupuestos online',
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://www.bilbaoreforma.es/#business-donostia'
  },
  areaServed: [
    { '@type': 'City', 'name': 'Donostia-San Sebastián' },
    { '@type': 'State', 'name': 'Gipuzkoa' }
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de reforma',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Reforma integral' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Reforma de baño' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Reforma de cocina' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Cambio de suelo' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Pintura de piso' } }
    ]
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuánto cuesta una reforma integral en Donostia?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El precio medio de una reforma integral en Donostia oscila entre 750€ y 1.500€ por metro cuadrado, dependiendo del nivel de calidad elegido. Para un piso de 80m², el presupuesto orientativo se sitúa entre 60.000€ y 120.000€. Usa nuestra calculadora para obtener un desglose personalizado por partidas.'
      }
    },
    {
      '@type': 'Question',
      name: '¿La calculadora de presupuestos es gratuita?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí, completamente gratuita. La calculadora de reformas de Bilbao Reforma te ofrece un presupuesto orientativo en menos de 2 minutos sin necesidad de registro, teléfono ni email. Es una herramienta informativa para ayudarte a planificar tu reforma en Donostia o Gipuzkoa.'
      }
    },
    {
      '@type': 'Question',
      name: '¿Los precios se actualizan con el coste actual en Donostia?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí. Los precios de la calculadora se basan en datos reales de empresas de reformas activas en Donostia y Gipuzkoa, no en tablas genéricas de internet. Actualizamos las tarifas regularmente para reflejar el mercado local de 2026.'
      }
    },
    {
      '@type': 'Question',
      name: '¿Puedo contratar directamente a una empresa desde la web?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'La calculadora te da un presupuesto orientativo. Si lo deseas, puedes solicitar presupuestos personalizados a empresas de reformas en Donostia y Gipuzkoa a través de nuestro directorio de empresas verificadas.'
      }
    }
  ]
};
---

<CityLayout
  title="Reformas Donostia 2026 | Presupuesto Gratis"
  description="Calcula tu reforma en Donostia-San Sebastián en 2 min, gratis. Compara empresas verificadas de Gipuzkoa. Precios reales 2026."
  canonical="https://www.bilbaoreforma.es/donostia/"
  city="donostia"
>
  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <HeroCity city="donostia" />

  <div class="home-content-layout">
    <div class="home-content">
      <HowItWorks />
      <WhyUs city="donostia" />
      <TestimonialsCity city="donostia" />
    </div>
    <aside class="home-sidebar">
      <div class="sidebar-sticky">
        <PopularArticles city="donostia" />
      </div>
    </aside>
  </div>

  <VerifiedCompaniesCity city="donostia" />
  <FAQCity city="donostia" />
  <FinalCTA />
</CityLayout>

<style>
  .home-content-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }
  .home-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .home-sidebar {
    min-width: 0;
  }
  .sidebar-sticky {
    position: sticky;
    top: 6rem;
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(45,30,15,0.06);
  }
  @media (max-width: 1024px) {
    .home-content-layout {
      grid-template-columns: 1fr;
    }
    .sidebar-sticky {
      position: static;
    }
  }
</style>
