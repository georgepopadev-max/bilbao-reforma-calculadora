---
/**
 * Donostia Index — Bilbao Reforma
 * A3 Zone
 */
import CityLayout from '../../layouts/CityLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Reforma Donostia',
  description: 'Calculadora de presupuestos de reformas en Donostia/San Sebastián y Gipuzkoa. Precios orientativos en menos de 2 minutos.',
  url: 'https://www.bilbaoreforma.es/donostia/',
  areaServed: { '@type': 'State', name: 'Gipuzkoa' },
};
---

<CityLayout
  title="Reformas Donostia 2026: Calculadora"
  description="Calculadora de Reformas en Donostia/San Sebastián 2026. Obtén un presupuesto orientativo en menos de 2 minutos."
  canonical="https://www.bilbaoreforma.es/donostia/"
  city="donostia"
  schemaData={schema}
>
  <!-- Hero -->
  <section style="background:linear-gradient(135deg,#C45C3E 0%,#9a4a2f 100%);color:white;padding:4rem 1.5rem;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <h1 style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:700;margin-bottom:1rem;">Reformas en Donostia 2026</h1>
      <p style="font-size:1.1rem;opacity:0.9;margin-bottom:2rem;">Calcula el presupuesto orientativo de tu reforma en Donostia-San Sebastián y Gipuzkoa en menos de 2 minutos.</p>
      <a href="/donostia/calculadora/index.html" style="display:inline-flex;align-items:center;gap:0.5rem;padding:1rem 2rem;background:white;color:#C45C3E;border-radius:8px;font-weight:600;text-decoration:none;font-size:1.1rem;">
        Calcular presupuesto →
      </a>
    </div>
  </section>

  <!-- Calculator cards -->
  <section style="padding:3rem 1.5rem;">
    <div style="max-width:900px;margin:0 auto;">
      <h2 style="font-family:'Playfair Display',serif;font-size:2rem;margin-bottom:1.5rem;text-align:center;">Calculadoras por tipo de reforma</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;">
        <a href="/donostia/calculadora/bano-donostia.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
          <div style="font-size:2rem;margin-bottom:0.75rem;">🚿</div>
          <h3 style="font-size:1rem;margin-bottom:0.5rem;">Reforma de Baño</h3>
          <p style="font-size:0.85rem;color:#666;">Desde 2.500 €</p>
        </a>
        <a href="/calculadora/index.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
          <div style="font-size:2rem;margin-bottom:0.75rem;">🏗️</div>
          <h3 style="font-size:1rem;margin-bottom:0.5rem;">Reforma Integral</h3>
          <p style="font-size:0.85rem;color:#666;">Desde 700 €/m²</p>
        </a>
        <a href="/calculadora/index.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
          <div style="font-size:2rem;margin-bottom:0.75rem;">🍳</div>
          <h3 style="font-size:1rem;margin-bottom:0.5rem;">Reforma de Cocina</h3>
          <p style="font-size:0.85rem;color:#666;">Desde 5.000 €</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section style="padding:2rem 1.5rem;background:#f5f5f5;">
    <div style="max-width:700px;margin:0 auto;text-align:center;">
      <h2 style="font-family:'Playfair Display',serif;font-size:1.8rem;margin-bottom:1rem;">¿Necesitas empresas de reformas en Donostia?</h2>
      <p style="color:#666;margin-bottom:1.5rem;">Consulta nuestro directorio de empresas verificadas en Gipuzkoa.</p>
      <a href="/donostia/empresas/index.html" style="display:inline-block;padding:0.75rem 1.5rem;background:#C45C3E;color:white;border-radius:8px;font-weight:600;text-decoration:none;">Ver empresas →</a>
    </div>
  </section>
</CityLayout>
