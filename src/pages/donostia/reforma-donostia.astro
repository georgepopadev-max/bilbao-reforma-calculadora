---
import CityLayout from '../../layouts/CityLayout.astro';
---
<CityLayout title="Reformas en Donostia-San Sebastián 2026 | Bilbao Reforma" description="Guía completa de reformas en Donostia y Gipuzkoa. Calcula presupuestos y descubre precios." canonical="https://www.bilbaoreforma.es/donostia/reforma-donostia.html" city="donostia">
  <section style="max-width:800px;margin:4rem auto;padding:0 1.5rem;">
    <h1 style="font-family:'Playfair Display',serif;font-size:2.5rem;margin-bottom:1rem;">Reformas en Donostia-San Sebastián 2026</h1>
    <p style="font-size:1.1rem;color:#555;margin-bottom:2rem;">Guía completa de reformas en Donostia y Gipuzkoa.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem;">
      <a href="/donostia/calculadora/index.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
        <h3 style="font-size:1.1rem;margin-bottom:0.5rem;">🏗️ Reforma Integral</h3>
        <p style="font-size:0.9rem;color:#666;">Desde 700 €/m²</p>
      </a>
      <a href="/donostia/calculadora/index.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
        <h3 style="font-size:1.1rem;margin-bottom:0.5rem;">🚿 Reforma de Baño</h3>
        <p style="font-size:0.9rem;color:#666;">Desde 2.500 €</p>
      </a>
    </div>
    <a href="/donostia/calculadora/index.html" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.5rem;background:#C45C3E;color:white;border-radius:8px;font-weight:600;text-decoration:none;">Calcular presupuesto →</a>
  </section>
</CityLayout>
