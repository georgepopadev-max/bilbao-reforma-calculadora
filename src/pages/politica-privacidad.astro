---
/**
 * Política de Privacidad — Bilbao Reforma
 * A3 Zone
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Política de Privacidad | Bilbao Reforma"
  description="Política de privacidad de Bilbao Reforma. Información sobre el tratamiento de datos personales."
  canonical="https://www.bilbaoreforma.es/politica-privacidad.html"
>

  <header class="site-header">
    <div class="header-container">
      <a href="/index.html" class="header-logo">
        <svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span class="header-logo-text">Bilbao Reforma</span>
      </a>
      <nav class="header-nav">
        <a href="/calculadora/index.html" class="header-nav-link">Calculadora</a>
        <a href="/blog/index.html" class="header-nav-link">Blog</a>
        <a href="/empresas/index.html" class="header-nav-link">Empresas</a>
        <a href="/contacto.html" class="header-nav-link header-nav-link-cta">Contacto</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section style="max-width:700px;margin:4rem auto;padding:0 1.5rem;">
      <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.75rem,5vw,2.5rem);margin-bottom:1.5rem;">Política de Privacidad</h1>
      
      <p style="color:#555;line-height:1.8;margin-bottom:1.5rem;"><strong>Responsable:</strong> Bilbao Reforma · <a href="mailto:info@bilbaoreforma.es" style="color:#C45C3E;">info@bilbaoreforma.es</a></p>

      <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin:1.5rem 0 1rem;">Datos que recopilamos</h2>
      <p style="color:#555;line-height:1.8;margin-bottom:1rem;">Este sitio no recopila datos personales a través de formularios. La calculadora de presupuestos funciona entirely locally en tu navegador y no envía datos a ningún servidor.</p>

      <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin:1.5rem 0 1rem;">Cookies</h2>
      <p style="color:#555;line-height:1.8;margin-bottom:1rem;">Este sitio utiliza cookies técnicas necesarias para el funcionamiento básico (city switcher, menú móvil). No se utilizan cookies de tracking ni publicidad.</p>

      <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin:1.5rem 0 1rem;">Tus derechos</h2>
      <p style="color:#555;line-height:1.8;">Puedes ejercer tus derechos de acceso, rectificación y supresión enviando un email a <a href="mailto:info@bilbaoreforma.es" style="color:#C45C3E;">info@bilbaoreforma.es</a>.</p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-bottom">
        <p class="footer-copyright">© 2025–2026 Bilbao Reforma.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
