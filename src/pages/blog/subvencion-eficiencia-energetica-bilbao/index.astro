---
/**
 * subvention-eficiencia-energetica-bilbao — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Cuál es la ayuda máxima del Plan Rehabilita para eficiencia energética?', a: 'El Plan Rehabilita puede conceder hasta 12.750€ por vivienda para actuaciones de rehabilitación energética, cubriendo entre el 25% y el 40% de la inversión elegible según los ingresos.' },
  { q: '¿Qué tipo de obras son elegibles para estas ayudas?', a: 'Son elegibles: aislamiento térmico de fachadas y cubiertas, sustitución de ventanas por otras de doble o triple acristalamiento, instalación de sistemas de calefacción eficientes (aerotermia, caldera de condensación), e instalación de energía solar térmica o fotovoltaica.' },
  { q: '¿Los inquilinos pueden acceder a estas ayudas?', a: 'Las ayudas del Plan Rehabilita están pensadas principalmente para propietarios. Los inquilinos pueden acceder a algunas líneas de accesibilidad o a la deducción del IRPF, pero necesitan el consentimiento del propietario.' },
  { q: '¿Se pueden acumular las ayudas del Plan Rehabilita con Next Generation?', a: 'No, las ayudas del Plan Rehabilita y Next Generation no son acumulables entre sí para la misma actuación. Puedes elegir una u otra, pero la deducción del IRPF sí es compatible con ambas.' },
  { q: '¿Qué pasa si la obra no alcanza los objetivos energéticos declarados?', a: 'Si la obra no alcanza los objetivos energéticos declarados, la Administración puede reclamar la devolución parcial o total de la ayuda percibida.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.bilbaoreforma.es/blog/' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://www.bilbaoreforma.es/blog/subvenciones-reformas/' },
    { '@type': 'ListItem', position: 4, name: 'Bilbao', item: 'https://www.bilbaoreforma.es/blog/subvencion-eficiencia-energetica-bilbao/' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Eficiencia Energética Bilbao 2026: Subvención Hasta 12.750€',
  description: 'Subvención eficiencia energética Bilbao 2026: Plan Rehabilita Bizkaia. Ayudas de hasta 12.750€ por vivienda.',
  datePublished: '2026-06-28',
  dateModified: '2026-06-28',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Eficiencia Energética Bilbao 2026"
  description="Subvención eficiencia energética Bilbao 2026: Plan Rehabilita Bizkaia. Ayudas de hasta 12.750€ por vivienda. Plazos, requisitos y cómo solicitarla."
  canonical="https://www.bilbaoreforma.es/blog/subvencion-eficiencia-energetica-bilbao/"
  ogType="article"
  ogImage="https://www.bilbaoreforma.es/images/og/bilbao-og.jpg"
  ogImageAlt="Eficiencia Energética Bilbao 2026"
  jsonSchemas={jsonSchemas}
>
  <Header city="bilbao" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/index.html" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog/index.html" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas/" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Bilbao</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 28 de junio de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Eficiencia Energética Bilbao 2026: Subvención Hasta 12.750€
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Bilbao cuenta con un parque inmobiliario envejecido: la mayoría de los edificios construidos antes de 1980 tienen una calificación energética G o F, lo que significa que pierden mucha energía. Reformar una vivienda para mejorar su eficiencia no solo reduce tus facturas de calefacción y aire acondicionado, sino que puede costarte mucho menos si conoces las ayudas disponibles.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Plan Rehabilita de Gobierno Vasco es la principal línea de ayuda para la rehabilitación energética de viviendas en Bizkaia. Su presupuesto se renueva cada año y las convocatorias suelen abrir en el primer semestre. Si estás pensando en aislar tu fachada, cambiar las ventanas o instalar un sistema de aerotermia, esta puede ser tu mejor oportunidad para reducir significativamente la inversión.</p>

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos orientativos</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Las cuantías y requisitos que detallamos se basan en información pública de 2024-2025. Las convocatorias de 2026 pueden variar. Consulta siempre las bases oficiales en Viviendazz (Gobierno Vasco) y en la web de la Diputación Foral de Bizkaia antes de iniciar cualquier trámite.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cuantía de la ayuda para eficiencia energética en Bilbao</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Plan Rehabilita de Gobierno Vasco establece cuantías variables según los ingresos de la unidad familiar y el tipo de actuación. Estas son las cuantías orientativas:</p>

      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Cuantías orientativas del Plan Rehabilita para eficiencia energética (datos 2024-2025, consulta convocatoria 2026)</caption>
          <thead>
            <tr>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Tipo de ayuda</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Tramo de ingresos</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">% inversión</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda orientativa</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Rehabilitación energética integral</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Ingresos bajos</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">40%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 12.750 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Rehabilitación energética integral</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Ingresos medios</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">30%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 9.500 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Rehabilitación energética integral</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Ingresos altos</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">25%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 7.500 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Aislamiento térmico paredes</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Cualquiera</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">20-30%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">3.000 - 5.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Cambio de ventanas</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Cualquiera</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">15-25%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.500 - 3.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem;">Instalación aerotermia</td><td style="padding: 0.75rem 1rem;">Cualquiera</td><td style="padding: 0.75rem 1rem;">20-30%</td><td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">2.500 - 5.000 €</td></tr>
          </tbody>
        </table>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Requisitos para solicitar la ayuda</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Ser propietario o inquilino (con consentimiento del propietario) de una vivienda situada en Bilbao o Bizkaia.</li>
        <li style="margin-bottom: 0.5rem;">La vivienda debe ser la residencia habitual del solicitante o tener intención de serlo en un plazo máximo de 6 meses.</li>
        <li style="margin-bottom: 0.5rem;">Los trabajos deben tener un coste elegible mínimo (variable según convocatoria, suele partir de 1.000-2.000€).</li>
        <li style="margin-bottom: 0.5rem;">Las obras deben ser ejecutadas por empresas inscritas en el Registro de Empresas de Rehabilitación de Gobierno Vasco.</li>
        <li style="margin-bottom: 0.5rem;">Es necesario contratar un técnico competente (arquitecto o arquitecto técnico) que elabore el proyecto y certifique las obras.</li>
        <li style="margin-bottom: 0.5rem;">La vivienda debe estar al corriente de pago de tasas municipales y no tener deudas pendientes con la Administración.</li>
        <li style="margin-bottom: 0.5rem;">Las obras deben cumplir la normativa urbanística y de construcción vigente en Bizkaia.</li>
        <li style="margin-bottom: 0;">Se requiere aporte de certificados energéticos antes y después de la reforma.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Documentación necesaria</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">DNI o NIE del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Escritura de propiedad de la vivienda o contrato de alquiler vigente.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de empadronamiento que acredite la residencia habitual.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de la renta de la unidad familiar o certificación de ingresos.</li>
        <li style="margin-bottom: 0.5rem;">Presupuesto detallado de las actuaciones redactado por técnico competente.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de Eficiencia Energética de la vivienda antes de la obra.</li>
        <li style="margin-bottom: 0.5rem;">Informe técnico que describa las actuaciones previstas y su impacto energético.</li>
        <li style="margin-bottom: 0;">Alta fiscal de la empresa de reformas que ejecutará los trabajos.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Plazos y convocatoria 2026</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Primera convocatoria:</strong> Prevista para marzo-abril de 2026 (Bizkaia).</li>
        <li style="margin-bottom: 0.5rem;"><strong>Segunda convocatoria:</strong> Prevista para junio de 2026 (Bizkaia).</li>
        <li style="margin-bottom: 0.5rem;"><strong>Plazo de ejecución:</strong> Habitualmente 12-18 meses desde la resolución favorable.</li>
        <li style="margin-bottom: 0;"><strong>Justificación de gasto:</strong> Un plazo adicional de 2-3 meses tras finalizar las obras.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cómo solicitarla paso a paso</h2>
      <ol style="margin: 1.5rem 0; padding-left: 1.5rem; color: var(--color-grafito); list-style: none; counter-reset: step;">
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem; counter-increment: step;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">1</span><strong>Consulta la convocatoria:</strong> Accede a la web de Viviendazz (vivienda.euskadi.eus) para conocer las bases exactas de la convocatoria vigente.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">2</span><strong>Contrata un técnico:</strong> Un arquitecto o arquitecto técnico debe redactar el proyecto técnico y emitirá el certificado de partida.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">3</span><strong>Solicita certificados previos:</strong> Obtén el Certificado de Eficiencia Energética de tu vivienda en su estado actual.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">4</span><strong>Recibe presupuestos:</strong> Pide al menos 2-3 presupuestos detallados a empresas de reformas inscritas.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">5</span><strong>Presenta la solicitud:</strong> Rellena el formulario a través de la sede electrónica dentro del plazo.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">6</span><strong>Espera la resolución:</strong> El plazo de resolución suele ser de 2-4 meses.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">7</span><strong>Ejecuta la obra:</strong> Una vez concedida la ayuda, ejecuta la reforma con la empresa elegida.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">8</span><strong>Justifica el gasto:</strong> Presenta la documentación de justificación dentro del plazo establecido.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 0;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">9</span><strong>Cobra la ayuda:</strong> Una vez verificada la justificación, se procede al pago.</li>
      </ol>

      <div style="background: linear-gradient(135deg, #F6FBF0 0%, #E8F0E4 100%); border: 1px solid #C4D8B0; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: var(--color-verde-montana); margin-top: 0; font-size: 1rem; font-family: var(--font-playfair); margin-bottom: 0.5rem;">Compatibilidad con otras ayudas</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">La deducción del IRPF por obras de mejora energética es <strong>compatible</strong> con las ayudas del Plan Rehabilita y Next Generation. Las ayudas del Plan Rehabilita y Next Generation <strong>no son acumulables</strong> entre sí para la misma actuación: tendrás que elegir una u otra.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem; transition: all 0.2s;">
          <a href="/blog/subvencion-cambio-ventanas-bilbao/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-reformas-bilbao-2026/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
      </div>

    </article>
  </main>

  <Footer city="bilbao" />
</BaseLayout>
