---
/**
 * subvention-eficiencia-energetica-bilbao — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import CalcCta from '../../../components/CalcCta.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MunicipiosLinks from '../../../components/MunicipiosLinks.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Qué ayudas hay para instalar aerotermia en Bilbao?', a: 'El programa Eguzki Hotz del EVE, abierto desde el 5 de noviembre de 2026: 500 euros por kW con un máximo de 3.000 euros por vivienda y hasta el 65 % del coste. Además, la deducción del 15 % del IRPF de Bizkaia.' },
  { q: '¿Cuánto me puedo desgravar por obras de eficiencia energética en Bizkaia?', a: 'El 15 % de lo invertido, con una base máxima de 20.000 euros al año, por obras de mejora de la eficiencia energética e integración de renovables en la vivienda. Está vigente de 2025 a 2035.' },
  { q: '¿Puedo aplicar las deducciones estatales del 20, 40 o 60 %?', a: 'No, si tributas en Bizkaia. Esas deducciones son de la Agencia Tributaria estatal y no se aplican en los territorios forales.' },
  { q: '¿Hay ayudas para cambiar la caldera de gas?', a: 'Las calderas de gas no entran en Eguzki Hotz, que solo subvenciona bombas de calor y renovables. Desde 2025 la normativa europea impide subvencionar calderas que solo usan combustibles fósiles.' },
  { q: '¿Siguen las ayudas Next Generation?', a: 'No para solicitudes nuevas. En Euskadi están cerradas desde junio de 2023 y las obras concedidas debían terminar antes del 30 de junio de 2026.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bilbaoreforma.es/blog' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://bilbaoreforma.es/blog/subvenciones-reformas' },
    { '@type': 'ListItem', position: 4, name: 'Bilbao', item: 'https://bilbaoreforma.es/blog/subvencion-eficiencia-energetica-bilbao' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Ayudas para Eficiencia Energética en Bilbao 2026',
  description: 'Ayudas para eficiencia energética en Bilbao en 2026: Eguzki Hotz (hasta 3.000 € en aerotermia), deducción del 15 % en el IRPF de Bizkaia, Gobierno Vasco y Surbisa.',
  datePublished: '2026-06-28',
  dateModified: '2026-11-11',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Ayudas Eficiencia Energética Bilbao 2026: Qué Hay Abierto"
  description="Ayudas para eficiencia energética en Bilbao en 2026: Eguzki Hotz (hasta 3.000 € en aerotermia), deducción del 15 % en el IRPF de Bizkaia, Gobierno Vasco y Surbisa."
  canonical="https://bilbaoreforma.es/blog/subvencion-eficiencia-energetica-bilbao"
  ogType="article"
  ogImage="https://bilbaoreforma.es/images/og/bilbao-og.jpg"
  ogImageAlt="Ayudas para Eficiencia Energética en Bilbao 2026"
  jsonSchemas={jsonSchemas}
>
  <Header city="bilbao" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas-bilbao-2026" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Bilbao</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 11 de noviembre de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Ayudas para Eficiencia Energética en Bilbao 2026
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Qué ayudas reales hay en noviembre de 2026 para aislar, cambiar ventanas o instalar aerotermia en Bilbao: Eguzki Hotz del EVE, la deducción del 15 % del IRPF de Bizkaia, el Gobierno Vasco y Surbisa.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos revisados el 11 de noviembre de 2026</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Hemos contrastado cuantías y plazos con las fuentes oficiales y de prensa que enlazamos al final. Las convocatorias cambian cada año: antes de empezar la obra, confirma las bases en <a href="https://www.surbisa.eus/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Surbisa</a> y en <a href="https://www.euskadi.eus/gobierno-vasco/-/etxe-medidas-financieras-rehabilitacion/" style="color: var(--color-terracota);" target="_blank" rel="noopener">euskadi.eus</a>.</p>
      </div>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Mejorar la eficiencia energética de una vivienda en Bilbao (aislar, cambiar ventanas o pasarse a la aerotermia) tiene en 2026 cuatro vías de ayuda reales: el programa Eguzki Hotz del EVE, las ayudas del Gobierno Vasco, la Línea Verde de Surbisa y la deducción del IRPF de Bizkaia.</p>
      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Ayudas para eficiencia energética en Bilbao, situación a 11 de noviembre de 2026</caption>
          <thead><tr><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Qué cubre</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Cuánto</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Estado</th></tr></thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Eguzki Hotz (EVE)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Aerotermia, geotermia y autoconsumo fotovoltaico</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Aerotermia en vivienda: 500 €/kW, máximo 3.000 €; hasta el 65 % del coste</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Abierta desde el 5 de noviembre de 2026 hasta el 29 de septiembre de 2028 o fin de fondos (80 M€)</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Deducción IRPF Bizkaia</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Mejora de eficiencia energética y renovables en la vivienda</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">15 % con base máxima de 20.000 € al año</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Vigente de 2025 a 2035</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Gobierno Vasco</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Envolvente, ventanas, instalaciones en vivienda y edificio</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Según ingresos y tipo de obra</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Solicitud ante el Gobierno Vasco</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Línea Verde (Surbisa)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Eficiencia y renovables en edificios de Bilbao</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">350.000 € en total</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Cerrada el 30 de septiembre de 2026; próxima en 2027</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Bonificación ICIO Bilbao</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Obras que llevan a etiqueta A o B o instalan renovables</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">90 % del impuesto (5 %)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Pedir en el mes siguiente a la licencia</td></tr>
          </tbody>
        </table>
      </div>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Eguzki Hotz: la ayuda para pasarse a la aerotermia</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Ente Vasco de la Energía (EVE) abrió el 5 de noviembre de 2026 el programa Eguzki Hotz, con 80 millones de euros, para electrificar la calefacción con renovables y para el autoconsumo. Para un particular, la aerotermia recibe 500 € por kW instalado con un máximo de 3.000 € por vivienda, y la ayuda no puede superar el 65 % del coste. Se concede por orden de llegada hasta agotar fondos. Las calderas de gas no están entre las instalaciones subvencionables.</p>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Deducción del 15 % en el IRPF de Bizkaia</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">desde 2025 hay una deducción del 15 % por obras de mejora de la eficiencia energética e integración de renovables en la vivienda, con una base máxima de 20.000 € al año (Norma Foral 2/2025, vigente de 2025 a 2035). Las deducciones estatales del 20 %, 40 % y 60 % no se aplican a quien tributa en Hacienda Foral de Bizkaia. Se aplica en la vivienda habitual y también en una vivienda alquilada como residencia permanente. Guarda facturas y pagos por banco.</p>
      <CalcCta href="/calculadora/integral-bilbao" title="¿Cuánto costaría tu obra antes de pedir la ayuda?" text="Para casi todas las ayudas necesitas un presupuesto. Calcula un precio orientativo en 1 minuto." dataCta="blog-mid-calculadora" />
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Ayudas del Gobierno Vasco y de Surbisa</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Gobierno Vasco subvenciona mejoras de eficiencia en viviendas (obras particulares) y en edificios (obras comunitarias y de rehabilitación integral y eficiente), con un porcentaje que depende de los ingresos y del tipo de obra. En Bilbao, la Línea Verde de Surbisa cubre eficiencia y renovables en edificios, pero el plazo de 2026 terminó el 30 de septiembre.</p>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Lo que ya no está disponible</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Next Generation:</strong> en Euskadi no se admiten solicitudes nuevas de los programas de rehabilitación energética (3, 4 y 5) desde junio de 2023, y las obras ya concedidas debían terminar antes del 30 de junio de 2026. Para obras nuevas, no cuentes con estos fondos.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Plan Estatal de Vivienda 2026-2030:</strong> no se aplica en el País Vasco, que tiene sus propios programas.</li>
      </ul>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Fuentes consultadas</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-gris); font-size: 0.875rem;">
        <li style="margin-bottom: 0.4rem;"><a href="https://www.euskadi.eus/ayuda_subvencion/2026/eguzki-hotz-programa-de-ayudas-a-la-generacion-electrica-para-autoconsumo-y-la-electrificacion-de-los-consumos-termicos-mediante-energias-renovables/web01-tramite/es/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Gobierno Vasco / EVE: programa Eguzki Hotz 2026</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.ekosum.com/eguzki-hotz-ayudas-climatizacion-placas-solares/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Ekosum: importes de Eguzki Hotz para aerotermia</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.radionervion.com/2026/03/04/bilbao-activa-las-ayudas-a-la-rehabilitacion-hasta-35-millones-para-ascensores-eficiencia-energetica-y-mejoras-en-barrios/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Radio Nervión (4 mar 2026): ayudas de rehabilitación de Bilbao 2026</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.cafbizkaia.com/noticias-administradores-fincas-bizkaia/subvenciones-2026-para-edificios-residenciales-en-bilbao-accesibilidad-energia-rehabilitacion-y-estructura/" style="color: var(--color-terracota);" target="_blank" rel="noopener">CAF Bizkaia: líneas y plazos 2026 de las ayudas de Surbisa</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.euskadi.eus/gobierno-vasco/-/etxe-medidas-financieras-rehabilitacion/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Gobierno Vasco: medidas financieras para rehabilitación, accesibilidad y eficiencia energética</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.euskadi.eus/servicios/1211802/web01-tramite/es/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Gobierno Vasco: estado de los programas Next Generation</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://normatia.com/es/normativa/impuesto-construcciones-bilbao/2023/v-cuota-tributaria-y-bonificaciones/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Ordenanza del ICIO de Bilbao: tipo y bonificaciones</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.bizkaia.eus/es/renta-bizkaia/deducciones" style="color: var(--color-terracota);" target="_blank" rel="noopener">Diputación Foral de Bizkaia: deducciones del IRPF</a></li>
      </ul>


      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem; transition: all 0.2s;">
          <a href="/blog/subvenciones-cambio-ventanas-bizkaia" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-reformas-bilbao-2026" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
      </div>

    </article>
  </main>
  <MunicipiosLinks />

  <Footer city="bilbao" />
</BaseLayout>
