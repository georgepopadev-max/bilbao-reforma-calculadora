---
/**
 * subvencion-cambio-calderas-vitoria — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Cuánto dinero puede suponer el Plan Renove Calderas de Álava?', a: 'El Plan Renove Calderas de Álava puede ofrecer ayudas de hasta 3.000€ para sistemas de aerotermia de alta potencia. Las calderas de condensación suelen recibir ayudas de entre 500€ y 2.000€.' },
  { q: '¿Aerotermia o caldera de condensación, cuál me conviene más?', a: 'La aerotermia tiene un mayor rendimiento (hasta un 400% más eficiente que la electricidad directa) y es la opción más recomendable si quieres maximizar el ahorro a largo plazo. La caldera de condensación es más económica de instalar y es una buena opción si ya tienes gas natural. Ambas opciones son elegibles para las ayudas.' },
  { q: '¿Se puede instalar aerotermia en cualquier tipo de vivienda?', a: 'Sí, la aerotermia se puede instalar en cualquier tipo de vivienda. Solo necesitas espacio para la unidad exterior (como un splits de aire acondicionado) y conexión a la red eléctrica. El sistema de distribución de calor puede funcionar con radiadores de baja temperatura, suelo radiante o fan coil.' },
  { q: '¿Las ayudas del Plan Renove Calderas son por orden de llegada?', a: 'Algunas convocatorias del Plan Renove Calderas funcionan por orden de presentación de solicitudes hasta agotar el presupuesto. Por eso es importante presentar la solicitud cuanto antes una vez abierta la convocatoria.' },
  { q: '¿El Ayuntamiento de Vitoria ofrece bonificaciones adicionales?', a: 'Sí, las instalaciones de energía renovable (como la aerotermia) pueden optar a bonificaciones del IBI del Ayuntamiento de Vitoria. Consulta los requisitos y el procedimiento en la web del Ayuntamiento de Vitoria-Gasteiz.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.bilbaoreforma.es/blog/' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://www.bilbaoreforma.es/blog/subvenciones-reformas/' },
    { '@type': 'ListItem', position: 4, name: 'Vitoria', item: 'https://www.bilbaoreforma.es/blog/subvencion-cambio-calderas-vitoria/' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Subvención Cambio Calderas Vitoria 2026: Ayudas hasta 3.000€',
  description: 'Ayudas cambio calderas Vitoria 2026: Plan Renove Álava y cambio a aerotermia. Cuantías de hasta 3.000€ por potencia.',
  datePublished: '2026-06-28',
  dateModified: '2026-06-28',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Subvención Calderas Vitoria 2026"
  description="Ayudas cambio calderas Vitoria 2026: Plan Renove Álava y cambio a aerotermia. Cuantías de hasta 3.000€ por potencia. Requisitos y solicitud."
  canonical="https://www.bilbaoreforma.es/blog/subvencion-cambio-calderas-vitoria/"
  ogType="article"
  ogImage="https://www.bilbaoreforma.es/images/og/vitoria-og.jpg"
  ogImageAlt="Subvención Cambio Calderas Vitoria 2026"
  jsonSchemas={jsonSchemas}
>
  <Header city="vitoria" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/index.html" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog/index.html" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas/" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Vitoria</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 28 de junio de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Subvención Cambio Calderas Vitoria 2026: Ayudas hasta 3.000€
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Sustituir tu caldera antigua por un sistema de aerotermia o caldera de condensación en Vitoria puede costarte mucho menos de lo que crees. El Plan Renove Calderas de Álava ofrece ayudas de hasta 3.000€ para estos cambios, y la inversión se amortiza en pocos años gracias al ahorro energético.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos orientativos</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Las cuantías y requisitos que detallamos se basan en información pública de 2024-2025. Las convocatorias de 2026 pueden variar. Consulta siempre las bases oficiales en la web de la Diputación Foral de Álava antes de iniciar cualquier trámite.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cuantía de la ayuda para cambio de calderas en Vitoria</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Plan Renove Calderas de Álava y otras líneas de ayuda contemplan cuantías que varían según la potencia de la instalación y el tipo de equipo elegido. Estas son las cuantías orientativas para 2025-2026:</p>

      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Cuantías orientativas para ayudas de cambio de calderas en Vitoria (datos 2024-2025)</caption>
          <thead>
            <tr>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Tipo de equipo</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Potencia</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda orientativa</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Aerotermia (bomba de calor)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Hasta 12 kW</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 2.000 - 3.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Aerotermia (bomba de calor)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">12-20 kW</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 2.500 - 4.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Caldera de condensación gas</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Standard</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">500 - 1.500 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Caldera de condensación gas</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Alta eficiencia</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">800 - 2.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Sistema solar térmico</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">4-8 m²</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">600 - 1.500 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem;">Biomasa (pellets)</td><td style="padding: 0.75rem 1rem;">Standard</td><td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.000 - 2.500 €</td></tr>
          </tbody>
        </table>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Requisitos para solicitar la ayuda</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Ser propietario o inquilino de una vivienda situada en Vitoria o Álava.</li>
        <li style="margin-bottom: 0.5rem;">La vivienda debe ser la residencia habitual del solicitante.</li>
        <li style="margin-bottom: 5%;">El equipo instalado debe cumplir con las especificaciones técnicas exigidas por la convocatoria (rendimiento mínimo, etiqueta energética, etc.).</li>
        <li style="margin-bottom: 0.5rem;">La empresa instaladora debe estar dada de alta y tener capacidad para emitir el certificado de instalación.</li>
        <li style="margin-bottom: 0.5rem;">El equipo antiguo debe ser una caldera antigua (generalmente de más de 15 años) o una caldera no de condensación.</li>
        <li style="margin-bottom: 0;">No tener deudas pendientes con la Administración Pública.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Documentación necesaria</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">DNI o NIE del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Escritura de propiedad o contrato de alquiler vigente.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de empadronamiento que acredite la residencia habitual.</li>
        <li style="margin-bottom: 0.5rem;">Factura de la empresa instaladora con los datos del equipo nuevo.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de instalación del equipo nuevo emitido por la empresa instaladora.</li>
        <li style="margin-bottom: 0.5rem;">Fotografía del equipo antiguo (si es posible) y del equipo nuevo instalado.</li>
        <li style="margin-bottom: 0;">Documento que acredite la retirada del equipo antiguo (si aplica).</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Plazos y convocatoria 2026</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Plan Renove Calderas Álava:</strong> Convocatoria suele abrir en enero-febrero de cada año, con presupuesto limitado.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Programa eficiencia energética Álava:</strong> Previsto para primavera de 2026.</li>
        <li style="margin-bottom: 0;"><strong>Plazo de ejecución:</strong> Habitualmente 6-12 meses desde la resolución favorable.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cómo solicitarla paso a paso</h2>
      <ol style="margin: 1.5rem 0; padding-left: 1.5rem; color: var(--color-grafito); list-style: none; counter-reset: step;">
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem; counter-increment: step;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">1</span><strong>Consulta la convocatoria:</strong> Accede a la web de la Diputación Foral de Álava para conocer las bases exactas y el presupuesto disponible.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">2</span><strong>Recibe presupuestos:</strong> Pide al menos 2-3 presupuestos a empresas instaladoras autorizadas que incluyan marca, modelo y especificaciones técnicas del equipo.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">3</span><strong>Presenta la solicitud:</strong> Rellena el formulario a través de la sede electrónica de la Deputación Foral de Álava dentro del plazo. Algunas convocatorias funcionan por orden de llegada hasta agotar presupuesto.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">4</span><strong>Espera la resolución:</strong> El plazo de resolución suele ser de 1-2 meses.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">5</span><strong>Instala el equipo:</strong> Una vez presentada la solicitud (y preferiblemente una vez concedida), ejecuta la instalación con la empresa elegida.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 0;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">6</span><strong>Justifica y cobra:</strong> Presenta facturas, certificado de instalación y fotografías para recibir el pago de la ayuda.</li>
      </ol>

      <div style="background: linear-gradient(135deg, #F6FBF0 0%, #E8F0E4 100%); border: 1px solid #C4D8B0; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: var(--color-verde-montana); margin-top: 0; font-size: 1rem; font-family: var(--font-playfair); margin-bottom: 0.5rem;">Compatibilidad con otras ayudas</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">La deducción del IRPF por obras de mejora de eficiencia energética es <strong>compatible</strong> con el Plan Renove Calderas de Álava. Consulta también las bonificaciones del IBI del Ayuntamiento de Vitoria para instalaciones de energía renovable.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem; transition: all 0.2s;">
          <a href="/blog/subvencion-cambio-ventanas-bilbao/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-reformas-bilbao-2026/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
      </div>

    </article>
  </main>

  <Footer city="vitoria" />
</BaseLayout>
