---
/**
 * subvention-fachadas-bilbao — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MunicipiosLinks from '../../../components/MunicipiosLinks.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Qué ayudas hay para rehabilitar una fachada en Bilbao en 2026?', a: 'Las ayudas de Surbisa (Ayuntamiento de Bilbao), sobre todo en sus zonas preferentes y en la Línea Verde de eficiencia energética; las ayudas del Gobierno Vasco para elementos comunes; la bonificación del 90 % del ICIO para restaurar fachadas y cubiertas, y la deducción del 15 % del IRPF de Bizkaia si la obra mejora la eficiencia energética.' },
  { q: '¿Sigue abierta la Línea Verde de Bilbao?', a: 'No. La Línea Verde de 2026, con 350.000 euros para eficiencia energética y renovables, cerró el 30 de septiembre de 2026. La siguiente convocatoria suele publicarse a principios de año.' },
  { q: '¿Puedo pedir ayudas Next Generation para la fachada?', a: 'No para obras nuevas. En Euskadi no se admiten solicitudes nuevas de los programas de rehabilitación energética desde junio de 2023, y las obras concedidas tenían que terminar antes del 30 de junio de 2026.' },
  { q: '¿Cuánto se ahorra en el ICIO?', a: 'El ICIO de Bilbao es del 5 % del presupuesto de la obra. Restaurar íntegramente fachadas y cubiertas tiene una bonificación del 90 % si se pide en el mes siguiente a la licencia.' },
  { q: '¿Es obligatoria la ITE?', a: 'Sí, para edificios de más de 50 años. Además, el Gobierno Vasco solo subvenciona en esos edificios las obras que recoge la ITE.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bilbaoreforma.es/blog' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://bilbaoreforma.es/blog/subvenciones-reformas' },
    { '@type': 'ListItem', position: 4, name: 'Bilbao', item: 'https://bilbaoreforma.es/blog/subvencion-fachadas-bilbao' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Subvenciones para Fachadas en Bilbao 2026: Qué Hay Abierto',
  description: 'Ayudas para rehabilitar la fachada en Bilbao en 2026: líneas y plazos de Surbisa, Gobierno Vasco, bonificación del 90 % del ICIO y deducción del 15 % del IRPF.',
  datePublished: '2026-06-28',
  dateModified: '2026-11-11',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Subvenciones Fachadas Bilbao 2026: Surbisa, ICIO e IRPF"
  description="Ayudas para rehabilitar la fachada en Bilbao en 2026: líneas y plazos de Surbisa, Gobierno Vasco, bonificación del 90 % del ICIO y deducción del 15 % del IRPF."
  canonical="https://bilbaoreforma.es/blog/subvencion-fachadas-bilbao"
  ogType="article"
  ogImage="https://bilbaoreforma.es/images/og/bilbao-og.jpg"
  ogImageAlt="Subvenciones para Fachadas en Bilbao 2026: Qué Hay Abierto"
  jsonSchemas={jsonSchemas}
>
  <Header city="bilbao" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas-bilbao-2026" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Bilbao</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 11 de noviembre de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Subvenciones para Fachadas en Bilbao 2026: Qué Hay Abierto
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Repasamos las ayudas reales para rehabilitar una fachada en Bilbao en 2026: las líneas de Surbisa con sus plazos, las del Gobierno Vasco, la bonificación del ICIO y la deducción del IRPF de Bizkaia. Datos revisados el 11 de noviembre de 2026.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos revisados el 11 de noviembre de 2026</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Hemos contrastado cuantías y plazos con las fuentes oficiales y de prensa que enlazamos al final. Las convocatorias cambian cada año: antes de empezar la obra, confirma las bases en <a href="https://www.surbisa.eus/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Surbisa</a> y en <a href="https://www.euskadi.eus/gobierno-vasco/-/etxe-medidas-financieras-rehabilitacion/" style="color: var(--color-terracota);" target="_blank" rel="noopener">euskadi.eus</a>.</p>
      </div>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">En Bilbao, rehabilitar una fachada puede tener tres tipos de ayuda a la vez: las de la comunidad autónoma (Gobierno Vasco), las del Ayuntamiento a través de Surbisa y la bonificación del impuesto de obras (ICIO). A eso se suma, para cada propietario, la deducción del IRPF de Bizkaia si la obra mejora el aislamiento.</p>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Ayudas del Ayuntamiento de Bilbao (Surbisa) en 2026</h2>
      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Ayudas de Surbisa y el Ayuntamiento de Bilbao en 2026 (presupuesto total: 3,54 millones de euros)</caption>
          <thead><tr><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Línea</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Para qué</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Presupuesto</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Plazo 2026</th></tr></thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Ascensores y eliminación de barreras</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Ascensores, accesos al portal y elementos comunes</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">unos 800.000 €</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Hasta el 13 de noviembre de 2026</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Línea Verde</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Eficiencia energética, renovables y naturalización</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">350.000 €</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Cerrada el 30 de septiembre de 2026</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Reparaciones estructurales</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Estructura, termitas y daños urgentes</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">160.000 €</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Cerrada el 30 de septiembre de 2026</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Zonas preferentes de Surbisa</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Rehabilitación integral, accesibilidad y eficiencia en viviendas y elementos comunes</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">1.920.000 €</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Abierta mientras haya presupuesto</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Accesibilidad en viviendas de personas mayores</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Adaptación de la vivienda</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">300.000 €</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Consultar en Surbisa</td></tr>
          </tbody>
        </table>
      </div>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Las zonas preferentes de Surbisa en 2026 son Uretamendi-Betolaza, Uribarri, Casco Viejo, Barrio de la Cruz, Bilbao La Vieja, Barrio Ferroviarios, Irala, Zazpilanda e Iturrigorri-Peñascal (nueva este año). En estas zonas la ayuda se concede antes de empezar la obra; en el resto de Bilbao se paga cuando la obra está terminada.</p>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Para una fachada, las líneas útiles son la de zonas preferentes (si el edificio está en una de ellas) y la Línea Verde cuando la obra incluye aislamiento. La Línea Verde ya cerró el plazo de 2026, así que una obra que empiece ahora tendrá que esperar a la convocatoria de 2027, que suele publicarse en el Boletín Oficial de Bizkaia a principios de año.</p>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Ayudas del Gobierno Vasco</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Gobierno Vasco subvenciona obras en elementos comunes de edificios (fachadas, cubiertas, accesibilidad y eficiencia energética) dentro de sus medidas financieras para rehabilitación. Distingue entre obras comunitarias y obras comunitarias de rehabilitación integral y eficiente, y el porcentaje depende del tipo de obra y de los ingresos de cada hogar. También hay préstamos para comunidades. Las ayudas de Surbisa son compatibles con estas y se pueden tramitar en la ventanilla única de Surbisa.</p>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">El edificio debe tener más de 10 años, salvo en obras de accesibilidad.</li>
        <li style="margin-bottom: 0.5rem;">En edificios de más de 50 años, solo se subvencionan las obras que recoja la ITE, y la ITE debe estar presentada.</li>
        <li style="margin-bottom: 0.5rem;">Las líneas de obras comunitarias y de rehabilitación integral no se pueden combinar entre sí para la misma obra.</li>
      </ul>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Bonificación del ICIO y deducción del IRPF</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>ICIO de Bilbao:</strong> el impuesto de obras es del 5 %, con bonificaciones del 90 % para limpieza, pintura o restauración integral de fachadas y cubiertas, del 90 % para obras que lleven el edificio a etiqueta energética A o B o instalen renovables, y del 65 % para obras de accesibilidad. Se piden en el plazo de un mes desde la licencia o comunicación previa y no se acumulan.</li>
        <li style="margin-bottom: 0.5rem;"><strong>IRPF en Bizkaia:</strong> desde 2025 hay una deducción del 15 % por obras de mejora de la eficiencia energética e integración de renovables en la vivienda, con una base máxima de 20.000 € al año (Norma Foral 2/2025, vigente de 2025 a 2035). Las deducciones estatales del 20 %, 40 % y 60 % no se aplican a quien tributa en Hacienda Foral de Bizkaia.</li>
      </ul>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Lo que ya no está disponible</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Next Generation:</strong> en Euskadi no se admiten solicitudes nuevas de los programas de rehabilitación energética (3, 4 y 5) desde junio de 2023, y las obras ya concedidas debían terminar antes del 30 de junio de 2026. Para obras nuevas, no cuentes con estos fondos.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Plan Estatal de Vivienda 2026-2030:</strong> no se aplica en el País Vasco, que tiene sus propios programas.</li>
      </ul>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cómo pedirlas sin perderlas</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Ten la ITE al día: es la base de casi todas las ayudas de fachada.</li>
        <li style="margin-bottom: 0.5rem;">Aprueba la obra en junta y pide al menos 3 presupuestos comparables.</li>
        <li style="margin-bottom: 0.5rem;">En zonas preferentes de Surbisa, pide la ayuda antes de empezar; en el resto de Bilbao se cobra al terminar, pero la solicitud tiene que estar dentro de plazo.</li>
        <li style="margin-bottom: 0.5rem;">Pide la bonificación del ICIO en el mes siguiente a la licencia.</li>
        <li style="margin-bottom: 0.5rem;">Guarda facturas y pagos por banco: los necesitarás para la ayuda y para la deducción del IRPF.</li>
      </ul>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Fuentes consultadas</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-gris); font-size: 0.875rem;">
        <li style="margin-bottom: 0.4rem;"><a href="https://www.radionervion.com/2026/03/04/bilbao-activa-las-ayudas-a-la-rehabilitacion-hasta-35-millones-para-ascensores-eficiencia-energetica-y-mejoras-en-barrios/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Radio Nervión (4 mar 2026): ayudas de rehabilitación de Bilbao 2026</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.cafbizkaia.com/noticias-administradores-fincas-bizkaia/subvenciones-2026-para-edificios-residenciales-en-bilbao-accesibilidad-energia-rehabilitacion-y-estructura/" style="color: var(--color-terracota);" target="_blank" rel="noopener">CAF Bizkaia: líneas y plazos 2026 de las ayudas de Surbisa</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.euskadi.eus/gobierno-vasco/-/etxe-medidas-financieras-rehabilitacion/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Gobierno Vasco: medidas financieras para rehabilitación, accesibilidad y eficiencia energética</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.euskadi.eus/servicios/1211802/web01-tramite/es/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Gobierno Vasco: estado de los programas Next Generation</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://normatia.com/es/normativa/impuesto-construcciones-bilbao/2023/v-cuota-tributaria-y-bonificaciones/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Ordenanza del ICIO de Bilbao: tipo y bonificaciones</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.bizkaia.eus/es/renta-bizkaia/deducciones" style="color: var(--color-terracota);" target="_blank" rel="noopener">Diputación Foral de Bizkaia: deducciones del IRPF</a></li>
      </ul>


      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem; transition: all 0.2s;">
          <a href="/blog/subvenciones-cambio-ventanas-bizkaia" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/pintar-fachada-bilbao" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Pintar fachada en Bilbao: precio por m²</a>
        </div>
      </div>

    </article>
  </main>
  <MunicipiosLinks />

  <Footer city="bilbao" />
</BaseLayout>
