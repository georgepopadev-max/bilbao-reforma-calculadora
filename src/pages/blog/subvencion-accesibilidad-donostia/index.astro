---
/**
 * subvention-accesibilidad-donostia — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import CalcCta from '../../../components/CalcCta.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Cuánto paga Donostia por instalar un ascensor?', a: 'El 20 % del gasto subvencionable sin IVA, con un máximo de 20.000 euros, y un 10 % más (hasta 10.000 euros) en zonas de rehabilitación preferente.' },
  { q: '¿Y por adaptar la vivienda de una persona mayor?', a: 'El 20 % del gasto, con un máximo de 6.000 euros, para personas con movilidad reducida o mayores de 65 años, con ingresos del hogar inferiores a 35.000 euros.' },
  { q: '¿Está abierta la convocatoria?', a: 'En la revisión del 11 de noviembre de 2026, la web municipal indica que no hay convocatorias abiertas. Consulta Donostiako Etxegintza para la próxima.' },
  { q: '¿Puedo empezar la obra antes de pedir la ayuda?', a: 'No. Las bases municipales exigen que la obra no empiece antes de la concesión provisional.' },
  { q: '¿Hay ayudas del Gobierno Vasco?', a: 'Sí, para obras de accesibilidad en viviendas y elementos comunes, con una línea especial para mayores de 65 o personas con discapacidad con ingresos ponderados de hasta 12.000 euros.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bilbaoreforma.es/blog' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://bilbaoreforma.es/blog/subvenciones-reformas' },
    { '@type': 'ListItem', position: 4, name: 'Donostia', item: 'https://bilbaoreforma.es/blog/subvencion-accesibilidad-donostia' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Ayudas de Accesibilidad en Donostia 2026: Cuantías Reales',
  description: 'Ayudas de accesibilidad en Donostia: hasta 20.000 € para ascensores y 6.000 € para adaptar la vivienda (Etxegintza), más las del Gobierno Vasco. Requisitos.',
  datePublished: '2026-06-28',
  dateModified: '2026-11-11',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Ayudas Accesibilidad Donostia 2026: Cuantías y Requisitos"
  description="Ayudas de accesibilidad en Donostia: hasta 20.000 € para ascensores y 6.000 € para adaptar la vivienda (Etxegintza), más las del Gobierno Vasco. Requisitos."
  canonical="https://bilbaoreforma.es/blog/subvencion-accesibilidad-donostia"
  ogType="article"
  ogImage="https://bilbaoreforma.es/images/og/donostia-og.jpg"
  ogImageAlt="Ayudas de Accesibilidad en Donostia 2026: Cuantías Reales"
  jsonSchemas={jsonSchemas}
>
  <Header city="donostia" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas-bilbao-2026" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Donostia</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 11 de noviembre de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Ayudas de Accesibilidad en Donostia 2026: Cuantías Reales
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Cuánto paga el Ayuntamiento de Donostia por instalar un ascensor o adaptar una vivienda, qué ayuda el Gobierno Vasco y qué requisitos hay. Datos revisados el 11 de noviembre de 2026.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos revisados el 11 de noviembre de 2026</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Hemos contrastado cuantías y plazos con las fuentes oficiales que enlazamos al final. Las convocatorias cambian cada año: antes de empezar la obra, confirma las bases en <a href="https://www.donostia.eus/es/servicios/ayudas-municipales" style="color: var(--color-terracota);" target="_blank" rel="noopener">donostia.eus</a> y en <a href="https://www.euskadi.eus/gobierno-vasco/-/etxe-medidas-financieras-rehabilitacion/" style="color: var(--color-terracota);" target="_blank" rel="noopener">euskadi.eus</a>.</p>
      </div>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">En Donostia, las obras de accesibilidad pueden tener ayuda del Ayuntamiento, a través de Etxegintza, y del Gobierno Vasco. Estas son las cuantías reales de las bases municipales y lo que hay que tener en cuenta en 2026.</p>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Ayudas del Ayuntamiento de Donostia</h2>
      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Ayudas municipales de Donostia para rehabilitación y accesibilidad (bases municipales vigentes)</caption>
          <thead><tr><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Obra</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda</th><th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Máximo</th></tr></thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Accesibilidad en elementos comunes (ascensores, rampas, plataformas)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">20 % del gasto subvencionable sin IVA</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">20.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Obras exigidas por la ITE en elementos comunes</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">20 %</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">10.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Complemento en zonas de rehabilitación preferente</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">+10 %</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">10.000 € (total 30 %, máx. 30.000 €)</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">Adaptación de la vivienda para movilidad reducida o mayores de 65</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">20 %</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top; background: var(--color-crema);">6.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">Eficiencia energética y aislamiento acústico en la vivienda</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">20 %</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); vertical-align: top;">2.000 €</td></tr>
          </tbody>
        </table>
      </div>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Gestiona Donostiako Etxegintza (calle San Marcial, 2; 943 481 765).</li>
        <li style="margin-bottom: 0.5rem;">En el momento de la revisión, la web municipal indica que <strong>no hay convocatorias abiertas</strong>. Conviene preparar la documentación para la próxima.</li>
        <li style="margin-bottom: 0.5rem;">Para obras en la vivienda, ingresos ponderados del hogar inferiores a 35.000 euros.</li>
        <li style="margin-bottom: 0.5rem;">Edificio de más de 10 años (con excepciones), con al menos 2/3 de uso residencial y 3 viviendas.</li>
        <li style="margin-bottom: 0.5rem;">Licencia concedida (o exención acreditada) antes de pedir la ayuda, y la obra no puede empezar antes de la concesión provisional.</li>
        <li style="margin-bottom: 0.5rem;">En obras comunitarias hay que presentar la ITE.</li>
      </ul>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Ayudas del Gobierno Vasco</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Gobierno Vasco subvenciona obras de rehabilitación, accesibilidad y eficiencia energética en viviendas y en elementos comunes de edificios. El porcentaje depende del tipo de obra y de los ingresos del hogar, y hay una línea especial de accesibilidad para mayores de 65 años o personas con discapacidad con ingresos ponderados de hasta 12.000 euros. El edificio debe tener más de 10 años (salvo obras de accesibilidad) y, si tiene más de 50, solo se subvencionan las obras que recoja la ITE.</p>
      <CalcCta href="/donostia/calculadora/bano-donostia" title="¿Vas a adaptar el baño? Calcula cuánto costaría" text="Cambiar la bañera por un plato de ducha es la obra de accesibilidad más habitual. Calcula el precio en 1 minuto antes de pedir la ayuda." dataCta="blog-mid-calculadora" />
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">IRPF</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Gipuzkoa tiene su propia normativa del IRPF, distinta de la estatal: las deducciones de la Agencia Tributaria no se aplican. Consulta en <a href="https://www.gipuzkoa.eus/es/web/ogasuna" style="color: var(--color-terracota);" target="_blank" rel="noopener">Hacienda Foral de Gipuzkoa</a> qué beneficios hay para tu caso.</p>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Lo que ya no está disponible</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Next Generation:</strong> en Euskadi no se admiten solicitudes nuevas de los programas de rehabilitación energética (3, 4 y 5) desde junio de 2023, y las obras ya concedidas debían terminar antes del 30 de junio de 2026.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Plan Estatal de Vivienda 2026-2030:</strong> no se aplica en el País Vasco, que tiene sus propios programas.</li>
      </ul>
      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Fuentes consultadas</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-gris); font-size: 0.875rem;">
        <li style="margin-bottom: 0.4rem;"><a href="https://www.donostia.eus/es/servicios/ayudas-municipales" style="color: var(--color-terracota);" target="_blank" rel="noopener">Ayuntamiento de Donostia: ayudas municipales para accesibilidad y rehabilitación</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.euskadi.eus/gobierno-vasco/-/etxe-medidas-financieras-rehabilitacion/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Gobierno Vasco: medidas financieras para rehabilitación, accesibilidad y eficiencia energética</a></li>
        <li style="margin-bottom: 0.4rem;"><a href="https://www.euskadi.eus/servicios/1211802/web01-tramite/es/" style="color: var(--color-terracota);" target="_blank" rel="noopener">Gobierno Vasco: estado de los programas Next Generation</a></li>
      </ul>


      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-cambio-ventanas-bizkaia" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-reformas-bilbao-2026" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
      </div>

    </article>
  </main>

  <Footer city="donostia" />
</BaseLayout>
