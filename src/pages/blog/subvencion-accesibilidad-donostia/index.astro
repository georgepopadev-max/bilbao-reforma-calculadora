---
/**
 * subvention-accesibilidad-donostia — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Cuánto dinero puede dar la ayuda para salvaescaleras en Donostia?', a: 'Las ayudas para salvaescaleras y plataformas elevadoras pueden alcanzar entre 4.000€ y 8.000€ por vivienda, dependiendo de la convocatoria y los ingresos del solicitante. Las adaptaciones de baño oscilan entre 1.500€ y 3.000€.' },
  { q: '¿Qué obras son elegibles para las ayudas de accesibilidad?', a: 'Son elegibles la instalación de salvaescaleras y plataformas elevadoras, la adaptación de baños con ducha accesible, la instalación de barandillas y rampas de acceso, y las puertas automáticas de entrada.' },
  { q: '¿Un inquilino puede solicitar estas ayudas?', a: 'Sí, los inquilinos pueden solicitar estas ayudas con el consentimiento escrito del propietario y siempre que la obra revierta en beneficio de la vivienda y del propio inquilino.' },
  { q: '¿Qué documentación necesito para pedir la ayuda?', a: 'Necesitas el DNI o NIE, certificado de empadronamiento, escritura o contrato de alquiler, certificado de discapacidad (igual o superior al 33%) o informe médico, informe de servicios sociales y al menos 2-3 presupuestos de empresas especializadas.' },
  { q: '¿Se puede combinar esta ayuda con la deducción de IRPF?', a: 'Sí, la deducción del IRPF por obras de accesibilidad es compatible con las ayudas públicas de la Deputación de Gipuzkoa y del Ayuntamiento de Donostia. Puedes recibir la ayuda pública y además deducirte un porcentaje en tu declaración de la renta.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.bilbaoreforma.es/blog/' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://www.bilbaoreforma.es/blog/subvenciones-reformas/' },
    { '@type': 'ListItem', position: 4, name: 'Donostia', item: 'https://www.bilbaoreforma.es/blog/subvencion-accesibilidad-donostia/' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Subvención Accesibilidad Donostia 2026: Ayudas hasta 8.000€',
  description: 'Ayudas accesibilidad Donostia 2026: salvaescaleras, adaptaciones de baño y ascensores. Cuantías de hasta 8.000€ por vivienda. Requisitos y solicitud.',
  datePublished: '2026-06-28',
  dateModified: '2026-06-28',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Subvención Accesibilidad Donostia 2026"
  description="Ayudas accesibilidad Donostia 2026: salvaescaleras, adaptaciones de baño y ascensores. Cuantías de hasta 8.000€ por vivienda. Requisitos y solicitud."
  canonical="https://www.bilbaoreforma.es/blog/subvencion-accesibilidad-donostia/"
  ogType="article"
  ogImage="https://www.bilbaoreforma.es/images/og/donostia-og.jpg"
  ogImageAlt="Subvención Accesibilidad Donostia 2026"
  jsonSchemas={jsonSchemas}
>
  <Header city="donostia" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/index.html" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog/index.html" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas/" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Donostia</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 28 de junio de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Subvención Accesibilidad Donostia 2026
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        La Deputación de Gipuzkoa y el Ayuntamiento de Donostia-San Sebastián ofrecen ayudas para adaptar viviendas de personas con movilidad reducida o mayores de 65 años. Estas ayudas pueden cubrir buena parte del coste de salvaescaleras, adaptaciones de baño y eliminación de barreras arquitectónicas.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos orientativos</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Las cuantías y requisitos que detallamos se basan en información pública de 2024-2025. Las convocatorias de 2026 pueden variar. Consulta siempre las bases oficiales en la web de la Deputación de Gipuzkoa (www.gipuzkoa.eus) y del Ayuntamiento de Donostia (www.donostia.eus) antes de iniciar cualquier trámite.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cuantía de la ayuda para accesibilidad en Donostia</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Las ayudas de accesibilidad en Donostia y Gipuzkoa contemplan cuantías orientativas que varían según el tipo de adaptación y los ingresos del solicitante. Estas son los rangos habituales:</p>

      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Cuantías orientativas para ayudas de accesibilidad en Donostia (datos 2024-2025)</caption>
          <thead>
            <tr>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Tipo de adaptación</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Organismo</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda orientativa</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Salvaescaleras o plataforma elevadora</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Deputación Gipuzkoa / Donostia</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">4.000 - 8.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Adaptación de baño (ducha accesible)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Gipuzkoa / Donostia</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.500 - 3.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Ascensor para comunidad de vecinos</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Plan PREE / Gipuzkoa</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 10.000 € / vivienda</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Rampas y barandillas</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Ayuntamiento Donostia</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">800 - 2.500 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem;">Puertas automáticas</td><td style="padding: 0.75rem 1rem;">Ayuntamiento Donostia</td><td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">800 - 2.000 €</td></tr>
          </tbody>
        </table>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Requisitos para solicitar la ayuda</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Ser propietario o inquilino de una vivienda en Donostia o Gipuzkoa.</li>
        <li style="margin-bottom: 0.5rem;">Tener más de 65 años o poseer certificado de discapacidad (igual o superior al 33%) o dependencia.</li>
        <li style="margin-bottom: 0.5rem;">La vivienda debe ser la residencia habitual del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Las obras deben ser ejecutadas por empresas especializadas con alta fiscal vigente.</li>
        <li style="margin-bottom: 0.5rem;">Es necesario un informe de servicios sociales o técnico que acredite la necesidad de la adaptación.</li>
        <li style="margin-bottom: 0;">No tener deudas pendientes con la Administración Pública.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Documentación necesaria</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">DNI o NIE del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Escritura de propiedad o contrato de alquiler (con consentimiento del propietario si es inquilino).</li>
        <li style="margin-bottom: 0.5rem;">Certificado de empadronamiento que acredite la residencia habitual.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de discapacidad (igual o superior al 33%) o informe médico que acredite la movilidad reducida.</li>
        <li style="margin-bottom: 0.5rem;">Informe de servicios sociales municipales (obligatorio en algunas convocatorias).</li>
        <li style="margin-bottom: 0.5rem;">Presupuesto detallado de la empresa instaladora especializada.</li>
        <li style="margin-bottom: 0;">Fotografías del estado actual de la vivienda antes de la obra.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Plazos y convocatoria 2026</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Convocatoria Deputación de Gipuzkoa:</strong> Prevista para febrero-marzo y septiembre de 2026.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Convocatoria Ayuntamiento de Donostia:</strong> Período habitual entre abril y junio de 2026.</li>
        <li style="margin-bottom: 0;"><strong>Plazo de ejecución:</strong> Habitualmente 12 meses desde la resolución favorable.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Zonas de Donostia con mayor necesidad de accesibilidad</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Existen numerosos edificios de vivienda antiga en Donostia que carecen de accesibilidad, especialmente en los barrios de Altza, Intxaurrondo, Gros, Centro y Amara. Estas zonas concentran un parque inmobiliario con más de 40 años de antigüedad donde la instalación de salvaescaleras o ascensores puede mejorar notablemente la calidad de vida de los residentes.</p>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cómo solicitarla paso a paso</h2>
      <ol style="margin: 1.5rem 0; padding-left: 1.5rem; color: var(--color-grafito); list-style: none; counter-reset: step;">
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem; counter-increment: step;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">1</span><strong>Consulta la convocatoria:</strong> Accede a la web de la Deputación de Gipuzkoa (www.gipuzkoa.eus) o del Ayuntamiento de Donostia (www.donostia.eus) para conocer las bases exactas y el presupuesto disponible.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">2</span><strong>Solicita informe de servicios sociales:</strong> En algunos casos es obligatorio un informe de los servicios sociales que acredite la necesidad de la adaptación.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">3</span><strong>Obtén presupuestos:</strong> Pide al menos 2-3 presupuestos a empresas especializadas en instalaciones de accesibilidad con alta fiscal vigente.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">4</span><strong>Presenta la solicitud:</strong> Rellena el formulario en la sede electrónica del organismo convocante, adjuntando toda la documentación requerida.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">5</span><strong>Espera la resolución:</strong> El plazo de resolución suele ser de 2-3 meses desde la presentación de la solicitud.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">6</span><strong>Ejecuta la obra:</strong> Una vez concedida la ayuda, ejecuta la adaptación con la empresa elegida dentro del plazo establecido.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 0;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">7</span><strong>Justifica y cobra:</strong> Presenta facturas y documentación gráfica para justificar el gasto y recibir el pago de la ayuda.</li>
      </ol>

      <div style="background: linear-gradient(135deg, #F6FBF0 0%, #E8F0E4 100%); border: 1px solid #C4D8B0; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: var(--color-verde-montana); margin-top: 0; font-size: 1rem; font-family: var(--font-playfair); margin-bottom: 0.5rem;">Compatibilidad con otras ayudas</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">La deducción del IRPF por obras de accesibilidad es <strong>compatible</strong> con las ayudas públicas de la Deputación de Gipuzkoa y del Ayuntamiento de Donostia. Puedes recibir la ayuda pública y además deducirte un porcentaje en tu declaración de la renta. Consulta también el Plan PREE para ascensores comunitarios.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvencion-cambio-ventanas-bilbao/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-reformas-bilbao-2026/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
      </div>

    </article>
  </main>

  <Footer city="donostia" />
</BaseLayout>
