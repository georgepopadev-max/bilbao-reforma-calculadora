---
/**
 * [slug].astro — Dynamic blog post renderer
 * Renders blog posts from src/content/blog/ collection
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const title = post.data.title || 'Artículo';
const description = post.data.description || '';
const canonical = post.data.canonical;
const date = post.data.date;
const readTime = post.data.readTime;
const category = post.data.category;
const city = post.data.city || 'bilbao';
const faqs = (post.data.faqs && Array.isArray(post.data.faqs)) ? post.data.faqs : [];
const inContentCTAs = (post.data.inContentCTAs && Array.isArray(post.data.inContentCTAs)) ? post.data.inContentCTAs : [];

// Build FAQPage JSON-LD
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a },
  })),
};

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.bilbaoreforma.es/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.bilbaoreforma.es/blog/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonical || `https://www.bilbaoreforma.es/blog/${post.slug}.html` },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage="https://www.bilbaoreforma.es/images/og/blog-og.jpg" ogImageAlt={title}>
  <Fragment slot="head">
    {faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header city={city} section="blog" />

  <main>
    <div style="max-width:860px;margin:0 auto;padding:2rem 1rem">
      <nav style="display:flex;gap:.5rem;font-size:.8125rem;color:#6B6B6B;margin-bottom:1rem;flex-wrap:wrap" aria-label="Breadcrumb">
        <a href="/index.html" style="color:#C45C3E;text-decoration:none">Inicio</a>
        <span>›</span>
        <a href="/blog/" style="color:#C45C3E;text-decoration:none">Blog</a>
        <span>›</span>
        <span>{title}</span>
      </nav>

      <header style="margin-bottom:2rem">
        <div style="display:flex;gap:1rem;font-size:.8125rem;color:#6B6B6B;margin-bottom:1rem;flex-wrap:wrap">
          {date && <span>{date}</span>}
          {readTime && <span>{readTime} de lectura</span>}
          {category && <span style="background:#FAF7F2;padding:.25rem .75rem;border-radius:999px;font-size:.75rem;font-weight:500">{category}</span>}
        </div>
        <h1 style="font-family:'Playfair Display',Georgia,serif;font-size:2rem;font-weight:700;color:#2D2D2D;line-height:1.25;margin-bottom:1rem">{title}</h1>
        {description && <p style="font-size:1.0625rem;color:#6B6B6B;line-height:1.65">{description}</p>}
      </header>

      <article style="background:#FFFFFF;border-radius:12px;padding:2rem;box-shadow:0 2px 8px rgba(45,30,15,.08)">
        <div class="article-content">
          <Content />
        </div>
      </article>

      {faqs.length > 0 && (
        <section style="margin-top:2rem;background:#FAF7F2;border-radius:12px;padding:2rem">
          <h2 style="font-family:'Playfair Display',Georgia,serif;font-size:1.375rem;font-weight:600;color:#2D2D2D;margin-bottom:1.5rem">Preguntas frecuentes</h2>
          <div style="display:flex;flex-direction:column;gap:1.25rem">
            {faqs.map((faq: any) => (
              <div style="border-bottom:1px solid #E8E2D9;padding-bottom:1.25rem">
                <h3 style="font-size:1rem;font-weight:600;color:#2D2D2D;margin-bottom:.625rem">{faq.q}</h3>
                <p style="font-size:.9375rem;color:#6B6B6B;line-height:1.6">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {inContentCTAs.length > 0 && (
        <div style="margin-top:2rem;display:flex;flex-direction:column;gap:1rem">
          {inContentCTAs.map((cta: any) => (
            <a href={cta.href} style="display:block;background:#FAF7F2;border-left:3px solid #C45C3E;padding:1rem 1.25rem;border-radius:0 8px 8px 0;text-decoration:none">
              <span style="display:block;font-size:.75rem;font-weight:600;text-transform:uppercase;color:#C45C3E;margin-bottom:.25rem">
                {cta.type === 'calculator' ? '📊 Herramienta recomendada' : '📖 Leer también'}
              </span>
              <span style="font-size:.9375rem;color:#2D2D2D;font-weight:500">{cta.label}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer city={city} />
</BaseLayout>

<style>
  .article-content {
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.7;
    color: #2D2D2D;
  }
  .article-content :global(h2) {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 600;
    color: #2D2D2D;
    margin: 2rem 0 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid #E8E2D9;
  }
  .article-content :global(h2:first-of-type) { margin-top: 0; padding-top: 0; border-top: none; }
  .article-content :global(h3) { font-size: 1.0625rem; font-weight: 600; color: #4A6741; margin: 1.5rem 0 0.75rem; }
  .article-content :global(p) { margin-bottom: 1rem; }
  .article-content :global(ul), .article-content :global(ol) { margin: 1rem 0 1.5rem 1.5rem; }
  .article-content :global(li) { margin-bottom: 0.5rem; }
  .article-content :global(strong) { font-weight: 600; }
  .article-content :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9375rem; }
  .article-content :global(th) { background: #4A6741; color: #FFFFFF; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem; }
  .article-content :global(td) { padding: 0.75rem 1rem; border-bottom: 1px solid #E8E2D9; }
  .article-content :global(tr:nth-child(even) td) { background: #FAF7F2; }
  .article-content :global(.table-wrap) { overflow-x: auto; margin: 1.5rem 0; }
</style>