---
/**
 * subvention-cambio-ventanas-bilbao — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Cuánto puedo ahorrar en calefacción con ventanas de doble acristalamiento?', a: 'El ahorro depende de las ventanas anteriores y del tipo de ventanas nuevas. Un cambio de ventanas simple puede reducir la factura de calefacción entre un 15% y un 25%. Las ventanas de triple acristalamiento con marco de PVC pueden alcanzar ahorros del 30-40%.' },
  { q: '¿Qué tipo de ventana es mejor para el clima de Bilbao?', a: 'Para el clima de Bilbao, se recomienda doble o triple acristalamiento con gas argón, bajo emisivo y marco de PVC o aluminio con rotura de puente térmico. El grosor del acristalamiento y la calidad del marco son los factores más importantes.' },
  { q: '¿Las ayudas cubren el 100% del coste de las ventanas?', a: 'No, las ayudas cubren un porcentaje de la inversión elegible, generalmente entre el 15% y el 30%. Una vivienda que invierta 2.500€ en ventanas podría recibir entre 375€ y 750€ de ayuda pública, además de la deducción del IRPF.' },
  { q: '¿Hay un mínimo de metros cuadrados para solicitar la ayuda?', a: 'Depende de la convocatoria. Algunas exigen un cambio mínimo de metros cuadrados (suele ser a partir de 4-6 m² de ventana). Otras permiten cambios parciales. Consulta los requisitos específicos de cada programa.' },
  { q: '¿Las ventanas de PVC son elegibles para las ayudas?', a: 'Sí, las ventanas de PVC con rotura de puente térmico y acristalamiento doble o triple son generalmente elegibles, siempre que cumplan con los valores de transmitancia térmica exigidos por la convocatoria.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.bilbaoreforma.es/blog/' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://www.bilbaoreforma.es/blog/subvenciones-reformas/' },
    { '@type': 'ListItem', position: 4, name: 'Bilbao', item: 'https://www.bilbaoreforma.es/blog/subvencion-cambio-ventanas-bilbao/' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Subvención Ventanas Bilbao 2026: Ayudas Eficiencia por m²',
  description: 'Ayudas cambio ventanas Bilbao 2026: doble acristalamiento y carpintería eficiente. Cuantías por m², plazos y requisitos para solicitarlas.',
  datePublished: '2026-06-28',
  dateModified: '2026-06-28',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Subvención Ventanas Bilbao 2026"
  description="Ayudas cambio ventanas Bilbao 2026: doble acristalamiento y carpintería eficiente. Cuantías por m², plazos y requisitos para solicitarlas. Guía completa."
  canonical="https://www.bilbaoreforma.es/blog/subvencion-cambio-ventanas-bilbao/"
  ogType="article"
  ogImage="https://www.bilbaoreforma.es/images/og/bilbao-og.jpg"
  ogImageAlt="Subvención Ventanas Bilbao 2026"
  jsonSchemas={jsonSchemas}
>
  <Header city="bilbao" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/index.html" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog/index.html" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas/" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Bilbao</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 28 de junio de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Subvención Ventanas Bilbao 2026 | Ayudas Eficiencia por m²
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Sustituir las ventanas de tu piso en Bilbao por otras de doble o triple acristalamiento es una de las reformas más rentables que puedes hacer: reduce tu factura energética, mejora el aislamiento acústico y puede optar a ayudas de hasta 3.000€ por vivienda. Te contamos cómo solicitarlas.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El parque inmobiliario de Bilbao está envejecido: la mayoría de los edificios construidos antes de 1980 tienen ventanas de cristal simple o doble acristalamiento deteriorado, lo que provoca pérdidas de energía de hasta el 30% en cada fachada. Cambiar las ventanas es una inversión que se amortiza en pocos años y que mejora notablemente el confort de la vivienda, tanto en invierno como en verano.</p>

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos orientativos</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Las cuantías y requisitos que detallamos se basan en información pública de 2024-2025. Las convocatorias de 2026 pueden variar. Consulta siempre las bases oficiales en Viviendazz (Gobierno Vasco) y en la web de la Diputación Foral de Bizkaia antes de iniciar cualquier trámite.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cuantía de la ayuda para cambio de ventanas en Bilbao</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Las ayudas para cambio de ventanas se enmarcan dentro de los programas de rehabilitación energética del Plan Rehabilita y Next Generation. Las cuantías varían según los metros cuadrados de ventana cambiados y los ingresos de la unidad familiar:</p>

      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Cuantías orientativas para ayudas de ventanas en Bilbao (datos 2024-2025)</caption>
          <thead>
            <tr>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Tipo de ventana</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Coste orientativo m²</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda (% inversión)</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda (€)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Doble acristalamiento (4/16/4)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">80-150 € / m²</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">15-25%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.000 - 2.500 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Triple acristalamiento (4/12/4/12/4)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">150-250 € / m²</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">20-30%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.500 - 3.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Ventana alta eficiencia (bajo emisivo)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">200-300 € / m²</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">25-35%</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">2.000 - 4.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem;">Paquete completo vivienda (15-25 m²)</td><td style="padding: 0.75rem 1rem;">1.500-4.000 € total</td><td style="padding: 0.75rem 1rem;">20-30%</td><td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.500 - 3.000 €</td></tr>
          </tbody>
        </table>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Requisitos para solicitar la ayuda</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Ser propietario o inquilino (con consentimiento del propietario) de una vivienda situada en Bilbao.</li>
        <li style="margin-bottom: 0.5rem;">La vivienda debe ser la residencia habitual del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Las ventanas instaladas deben cumplir con las especificaciones técnicas exigidas por la convocatoria (transmitancia térmica máxima, factor solar máximo, etc.).</li>
        <li style="margin-bottom: 0.5rem;">La empresa instaladora debe estar dada de alta y tener capacidad para emitir el certificado de instalación.</li>
        <li style="margin-bottom: 0.5rem;">Las ventanas deben cumplir con la normativa vigente de marcado CE.</li>
        <li style="margin-bottom: 0;">No tener deudas pendientes con la Administración Pública.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Documentación necesaria</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">DNI o NIE del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Escritura de propiedad o contrato de alquiler vigente.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de empadronamiento que acredite la residencia habitual.</li>
        <li style="margin-bottom: 0.5rem;">Presupuesto detallado de la empresa de ventanas que incluya marca, modelo y especificaciones técnicas.</li>
        <li style="margin-bottom: 0.5rem;">Fotografías del estado actual de las ventanas a sustituir.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de eficiencia energética de la vivienda antes de la obra (en caso de ayudas de eficiencia).</li>
        <li style="margin-bottom: 0;">Certificado de instalación de las ventanas nuevas emitido por la empresa instaladora.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Plazos y convocatoria 2026</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Plan Rehabilita Bizkaia:</strong> Convocatorias previstas para marzo-abril y junio de 2026.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Next Generation:</strong> Resoluciones periódicas a lo largo de 2026.</li>
        <li style="margin-bottom: 0;"><strong>Plazo de ejecución:</strong> Habitualmente 12 meses desde la resolución favorable.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cómo solicitarla paso a paso</h2>
      <ol style="margin: 1.5rem 0; padding-left: 1.5rem; color: var(--color-grafito); list-style: none; counter-reset: step;">
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem; counter-increment: step;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">1</span><strong>Consulta la convocatoria:</strong> Accede a la web de Viviendazz para conocer las bases exactas y los requisitos técnicos de las ventanas.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">2</span><strong>Recibe presupuestos:</strong> Pide al menos 2-3 presupuestos a empresas especializadas en ventanas que incluyan marca, modelo y especificaciones técnicas.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">3</span><strong>Solicita certificados previos:</strong> Obtén el Certificado de Eficiencia Energética de tu vivienda si la convocatoria lo requiere.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">4</span><strong>Presenta la solicitud:</strong> Rellena el formulario a través de la sede electrónica dentro del plazo.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">5</span><strong>Espera la resolución:</strong> El plazo de resolución suele ser de 2-4 meses.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">6</span><strong>Instala las ventanas:</strong> Una vez concedida la ayuda, ejecuta la instalación con la empresa elegida.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 0;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">7</span><strong>Justifica y cobra:</strong> Presenta facturas, fotografías y certificado de instalación para recibir el pago.</li>
      </ol>

      <div style="background: linear-gradient(135deg, #F6FBF0 0%, #E8F0E4 100%); border: 1px solid #C4D8B0; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: var(--color-verde-montana); margin-top: 0; font-size: 1rem; font-family: var(--font-playfair); margin-bottom: 0.5rem;">Compatibilidad con otras ayudas</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">La deducción del IRPF por obras de mejora de eficiencia energética es <strong>compatible</strong> con las ayudas del Plan Rehabilita y Next Generation. Las ayudas del Plan Rehabilita y Next Generation <strong>no son acumulables</strong> entre sí para la misma actuación.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem; transition: all 0.2s;">
          <a href="/blog/subvenciones-reformas-bilbao-2026/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvencion-eficiencia-energetica-bilbao/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención eficiencia energética Bilbao</a>
        </div>
      </div>

    </article>
  </main>

  <Footer city="bilbao" />
</BaseLayout>
