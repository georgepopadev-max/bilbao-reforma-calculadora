---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Cuál es la ayuda máxima para accesibilidad en Bilbao?', a: 'Las ayudas pueden llegar hasta 8.000€ por vivienda dependiendo del tipo de actuación. Los salvaescaleras y plataformas elevadoras suelen tener cuantías de 5.000-8.000€.' },
  { q: '¿Qué obras de accesibilidad son elegibles?', a: 'Son elegibles: instalación de salvaescaleras y plataformas elevadoras, adaptación de baños con ducha accessible, eliminación de barreras en puertas y accesos, instalación de barandillas y pasamanos, y construcción de rampas de acceso.' },
  { q: '¿Pueden solicitarla inquilinos?', a: 'Sí, las ayudas de accesibilidad son una de las pocas líneas que permiten a los inquilinos solicitar ayuda, siempre que cuenten con el consentimiento escrito del propietario.' },
  { q: '¿Qué documentación necesito si tengo una discapacidad?', a: 'Necesitas el certificado de discapacidad reconocida (igual o superior al 33%) o el informe médico que acredite la movilidad reducida.' },
  { q: '¿Se puede combinar con el IRPF?', a: 'Sí, la deducción del IRPF por obras de accesibilidad es compatible con las ayudas públicas concedidas.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.bilbaoreforma.es/blog/' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://www.bilbaoreforma.es/blog/subvenciones-reformas/' },
    { '@type': 'ListItem', position: 4, name: 'Accesibilidad Bilbao', item: 'https://www.bilbaoreforma.es/blog/subvencion-accesibilidad-bilbao/' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Subvención Accesibilidad Bilbao 2026: Ayudas hasta 8.000€',
  description: 'Subvención accesibilidad Bilbao 2026: ayudas para baños adaptados, salvaescaleras y ascensores.',
  datePublished: '2026-06-28',
  dateModified: '2026-06-28',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---
<BaseLayout
  title="Subvención Accesibilidad Bilbao 2026: Ayudas hasta 8.000€"
  description="Subvención accesibilidad Bilbao 2026: ayudas para baños adaptados, salvaescaleras y ascensores. Cuantías de hasta 8.000€. Requisitos y cómo solicitarla."
  canonical="https://www.bilbaoreforma.es/blog/subvencion-accesibilidad-bilbao/"
  ogType="article"
  jsonSchemas={jsonSchemas}
>
  <Header city="bilbao" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/index.html" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog/index.html" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas/" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Accesibilidad Bilbao</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 28 de junio de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Subvención Accesibilidad Bilbao 2026: Cuantía, Requisitos y Cómo Solicitar
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Mejorar la accesibilidad de tu vivienda en Bilbao es más barato de lo que crees. Las ayudas públicas pueden cubrir hasta el 40% de la inversión, con cuantías orientativas de hasta 8.000€ por vivienda.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Acceder a tu propia casa sin dificultades es una necesidad que afecta a miles de personas en Bilbao: personas mayores, personas con movilidad reducida, familias con niños pequeños o cualquier persona que sufra una limitación temporal o permanente. La buena noticia es que existen ayudas públicas específicas para eliminar estas barreras, con cuantías que pueden llegar hasta los 8.000€ por vivienda.</p>

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos orientativos</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Las cuantías y requisitos se basan en información pública de 2024-2025. Las convocatorias de 2026 pueden variar. Consulta siempre las bases oficiales en Viviendazz (Gobierno Vasco) y en el Ayuntamiento de Bilbao.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cuantía de la ayuda para accesibilidad en Bilbao</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Las ayudas de accesibilidad varían según la actuación y el organismo que las convoque. Estas son las cuantías orientativas para 2025-2026:</p>

      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Cuantías orientativas para ayudas de accesibilidad en Bilbao (datos 2024-2025)</caption>
          <thead>
            <tr>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Tipo de actuación</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Organismo</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda orientativa</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Salvaescaleras vertical</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Gobierno Vasco / Bilbao</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 6.000 - 8.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Plataforma salvaescaleras</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Gobierno Vasco / Bilbao</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 5.000 - 7.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Adaptación de baño (ducha accessible)</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Gobierno Vasco</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.500 - 3.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Elevador o ascensor para comunidad</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Plan Rehabilita / Bilbao</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 10.000 € / vivienda</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Rampas de acceso</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Ayuntamiento Bilbao</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">1.000 - 3.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem;">Puertas automáticas</td><td style="padding: 0.75rem 1rem;">Ayuntamiento Bilbao</td><td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">800 - 2.000 €</td></tr>
          </tbody>
        </table>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Requisitos para solicitar la ayuda</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Ser propietario o inquilino de una vivienda situada en Bilbao.</li>
        <li style="margin-bottom: 0.5rem;">Tener más de 65 años o poseer un certificado de discapacidad reconocida (igual o superior al 33%) o dependencia.</li>
        <li style="margin-bottom: 0.5rem;">La vivienda debe ser la residencia habitual del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Las obras deben ser ejecutadas por empresas especializadas con alta fiscal vigente.</li>
        <li style="margin-bottom: 0.5rem;">Es necesario un informe técnico o de servicios sociales que acredite la necesidad.</li>
        <li style="margin-bottom: 0.5rem;">No tener deudas pendientes con la Administración Pública.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Documentación necesaria</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">DNI o NIE del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Escritura de propiedad o contrato de alquiler (con consentimiento del propietario si es inquilino).</li>
        <li style="margin-bottom: 0.5rem;">Certificado de empadronamiento.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de discapacidad o informe médico.</li>
        <li style="margin-bottom: 0.5rem;">Presupuesto detallado de la empresa que ejecutará las obras.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Plazos y convocatoria 2026</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Convocatoria Gobierno Vasco:</strong> Suele abrir en febrero-marzo y en septiembre.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Convocatoria Ayuntamiento de Bilbao:</strong> Período habitual de solicitud entre abril y junio.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Plazo de ejecución:</strong> Habitualmente 12 meses desde la resolución favorable.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Justificación de gasto:</strong> 2 meses adicionales tras finalizar las obras.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cómo solicitarla paso a paso</h2>
      <ol style="margin: 1.5rem 0; padding-left: 1.5rem; color: var(--color-grafito); list-style: none; counter-reset: step;">
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem; counter-increment: step;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; content: counter(step);">1</span><strong>Consulta la convocatoria:</strong> Accede a la web de Viviendazz o a la sede electrónica del Ayuntamiento de Bilbao.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">2</span><strong>Solicita informe de servicios sociales:</strong> En algunos casos es obligatorio.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">3</span><strong>Obtén presupuestos:</strong> Pide al menos 2-3 presupuestos a empresas especializadas.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">4</span><strong>Presenta la solicitud:</strong> Rellena el formulario en la sede electrónica.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">5</span><strong>Espera la resolución:</strong> El plazo suele ser de 2-3 meses.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">6</span><strong>Ejecuta la obra:</strong> Con la empresa elegida una vez concedida la ayuda.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 0;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">7</span><strong>Justifica y cobra:</strong> Presenta facturas y documentación gráfica.</li>
      </ol>

      <div style="background: linear-gradient(135deg, #F6FBF0 0%, #E8F0E4 100%); border: 1px solid #C4D8B0; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: var(--color-verde-montana); margin-top: 0; font-size: 1rem; font-family: var(--font-playfair); margin-bottom: 0.5rem;">Compatibilidad con otras ayudas</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">La deducción del IRPF por obras de accesibilidad es <strong>compatible</strong> con las ayudas públicas de accesibilidad.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem; transition: all 0.2s;">
          <a href="/blog/subvenciones-reformas/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Guía general de subvenciones 2026</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvencion-cambio-ventanas-bilbao/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-reformas-bilbao-2026/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
      </div>

    </article>
  </main>

  <Footer city="bilbao" />
</BaseLayout>