---
/**
 * index.astro — Blog listing page
 * A2 Zone: Lists all blog posts from src/content/blog/
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data?.date || 0).getTime();
  const dateB = new Date(b.data?.date || 0).getTime();
  return dateB - dateA;
});

// Group by category
const categories = [...new Set(posts.map((p) => {
  const d = p.data;
  return (d && d.category) || 'general';
}))];

// Stats
const totalPosts = posts.length;
const totalFAQs = posts.reduce((sum, p) => {
  const d = p.data;
  return sum + ((d && d.faqs && Array.isArray(d.faqs)) ? d.faqs.length : 0);
}, 0);
const totalCTAs = posts.reduce((sum, p) => {
  const d = p.data;
  return sum + ((d && d.inContentCTAs && Array.isArray(d.inContentCTAs)) ? d.inContentCTAs.length : 0);
}, 0);
---

<BaseLayout
  title="Blog Reformas Bilbao — Precios y Consejos"
  description="Blog con guías prácticas sobre reformas en Bilbao: precios de baños, cocinas, suelos, pintura y más. Información actualizada para 2026."
  canonical="https://www.bilbaoreforma.es/blog.html"
>
  <Header city="bilbao" section="blog" />

  <main>
    <div style="max-width:1200px;margin:0 auto;padding:2rem 1rem">
      {/* Header */}
      <header style="text-align:center;margin-bottom:3rem;padding:2rem 0">
        <h1 style="font-family:'Playfair Display',Georgia,serif;font-size:2.25rem;font-weight:700;color:#2D2D2D;margin-bottom:1rem">
          Blog de Reformas Bilbao
        </h1>
        <p style="font-size:1.0625rem;color:#6B6B6B;max-width:640px;margin:0 auto 1.5rem">
          Guías prácticas, comparativas de precios y consejos para planificar tu reforma en Bilbao con éxito. Actualizado para 2026.
        </p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;font-size:.875rem;color:#6B6B6B">
          <span>{totalPosts} artículos</span>
          <span>·</span>
          <span>{categories.length} categorías</span>
          <span>·</span>
          <span>{totalFAQs} FAQs</span>
          <span>·</span>
          <span>{totalCTAs} CTAs</span>
        </div>
      </header>

      {/* Category filter pills */}
      <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-bottom:2rem;justify-content:center">
        <a href="/blog/" style="background:#C45C3E;color:#FFFFFF;padding:.5rem 1.25rem;border-radius:999px;font-size:.875rem;font-weight:600;text-decoration:none">
          Todos
        </a>
        {categories.map((cat) => (
          <a
            href={`/blog/?category=${cat}`}
            style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1.25rem;border-radius:999px;font-size:.875rem;font-weight:500;text-decoration:none;border:1px solid #E8E2D9"
          >
            {cat}
          </a>
        ))}
      </div>

      {/* Posts grid */}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem">
        {sortedPosts.map((post) => {
          const d = post.data || {};
          const title = d.title || 'Artículo';
          const description = d.description;
          const date = d.date;
          const readTime = d.readTime;
          const category = d.category;
          const city = d.city;
          const faqs = (d.faqs && Array.isArray(d.faqs)) ? d.faqs : [];
          const href = `/blog/${post.slug}.html`;
          return (
            <article style="background:#FFFFFF;border-radius:12px;padding:1.5rem;box-shadow:0 2px 8px rgba(45,30,15,.08);display:flex;flex-direction:column">
              {/* Category + city badges */}
              <div style="display:flex;gap:.5rem;margin-bottom:.75rem;flex-wrap:wrap">
                {category && (
                  <span style="background:#FAF7F2;color:#4A6741;padding:.25rem .75rem;border-radius:999px;font-size:.75rem;font-weight:500">
                    {category}
                  </span>
                )}
                {city && (
                  <span style="background:#EDD5CA;color:#A84A32;padding:.25rem .75rem;border-radius:999px;font-size:.75rem;font-weight:500">
                    {city}
                  </span>
                )}
                {faqs && faqs.length > 0 && (
                  <span style="background:#FAF7F2;color:#6B6B6B;padding:.25rem .75rem;border-radius:999px;font-size:.75rem">
                    {faqs.length} FAQs
                  </span>
                )}
              </div>

              {/* Title */}
              <h2 style="font-family:'Playfair Display',Georgia,serif;font-size:1.125rem;font-weight:600;color:#2D2D2D;line-height:1.3;margin-bottom:.75rem;flex:1">
                <a href={href} style="color:#2D2D2D;text-decoration:none">
                  {title}
                </a>
              </h2>

              {/* Description */}
              {description && (
                <p style="font-size:.875rem;color:#6B6B6B;line-height:1.55;margin-bottom:1rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
                  {description}
                </p>
              )}

              {/* Meta */}
              <div style="display:flex;gap:1rem;font-size:.8125rem;color:#6B6B6B;border-top:1px solid #E8E2D9;padding-top:1rem;margin-top:auto">
                {date && <span>{date}</span>}
                {readTime && <span>{readTime}</span>}
              </div>
            </article>
          );
        })}
      </div>

      {/* CTA */}
      <div style="text-align:center;margin-top:3rem;padding:2rem;background:#FAF7F2;border-radius:12px">
        <p style="font-size:1.0625rem;color:#2D2D2D;margin-bottom:1rem">
          ¿Ya sabes qué reforma necesitas?
        </p>
        <a
          href="/calculadora/index.html"
          style="display:inline-flex;align-items:center;gap:.5rem;background:#C45C3E;color:#FFFFFF;padding:.875rem 1.75rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:.9375rem"
        >
          Calcular presupuesto orientativo
        </a>
      </div>
    </div>
  </main>

  <Footer city="bilbao" />
</BaseLayout>