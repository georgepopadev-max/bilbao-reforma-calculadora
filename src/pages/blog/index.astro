---
/**
 * index.astro — Blog listing page
 * A2 Zone: Lists all blog posts from src/content/blog/
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => {
    const slug = p.slug || p.id || '';
    return !slug.endsWith('-donostia') && !slug.endsWith('-vitoria');
  })
  .sort((a, b) => {
    const dateA = new Date(a.data?.date || 0).getTime();
    const dateB = new Date(b.data?.date || 0).getTime();
    return dateB - dateA;
  });

// Group by category
const categories = [...new Set(posts.map((p) => {
  const d = p.data;
  return (d && d.category) || 'general';
}))];

// Stats
const totalPosts = posts.length;
const totalFAQs = posts.reduce((sum, p) => {
  const d = p.data;
  return sum + ((d && d.faqs && Array.isArray(d.faqs)) ? d.faqs.length : 0);
}, 0);
const totalCTAs = posts.reduce((sum, p) => {
  const d = p.data;
  return sum + ((d && d.inContentCTAs && Array.isArray(d.inContentCTAs)) ? d.inContentCTAs.length : 0);
}, 0);
---

<BaseLayout
  title="Blog Reformas Bilbao — Precios y Consejos"
  description="Blog con guías prácticas sobre reformas en Bilbao: precios de baños, cocinas, suelos, pintura y más. Información actualizada para 2026."
  canonical="https://www.bilbaoreforma.es/blog.html"
  ogImage="https://www.bilbaoreforma.es/images/og/blog-og.jpg"
  ogImageAlt="Blog Reformas Bilbao"
>
  <Header city="bilbao" section="blog" />

  <main>
    <div style="max-width:1200px;margin:0 auto;padding:2rem 1rem">

      {/* Introductory section */}
      <section style="max-width:860px;margin:0 auto 3rem;text-align:center">
        <h1 style="font-family:'Playfair Display',Georgia,serif;font-size:2.25rem;font-weight:700;color:#2D2D2D;margin-bottom:1rem">
          Blog de Reformas Bilbao
        </h1>
        <p style="font-size:1.0625rem;color:#6B6B6B;max-width:640px;margin:0 auto 1.5rem;line-height:1.7">
          Guías prácticas, comparativas de precios y consejos para planificar tu reforma en Bilbao con éxito. Aquí encontrarás información actualizada sobre costes de reformas, trucos para ahorrar, y todo lo que necesitas saber sobre las ayudas y subvenciones disponibles en 2026.
        </p>
        <p style="font-size:0.9375rem;color:#6B6B6B;max-width:580px;margin:0 auto;line-height:1.6">
          Bilbao tiene uno de los parques inmobiliarios más envejecidos de España. Muchas viviendas necesitan reformas urgentes de baños, cocinas, fachadas e instalaciones. Si estás pensando en reformbar, este es tu punto de partida: información práctica basada en datos reales del mercado de reformas en el País Vasco.
        </p>
      </section>

      {/* Stats bar */}
      <div style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;font-size:.875rem;color:#6B6B6B;margin-bottom:2rem;padding:1rem;background:#FAF7F2;border-radius:12px">
        <span style="font-weight:600;color:#2D2D2D">{totalPosts} artículos</span>
        <span>·</span>
        <span style="font-weight:600;color:#2D2D2D">{categories.length} categorías</span>
        <span>·</span>
        <span style="font-weight:600;color:#2D2D2D">{totalFAQs} preguntas frecuentes</span>
        <span>·</span>
        <span style="font-weight:600;color:#2D2D2D">Actualizado 2026</span>
      </div>

      {/* Category filter pills */}
      <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-bottom:2rem;justify-content:center">
        <a href="/blog/" style="background:#C45C3E;color:#FFFFFF;padding:.5rem 1.25rem;border-radius:999px;font-size:.875rem;font-weight:600;text-decoration:none">
          Todos
        </a>
        {categories.map((cat) => (
          <a
            href={`/blog/?category=${cat}`}
            style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1.25rem;border-radius:999px;font-size:.875rem;font-weight:500;text-decoration:none;border:1px solid #E8E2D9"
          >
            {cat}
          </a>
        ))}
      </div>

      {/* Popular topics */}
      <section style="background:#FFFFFF;border-radius:12px;padding:1.5rem;margin-bottom:2rem;box-shadow:0 2px 8px rgba(45,30,15,.08)">
        <h2 style="font-family:'Playfair Display',Georgia,serif;font-size:1.25rem;font-weight:700;color:#2D2D2D;margin-bottom:1rem">
          Temas más buscados
        </h2>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
          <a href="/blog/subvenciones-reformas-bilbao-2026/" style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1rem;border-radius:8px;font-size:.875rem;text-decoration:none;border:1px solid #E8E2D9">Subvenciones Bilbao 2026</a>
          <a href="/blog/subvencion-cambio-ventanas-bilbao/" style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1rem;border-radius:8px;font-size:.875rem;text-decoration:none;border:1px solid #E8E2D9">Cambio ventanas</a>
          <a href="/blog/subvencion-accesibilidad-bilbao/" style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1rem;border-radius:8px;font-size:.875rem;text-decoration:none;border:1px solid #E8E2D9">Accesibilidad</a>
          <a href="/blog/subvencion-fachadas-bilbao/" style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1rem;border-radius:8px;font-size:.875rem;text-decoration:none;border:1px solid #E8E2D9">Fachadas</a>
          <a href="/blog/subvencion-eficiencia-energetica-bilbao/" style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1rem;border-radius:8px;font-size:.875rem;text-decoration:none;border:1px solid #E8E2D9">Eficiencia energética</a>
          <a href="/blog/subvencion-cambio-calderas-vitoria/" style="background:#FAF7F2;color:#2D2D2D;padding:.5rem 1rem;border-radius:8px;font-size:.875rem;text-decoration:none;border:1px solid #E8E2D9">Calderas Vitoria</a>
        </div>
      </section>

      {/* Posts grid */}
      <div class="article-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem">
        {posts.map((post) => {
          const d = post.data || {};
          const title = d.title || 'Artículo';
          const description = d.description;
          const date = d.date;
          const readTime = d.readTime;
          const category = d.category;
          const city = d.city;
          const faqs = (d.faqs && Array.isArray(d.faqs)) ? d.faqs : [];
          const href = `/blog/${post.slug}.html`;
          return (
            <article style="background:#FFFFFF;border-radius:12px;padding:1.5rem;box-shadow:0 2px 8px rgba(45,30,15,.08);display:flex;flex-direction:column">
              {/* Category + city badges */}
              <div style="display:flex;gap:.5rem;margin-bottom:.75rem;flex-wrap:wrap">
                {category && (
                  <span style="background:#FAF7F2;color:#4A6741;padding:.25rem .75rem;border-radius:999px;font-size:.75rem;font-weight:500">
                    {category}
                  </span>
                )}
                {city && (
                  <span style="background:#EDD5CA;color:#A84A32;padding:.25rem .75rem;border-radius:999px;font-size:.75rem;font-weight:500">
                    {city}
                  </span>
                )}
                {faqs && faqs.length > 0 && (
                  <span style="background:#FAF7F2;color:#6B6B6B;padding:.25rem .75rem;border-radius:999px;font-size:.75rem">
                    {faqs.length} FAQs
                  </span>
                )}
              </div>

              {/* Title */}
              <h2 style="font-family:'Playfair Display',Georgia,serif;font-size:1.125rem;font-weight:600;color:#2D2D2D;line-height:1.3;margin-bottom:.75rem;flex:1">
                <a href={href} style="color:#2D2D2D;text-decoration:none">
                  {title}
                </a>
              </h2>

              {/* Description */}
              {description && (
                <p style="font-size:.875rem;color:#6B6B6B;line-height:1.55;margin-bottom:1rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
                  {description}
                </p>
              )}

              {/* Meta */}
              <div style="display:flex;gap:1rem;font-size:.8125rem;color:#6B6B6B;border-top:1px solid #E8E2D9;padding-top:1rem;margin-top:auto">
                {date && <span>{date}</span>}
                {readTime && <span>{readTime}</span>}
              </div>
            </article>
          );
        })}
      </div>

      {/* CTA — enlaces keyword-rich a landing pages SEO */}
      <div style="text-align:center;margin-top:3rem;padding:2rem;background:#FAF7F2;border-radius:12px">
        <p style="font-size:1.0625rem;color:#2D2D2D;margin-bottom:1rem">
          ¿Ya sabes qué reforma necesitas?
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:center;margin-bottom:1rem">
          <a href="/presupuesto-reforma-integral-bilbao.html" style="background:#C45C3E;color:#fff;padding:.625rem 1.25rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:.875rem">Presupuesto reforma integral Bilbao</a>
          <a href="/presupuesto-reforma-bano-bilbao.html" style="background:#4A90B8;color:#fff;padding:.625rem 1.25rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:.875rem">Precio reforma baño Bilbao</a>
          <a href="/presupuesto-reforma-cocina-bilbao.html" style="background:#8B6F47;color:#fff;padding:.625rem 1.25rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:.875rem">Presupuesto reforma cocina Bilbao</a>
        </div>
        <p style="font-size:.8125rem;color:#6B6B6B;margin:0">o usa la <a href="/calculadora/index.html" style="color:#C45C3E;font-weight:600;text-decoration:none">calculadora general →</a></p>
      </div>
    </div>
  </main>

  <Footer city="bilbao" />
</BaseLayout>

<style>
  @media (max-width: 640px) {
    .article-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
