  ogImageAlt={title}>
  <main style="max-width:860px;margin:0 auto;padding:2rem 1rem">
    <nav style="display:flex;gap:.5rem;font-size:.8125rem;color:#6B6B6B;margin-bottom:1.5rem;flex-wrap:wrap">
