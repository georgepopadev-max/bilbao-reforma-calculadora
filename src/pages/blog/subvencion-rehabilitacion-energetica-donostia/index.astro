---
/**
 * subvention-rehabilitacion-energetica-donostia — static Astro page migrated from legacy HTML
 * A2 Zone
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const faqs = [
  { q: '¿Cuánto dinero puede conceder el Plan PREE de Gipuzkoa para rehabilitación energética?', a: 'El Plan PREE de Gipuzkoa puede conceder hasta 10.000€ por vivienda para rehabilitación energética integral. Las ayudas Etxebide pueden llegar hasta 8.000€ adicionales, y las bonificaciones del IBI pueden reducir el impuesto entre un 50% y un 90% durante 4 años.' },
  { q: '¿Qué tipo de obras son elegibles para estas ayudas?', a: 'Son elegibles: aislamiento térmico de fachadas y cubiertas, sustitución de ventanas por otras de alta eficiencia, instalación de sistemas de calefacción eficientes (aerotermia, caldera de condensación), e instalación de energía solar térmica o fotovoltaica.' },
  { q: '¿Qué es el programa Etxebide y quién puede acceder?', a: 'El programa Etxebide está dirigido a hogares con ingresos moderados. Si tus ingresos superan el umbral establecido, puedes acceder a otras líneas de ayuda como el Plan PREE o las bonificaciones del IBI.' },
  { q: '¿El Ayuntamiento de Donostia ofrece bonificaciones del IBI?', a: 'El Ayuntamiento de Donostia ofrece bonificaciones del IBI (entre el 50% y el 90% durante 4 años) para viviendas que realicen obras de mejora de la eficiencia energética o accesibilidad. Consulta los requisitos en la web del Ayuntamiento.' },
  { q: '¿Se pueden solicitar ayudas para varias viviendas?', a: 'Sí, las ayudas se conceden por vivienda, no por persona. Si tienes propiedades en diferentes ciudades, puedes solicitar ayudas en cada una de ellas, siempre que cumplas los requisitos de cada convocatoria.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.bilbaoreforma.es/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.bilbaoreforma.es/blog/' },
    { '@type': 'ListItem', position: 3, name: 'Subvenciones', item: 'https://www.bilbaoreforma.es/blog/subvenciones-reformas/' },
    { '@type': 'ListItem', position: 4, name: 'Donostia', item: 'https://www.bilbaoreforma.es/blog/subvencion-rehabilitacion-energetica-donostia/' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Rehab Energética Donostia 2026: Subvención Hasta 10.000€',
  description: 'Ayudas rehabilitación energética Donostia 2026: Plan PREE Gipuzkoa y Etxebide. Cuantías de hasta 10.000€ por vivienda.',
  datePublished: '2026-06-28',
  dateModified: '2026-06-28',
  inLanguage: 'es-ES',
  author: { '@type': 'Organization', name: 'Equipo Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
  publisher: { '@type': 'Organization', name: 'Bilbao Reforma', url: 'https://www.bilbaoreforma.es/' },
};

const jsonSchemas = [articleSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Rehab Energética Donostia 2026"
  description="Ayudas rehabilitación energética Donostia 2026: Plan PREE Gipuzkoa y Etxebide. Cuantías de hasta 10.000€ por vivienda. Requisitos y cómo solicitarlas."
  canonical="https://www.bilbaoreforma.es/blog/subvencion-rehabilitacion-energetica-donostia/"
  ogType="article"
  ogImage="https://www.bilbaoreforma.es/images/og/donostia-og.jpg"
  ogImageAlt="Rehab Energética Donostia 2026"
  jsonSchemas={jsonSchemas}
>
  <Header city="donostia" />

  <main style="max-width: 860px; margin: 0 auto; padding: 2rem 1rem;">

    <nav style="display: flex; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; flex-wrap: wrap;">
      <a href="/index.html" style="color: var(--color-terracota); text-decoration: none;">Inicio</a>
      <span>›</span>
      <a href="/blog/index.html" style="color: var(--color-terracota); text-decoration: none;">Blog</a>
      <span>›</span>
      <a href="/blog/subvenciones-reformas/" style="color: var(--color-terracota); text-decoration: none;">Subvenciones</a>
      <span>›</span>
      <span>Donostia</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <p style="font-size: 0.8125rem; color: var(--color-gris); margin-bottom: 1.5rem; font-family: var(--font-mono);">Actualizado: 28 de junio de 2026 · 8 min de lectura</p>
      <h1 style="font-family: var(--font-playfair); font-size: 2rem; font-weight: 700; color: var(--color-grafito); line-height: 1.25; margin-bottom: 1rem;">
        Rehab Energética Donostia 2026: Subvención Hasta 10.000€
      </h1>
      <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.65;">
        Donostia cuenta con líneas específicas de ayuda para la rehabilitación energética de viviendas a través del Plan PREE de Gipuzkoa y de las bonificaciones municipales del Ayuntamiento. Las cuantías pueden alcanzar los 10.000€ por vivienda, y se pueden combinar con la deducción del IRPF para maximizar el ahorro.
      </p>
    </header>

    <article style="background: var(--color-blanco); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(45,30,15,.08);">

      <p style="margin-bottom: 1rem; color: var(--color-grafito);">Donostia, como capital de Gipuzkoa, lidera muchas de las políticas de rehabilitación energética del territorio. El clima atlántico de la ciudad —con lluvias frecuentes y temperaturas moderadas pero con picos de frío en invierno— hace que el aislamiento energético de las viviendas sea una inversión especialmente rentable. Un edificio mal aislado puede perder hasta un 35% de su energía por las fachadas y cubierta.</p>

      <div style="background: #FFF9E6; border: 1px solid #F0E6C8; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: #8A7340; margin-top: 0; font-size: 1rem; margin-bottom: 0.5rem;">Datos orientativos</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">Las cuantías y requisitos que detallamos se basan en información pública de 2024-2025. Las convocatorias de 2026 pueden variar. Consulta siempre las bases oficiales en la web de la Deputación de Gipuzkoa y del Ayuntamiento de Donostia antes de iniciar cualquier trámite.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cuantía de la ayuda para rehabilitación energética en Donostia</h2>
      <p style="margin-bottom: 1rem; color: var(--color-grafito);">El Programa PREE (Programa de Rehabilitación Energética de Edificios) de Gipuzkoa y las ayudas Etxebide ofrecen cuantías variables según el tipo de actuación y los ingresos. Estas son las cuantías orientativas:</p>

      <div style="overflow-x: auto; margin: 1.5rem 0;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9375rem;">
          <caption style="font-size: 0.8125rem; color: var(--color-gris); text-align: left; margin-bottom: 0.5rem; font-style: italic;">Cuantías orientativas para rehabilitación energética en Donostia (datos 2024-2025)</caption>
          <thead>
            <tr>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Programa</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Tipo de obra</th>
              <th style="background: var(--color-verde-montana); color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600; font-size: 0.8125rem;">Ayuda orientativa</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Plan PREE Gipuzkoa</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Rehabilitación integral</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 10.000 € / vivienda</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Plan PREE Gipuzkoa</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Aislamiento térmico</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">2.000 - 6.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Etxebide</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige);">Mejora accesibilidad y eficiencia</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 8.000 €</td></tr>
            <tr><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Bonificación IBI Donostia</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema);">Mejora eficiencia o accesibilidad</td><td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-beige); background: var(--color-crema); font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">50-90% reducción IBI (4 años)</td></tr>
            <tr><td style="padding: 0.75rem 1rem;">Ayudas municipales Donostia</td><td style="padding: 0.75rem 1rem;">Rehabilitación fachada y cubierta</td><td style="padding: 0.75rem 1rem; font-family: var(--font-mono); font-weight: 600; color: var(--color-terracota);">Hasta 5.000 € / vivienda</td></tr>
          </tbody>
        </table>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Requisitos para solicitar la ayuda</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">Ser propietario o inquilino de una vivienda situada en Donostia.</li>
        <li style="margin-bottom: 0.5rem;">La vivienda debe ser la residencia habitual del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Los trabajos deben tener un coste elegible mínimo (variable según convocatoria).</li>
        <li style="margin-bottom: 0.5rem;">Las obras deben ser ejecutadas por empresas con alta fiscal vigente.</li>
        <li style="margin-bottom: 0.5rem;">Es necesario un informe técnico que acredite la mejora energética esperada.</li>
        <li style="margin-bottom: 0.5rem;">Contratar un técnico competente cuando la convocatoria lo exija.</li>
        <li style="margin-bottom: 0;">No tener deudas pendientes con la Administración Pública.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Documentación necesaria</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;">DNI o NIE del solicitante.</li>
        <li style="margin-bottom: 0.5rem;">Escritura de propiedad o contrato de alquiler.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de empadronamiento.</li>
        <li style="margin-bottom: 0.5rem;">Presupuesto detallado de la empresa de reformas.</li>
        <li style="margin-bottom: 0.5rem;">Certificado de Eficiencia Energética de la vivienda antes de la obra.</li>
        <li style="margin-bottom: 0.5rem;">Informe técnico con la descripción de las actuaciones y mejora energética prevista.</li>
        <li style="margin-bottom: 0;">Fotografías del estado actual de la vivienda.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Plazos y convocatoria 2026</h2>
      <ul style="margin: 1rem 0 1.5rem 1.5rem; color: var(--color-grafito);">
        <li style="margin-bottom: 0.5rem;"><strong>Programa PREE Gipuzkoa:</strong> Previsto para abril de 2026.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Ayudas Etxebide:</strong> Período de solicitud entre marzo y mayo de 2026.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Bonificación IBI Donostia:</strong> Solicitud anual en el último trimestre del año.</li>
        <li style="margin-bottom: 0;"><strong>Plazo de ejecución:</strong> Habitualmente 12-18 meses desde la resolución.</li>
      </ul>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Cómo solicitarla paso a paso</h2>
      <ol style="margin: 1.5rem 0; padding-left: 1.5rem; color: var(--color-grafito); list-style: none; counter-reset: step;">
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem; counter-increment: step;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">1</span><strong>Consulta la convocatoria:</strong> Accede a la web de la Deputación de Gipuzkoa y del Ayuntamiento de Donostia para conocer las líneas abiertas.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">2</span><strong>Contrata un técnico:</strong> Un técnico competente debe redactar el informe técnico y, en su caso, el proyecto.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">3</span><strong>Recibe presupuestos:</strong> Pide al menos 2-3 presupuestos a empresas de reformas inscritas.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">4</span><strong>Presenta la solicitud:</strong> Rellena el formulario en la sede electrónica del organismo convocante.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">5</span><strong>Espera la resolución:</strong> El plazo de resolución suele ser de 2-4 meses.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 1.5rem;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">6</span><strong>Ejecuta la obra:</strong> Una vez concedida la ayuda, ejecuta la reforma con la empresa elegida.</li>
        <li style="position: relative; padding-left: 3rem; margin-bottom: 0;"><span style="position: absolute; left: 0; top: 0; width: 2rem; height: 2rem; background: var(--color-terracota); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">7</span><strong>Justifica y cobra:</strong> Presenta facturas, certificado final de eficiencia energética y documentación gráfica.</li>
      </ol>

      <div style="background: linear-gradient(135deg, #F6FBF0 0%, #E8F0E4 100%); border: 1px solid #C4D8B0; border-radius: 12px; padding: 1.25rem; margin: 1.5rem 0;">
        <h3 style="color: var(--color-verde-montana); margin-top: 0; font-size: 1rem; font-family: var(--font-playfair); margin-bottom: 0.5rem;">Compatibilidad con otras ayudas</h3>
        <p style="margin-bottom: 0; font-size: 0.9375rem;">La deducción del IRPF por obras de mejora energética es <strong>compatible</strong> con las ayudas del Plan PREE y Etxebide. Las diferentes líneas de ayuda pública <strong>suelen ser compatibles</strong> entre sí si no cubren los mismos conceptos. Consulta siempre con el organismo concedente.</p>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Preguntas frecuentes</h2>

      {faqs.map(faq => (
        <div style="border-bottom: 1px solid var(--color-beige); padding: 1.25rem 0;">
          <div style="font-weight: 600; font-size: 1rem; color: var(--color-grafito); margin-bottom: 0.625rem;">{faq.q}</div>
          <div style="font-size: 0.9375rem; color: var(--color-gris); line-height: 1.6;">{faq.a}</div>
        </div>
      ))}

      <div style="background: var(--color-terracota); border-radius: 12px; padding: 2rem; text-align: center; margin: 2rem 0; color: var(--color-blanco);">
        <h3 style="font-family: var(--font-playfair); font-size: 1.375rem; margin-bottom: 0.5rem; color: var(--color-blanco);">¿Sabes cuánto cuesta tu reforma?</h3>
        <p style="opacity: 0.9; margin-bottom: 1.25rem;">Calcula el presupuesto orientativo de tu reforma y averigua qué ayudas podrían corresponderte.</p>
        <a href="/calculadora/index.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.75rem; background: var(--color-blanco); color: var(--color-terracota); border-radius: 8px; font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: all 0.2s;">Calcular presupuesto de mi reforma</a>
      </div>

      <h2 style="font-family: var(--font-playfair); font-size: 1.375rem; font-weight: 600; color: var(--color-grafito); margin: 2rem 0 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-beige);">Artículos relacionados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0;">
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem; transition: all 0.2s;">
          <a href="/blog/subvencion-cambio-ventanas-bilbao/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Subvención cambio de ventanas Bilbao</a>
        </div>
        <div style="background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 12px; padding: 1rem;">
          <a href="/blog/subvenciones-reformas-bilbao-2026/" style="color: var(--color-grafito); text-decoration: none; display: block; font-weight: 500; font-size: 0.9375rem;">Todas las ayudas Bilbao 2026</a>
        </div>
      </div>

    </article>
  </main>

  <Footer city="donostia" />
</BaseLayout>
