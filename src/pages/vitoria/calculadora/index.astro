---
/**
 * Calculadora Index — Vitoria
 * A3 Zone
 */
import CalculadoraLayout from '../../../layouts/CalculadoraLayout.astro';
import Calculator from '../../../components/calculator/Calculator.astro';
---

<CalculadoraLayout
  title="Calculadora Reformas Vitoria 2026"
  description="Calcula el presupuesto orientativo de tu reforma en Vitoria-Gasteiz y Álava. Gratis, sin registro, en menos de 2 minutos."
  canonical="https://www.bilbaoreforma.es/vitoria/calculadora/"
  city="vitoria"
  calculatorType="integral"
>
  <!-- Wizard Intro -->
  <div class="calculator-intro-editorial" style="max-width:760px;margin:2rem auto;padding:0 1.5rem;text-align:center;">
    <h1>Calculadora de Reformas en Vitoria-Gasteiz 2026</h1>
    <p>Obtén un <strong>presupuesto orientativo para tu reforma en Vitoria-Gasteiz y Álava</strong> en menos de 2 minutos. Datos basados en precios reales de empresas de reformas en Álava, actualizados 2026.</p>
  </div>

  <!-- CTA cards — fixed: using Bilbao design token colors for contrast -->
  <div style="max-width:800px;margin:0 auto 2rem;padding:0 1.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;">
    <a href="/vitoria/calculadora/index.html?type=bano" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:var(--color-verde-montana,#4A6741);color:white;padding:1rem 1.5rem;border-radius:var(--radius-card,8px);text-decoration:none;font-weight:500;">
      <span>Baño</span>
      <span>desde 3.500 € →</span>
    </a>
    <a href="/vitoria/calculadora/index.html?type=cocina" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:var(--color-terracota,#C45C3E);color:white;padding:1rem 1.5rem;border-radius:var(--radius-card,8px);text-decoration:none;font-weight:500;">
      <span>Cocina</span>
      <span>desde 5.500 € →</span>
    </a>
    <a href="/vitoria/calculadora/index.html?type=pintura" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;background:var(--color-verde-txakoli,#7FA650);color:white;padding:1rem 1.5rem;border-radius:var(--radius-card,8px);text-decoration:none;font-weight:500;">
      <span>Pintura</span>
      <span>desde 10 €/m² →</span>
    </a>
  </div>

  <!-- Calculator using Calculator.astro shell for consistent styling -->
  <Calculator city="vitoria" calculatorType="integral" title="Reforma en Vitoria" actualStepCount={6}>
    <!-- Hidden inputs for result -->
    <input type="hidden" id="totalPrice" name="totalPrice" value="" />
    <input type="hidden" id="priceRange" name="priceRange" value="" />

    <!-- STEP 1: Reform Type -->
    <div class="wizard-step active" id="step1" data-step="1">
      <div class="step-header">
        <h2 class="step-title">¿Qué tipo de reforma necesitas?</h2>
        <p class="step-subtitle">Selecciona una opción o combina varias estancias</p>
      </div>

      <!-- Scope Cards -->
      <div class="scope-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.75rem;margin-bottom:1.5rem;">
        <div class="age-option" data-scope="basic" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Reforma básica</div>
            <div class="age-option-desc">500–650 €/m²</div>
          </div>
        </div>
        <div class="age-option" data-scope="medium" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Reforma media</div>
            <div class="age-option-desc">650–900 €/m²</div>
          </div>
        </div>
        <div class="age-option" data-scope="integral" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Reforma integral</div>
            <div class="age-option-desc">850–1.200 €/m²</div>
          </div>
        </div>
        <div class="age-option" data-scope="luxury" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">✨ Reforma premium</div>
            <div class="age-option-desc">1.200–1.500 €/m²</div>
          </div>
        </div>
      </div>

      <p style="text-align:center;color:#888;font-size:0.9rem;margin-bottom:1.5rem;">— o selecciona estancias individuales —</p>

      <!-- Individual Room Cards -->
      <div class="type-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:0.75rem;">
        <div class="type-card card" data-reform="painting" role="button" tabindex="0" aria-pressed="false">
          <div class="card-icon"></div>
          <div class="card-title">Pintura</div>
          <div class="card-desc">10–22 €/m²</div>
        </div>
        <div class="type-card card" data-reform="flooring" role="button" tabindex="0" aria-pressed="false">
          <div class="card-icon"></div>
          <div class="card-title">Suelo</div>
          <div class="card-desc">30–120 €/m²</div>
        </div>
        <div class="type-card card" data-reform="bathroom" role="button" tabindex="0" aria-pressed="false">
          <div class="card-icon"></div>
          <div class="card-title">Baño</div>
          <div class="card-desc">desde 3.500 €</div>
        </div>
        <div class="type-card card" data-reform="kitchen" role="button" tabindex="0" aria-pressed="false">
          <div class="card-icon"></div>
          <div class="card-title">Cocina</div>
          <div class="card-desc">desde 5.500 €</div>
        </div>
      </div>

      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-next" id="btn-next" type="button">
          Siguiente →
        </button>
      </nav>
    </div>

    <!-- STEP 2: Surface Area -->
    <div class="wizard-step" id="step2" data-step="2">
      <div class="step-header">
        <h2 class="step-title">¿Cuántos metros cuadrados tiene la vivienda?</h2>
        <p class="step-subtitle">Indica la superficie total a reformar</p>
      </div>
      <div class="meters-input-group">
        <div class="meters-value-display">
          <span class="meters-value-number" id="metersDisplayValue">80</span>
          <span class="meters-value-unit">m²</span>
        </div>
        <input type="number" id="metersInput" class="meters-input" value="80" min="20" max="500" aria-label="Metros cuadrados" />
        <input type="range" id="metersSlider" class="meters-slider" min="20" max="500" value="80" aria-label="Slider de metros cuadrados" />
        <div class="meters-presets">
          <button class="meters-preset-btn" data-meters="45" type="button">Estudio (~45m²)</button>
          <button class="meters-preset-btn" data-meters="70" type="button">Piso 2 hab (~70m²)</button>
          <button class="meters-preset-btn" data-meters="90" type="button">Piso 3 hab (~90m²)</button>
          <button class="meters-preset-btn" data-meters="110" type="button">Piso 4 hab (~110m²)</button>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" id="btn-prev" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Siguiente →</button>
      </nav>
    </div>

    <!-- STEP 3: Building Age -->
    <div class="wizard-step" id="step3" data-step="3">
      <div class="step-header">
        <h2 class="step-title">¿Qué antigüedad tiene el edificio?</h2>
        <p class="step-subtitle">Los edificios antiguos pueden necesitar renovación de instalaciones</p>
      </div>
      <div class="age-options" id="ageOptions">
        <div class="age-option selected" data-age="new" role="button" tabindex="0" aria-pressed="true">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Menos de 20 años</div>
            <div class="age-option-desc">Instalaciones modernas</div>
          </div>
          <span class="age-option-badge">×1.00</span>
        </div>
        <div class="age-option" data-age="moderate" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">20–40 años</div>
            <div class="age-option-desc">Posible renovación parcial</div>
          </div>
          <span class="age-option-badge">×1.05</span>
        </div>
        <div class="age-option" data-age="old" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">40–70 años</div>
            <div class="age-option-desc">Tuberías y electricidad pueden necesitarse</div>
          </div>
          <span class="age-option-badge">×1.15</span>
        </div>
        <div class="age-option" data-age="historic" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Más de 70 años / Casco Viejo</div>
            <div class="age-option-desc">Acceso difícil, materiales especiales</div>
          </div>
          <span class="age-option-badge">×1.30</span>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Siguiente →</button>
      </nav>
    </div>

    <!-- STEP 4: Quality -->
    <div class="wizard-step" id="step4" data-step="4">
      <div class="step-header">
        <h2 class="step-title">¿Qué nivel de calidad quieres?</h2>
        <p class="step-subtitle">La calidad de los materiales determina el precio final</p>
      </div>
      <div class="age-options" id="qualityOptions">
        <div class="age-option" data-quality="basic" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Básica</div>
            <div class="age-option-desc">Leroy Merlin, marca blanca</div>
          </div>
          <span class="age-option-badge">×0.80</span>
        </div>
        <div class="age-option selected" data-quality="medium" role="button" tabindex="0" aria-pressed="true">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Media</div>
            <div class="age-option-desc">Cosentino, Porcelanosa media, Roca</div>
          </div>
          <span class="age-option-badge">×1.00</span>
        </div>
        <div class="age-option" data-quality="premium" role="button" tabindex="0" aria-pressed="false">
          <div class="age-option-radio"></div>
          <div class="age-option-content">
            <div class="age-option-title">Premium</div>
            <div class="age-option-desc">Dekton, Villeroy & Boch, Hansgrohe</div>
          </div>
          <span class="age-option-badge">×1.40</span>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Siguiente →</button>
      </nav>
    </div>

    <!-- STEP 5: Extras -->
    <div class="wizard-step" id="step5" data-step="5">
      <div class="step-header">
        <h2 class="step-title">¿Algún extra?</h2>
        <p class="step-subtitle">Selecciona elementos adicionales (opcional)</p>
      </div>
      <div class="extras-grid" id="extrasGrid">
        <div class="extra-checkbox-item" data-extra="windows" role="button" tabindex="0" aria-pressed="false">
          <div class="extra-checkbox">
            <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div class="extra-content">
            <div class="extra-title">Ventanas PVC</div>
            <div class="extra-desc">4 unidades de media</div>
          </div>
          <div class="extra-bottom-row">
            <span class="extra-price">350–700 €/ud</span>
          </div>
        </div>
        <div class="extra-checkbox-item" data-extra="terrace" role="button" tabindex="0" aria-pressed="false">
          <div class="extra-checkbox">
            <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div class="extra-content">
            <div class="extra-title">Terraza/Balcón</div>
            <div class="extra-desc">Opcional</div>
          </div>
          <div class="extra-bottom-row">
            <span class="extra-price">250–550 €/m²</span>
          </div>
        </div>
        <div class="extra-checkbox-item" data-extra="radiantFloor" role="button" tabindex="0" aria-pressed="false">
          <div class="extra-checkbox">
            <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div class="extra-content">
            <div class="extra-title">Suelo radiante</div>
            <div class="extra-desc">Opcional</div>
          </div>
          <div class="extra-bottom-row">
            <span class="extra-price">70–140 €/m²</span>
          </div>
        </div>
        <div class="extra-checkbox-item" data-extra="domotics" role="button" tabindex="0" aria-pressed="false">
          <div class="extra-checkbox">
            <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div class="extra-content">
            <div class="extra-title">Domótica</div>
            <div class="extra-desc">Opcional</div>
          </div>
          <div class="extra-bottom-row">
            <span class="extra-price">1.000–3.000 €</span>
          </div>
        </div>
        <div class="extra-checkbox-item" data-extra="aerothermia" role="button" tabindex="0" aria-pressed="false">
          <div class="extra-checkbox">
            <svg class="extra-checkbox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div class="extra-content">
            <div class="extra-title">Aerotermia</div>
            <div class="extra-desc">Opcional</div>
          </div>
          <div class="extra-bottom-row">
            <span class="extra-price">4.500–10.000 €</span>
          </div>
        </div>
      </div>
      <nav class="wizard-nav">
        <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Atrás</button>
        <button class="wizard-nav-btn wizard-nav-btn-next" type="button">Calcular Presupuesto →</button>
      </nav>
    </div>

    <!-- STEP 6: Result -->
    <div class="wizard-step" id="step6" data-step="6">
      <div class="result-container">
        <div class="result-header">
          <span class="result-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            Presupuesto estimado
          </span>
          <h2 class="result-title">Tu reforma cuesta entre</h2>
          <div class="result-range">
            <span class="result-range-low" id="resultRangeLow">—</span>
            <span class="result-range-separator">—</span>
            <span class="result-range-high" id="resultRangeHigh">—</span>
          </div>
        </div>

        <div class="result-breakdown">
          <h2 class="result-breakdown-title">Desglose orientativo</h2>
          <div id="resultBreakdownBars"></div>
        </div>

        <div class="result-comparison">
          <div class="result-comparison-title">Precio medio en Vitoria</div>
          <div class="result-comparison-value" id="resultComparisonValue">— €/m²</div>
          <div class="result-comparison-label" id="resultComparisonLabel">para reforma media</div>
        </div>

        <div class="result-ctas">
          <button class="cta-button cta-button-primary" type="button" id="downloadPdfBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
            Descargar PDF
          </button>
          <button class="cta-button cta-button-secondary" type="button" id="requestQuotesBtn">
            Solicitar 3 presupuestos
          </button>
        </div>

        <div class="result-disclaimer">
          ⚠️ Este presupuesto es orientativo y puede variar ±15% según las características específicas de tu reforma. Solicita presupuestos personalizados a empresas locales.
          <br><br>
          Precios sin IVA (10% IVA reducido para reformas de vivienda).
        </div>

        <nav class="wizard-nav">
          <button class="wizard-nav-btn wizard-nav-btn-back" type="button">← Modificar</button>
          <button class="wizard-nav-btn wizard-nav-btn-next" type="button" id="btn-restart">Nuevo cálculo →</button>
        </nav>
      </div>
    </div>
  </Calculator>

  <!-- FAQ Section -->
  <section class="faq-section" style="background:var(--color-crema,#FAF7F2);padding:3rem 1.5rem;border-top:1px solid var(--color-beige,#E8E0D5);">
    <div style="max-width:800px;margin:0 auto;">
      <h2 style="font-family:var(--font-playfair,'Playfair Display',serif);font-size:1.75rem;font-weight:600;color:var(--color-grafito,#2D2D2D);margin-bottom:1.5rem;text-align:center;">Preguntas Frecuentes sobre Reformas en Vitoria</h2>

      <details class="faq-item" style="margin-bottom:1rem;border:1px solid var(--color-beige,#E8E0D5);border-radius:8px;overflow:hidden;">
        <summary style="padding:1rem 1.25rem;background:white;cursor:pointer;font-weight:500;list-style:none;display:flex;justify-content:space-between;align-items:center;">
          ¿Cuánto cuesta reformar un piso en Vitoria en 2026?
          <span style="margin-left:1rem;flex-shrink:0;">+</span>
        </summary>
        <p style="padding:1rem 1.25rem;background:white;margin:0;line-height:1.6;border-top:1px solid var(--color-beige,#E8E0D5);">El precio medio de una reforma integral en Vitoria-Gasteiz oscila entre <strong>850 y 1.200 €/m²</strong> en 2026, dependiendo de la calidad de materiales y el estado del edificio. Para una reforma de cocina (12-15 m²) calcula entre 5.500 y 17.000 €, y para un baño completo entre 3.500 y 13.000 €.</p>
      </details>

      <details class="faq-item" style="margin-bottom:1rem;border:1px solid var(--color-beige,#E8E0D5);border-radius:8px;overflow:hidden;">
        <summary style="padding:1rem 1.25rem;background:white;cursor:pointer;font-weight:500;list-style:none;display:flex;justify-content:space-between;align-items:center;">
          ¿Qué incluye la calculadora de reformas de Vitoria?
          <span style="margin-left:1rem;flex-shrink:0;">+</span>
        </summary>
        <p style="padding:1rem 1.25rem;background:white;margin:0;line-height:1.6;border-top:1px solid var(--color-beige,#E8E0D5);">La calculadora incluye reforma completa de vivienda (básica, media o integral), reforma parcial por estancia (baño, cocina, pintura, suelo), metros cuadrados, antigüedad del edificio, calidad de materiales y extras opcionales como ventanas, aerotermia o domótica. El resultado incluye desglose por partidas y comparativa del precio medio en Vitoria.</p>
      </details>

      <details class="faq-item" style="margin-bottom:1rem;border:1px solid var(--color-beige,#E8E0D5);border-radius:8px;overflow:hidden;">
        <summary style="padding:1rem 1.25rem;background:white;cursor:pointer;font-weight:500;list-style:none;display:flex;justify-content:space-between;align-items:center;">
          ¿Necesito licencia para reformar en Vitoria?
          <span style="margin-left:1rem;flex-shrink:0;">+</span>
        </summary>
        <p style="padding:1rem 1.25rem;background:white;margin:0;line-height:1.6;border-top:1px solid var(--color-beige,#E8E0D5);">En Vitoria-Gasteiz las licencias de obra menor las gestiona el Ayuntamiento. Para reformas integrales o que afecten a la estructura, es necesaria licencia de obra mayor. Los edificios del Casco Viejo pueden tener protecciones patrimoniales adicionales. Consulta con tu empresa de reformas local.</p>
      </details>

      <p style="text-align:center;margin-top:1.5rem;color:var(--color-gris,#6B6B6B);font-size:0.9rem;">
        ¿Sabías que puedes <a href="/vitoria/blog/index.html">subvencionar parte de tu reforma en Vitoria</a>? Consulta las ayudas disponibles para Álava y el País Vasco.
      </p>
    </div>
  </section>
</CalculadoraLayout>

<script>
  import BilbaoCalc from '../../../scripts/calculator/core.ts';
  BilbaoCalc.setRegion('vitoria');
  BilbaoCalc.setTotalSteps(7); // 6 wizard steps + 1 result
  BilbaoCalc.init();

  // Scope cards (step 1)
  document.querySelectorAll('[data-scope]').forEach((el) => {
    el.addEventListener('click', () => {
      const scope = el.getAttribute('data-scope');
      if (scope) BilbaoCalc.selectScope(scope as any);
    });
  });

  // Type cards (step 1)
  document.querySelectorAll('[data-reform]').forEach((el) => {
    el.addEventListener('click', () => {
      const type = el.getAttribute('data-reform');
      if (type) BilbaoCalc.toggleReformType(type as any);
    });
  });

  // All nav buttons (next / back on every step)
  document.querySelectorAll('.wizard-nav-btn-next').forEach((btn) => {
    btn.addEventListener('click', () => {
      const step5Next = btn.closest('#step5')?.querySelector('.wizard-nav-btn-next');
      if (btn === step5Next) {
        BilbaoCalc.calculateAndShowResult();
      } else {
        BilbaoCalc.nextStep();
      }
    });
  });

  document.querySelectorAll('.wizard-nav-btn-back').forEach((btn) => {
    btn.addEventListener('click', () => BilbaoCalc.prevStep());
  });

  // Meters (step 2)
  const metersInput = document.getElementById('metersInput') as HTMLInputElement | null;
  const metersSlider = document.getElementById('metersSlider') as HTMLInputElement | null;
  metersInput?.addEventListener('input', () => BilbaoCalc.updateSqm(metersInput.value));
  metersSlider?.addEventListener('input', () => BilbaoCalc.updateSqm(metersSlider.value));

  document.querySelectorAll('.meters-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const m = parseInt((btn as HTMLButtonElement).dataset.meters ?? '80', 10);
      BilbaoCalc.updateSqm(m);
    });
  });

  // Building age options (step 3)
  document.querySelectorAll('#ageOptions .age-option').forEach((el) => {
    el.addEventListener('click', () => {
      const age = el.getAttribute('data-age');
      if (age) BilbaoCalc.updateBuildingAge(age as any);
    });
  });

  // Quality options (step 4)
  document.querySelectorAll('#qualityOptions .age-option').forEach((el) => {
    el.addEventListener('click', () => {
      const quality = el.getAttribute('data-quality');
      if (quality) BilbaoCalc.updateQuality(quality as any);
    });
  });

  // Extras (step 5)
  document.querySelectorAll('.extra-checkbox-item').forEach((el) => {
    el.addEventListener('click', () => {
      const key = el.getAttribute('data-extra');
      if (key) BilbaoCalc.toggleExtra(key);
    });
  });

  // Result buttons
  document.getElementById('downloadPdfBtn')?.addEventListener('click', () => BilbaoCalc.downloadPDF());
  document.getElementById('requestQuotesBtn')?.addEventListener('click', () => BilbaoCalc.requestQuotes());
  document.getElementById('btn-restart')?.addEventListener('click', () => BilbaoCalc.restart());

  // localStorage persistence: save on nav buttons (capturing phase)
  function saveVitoriaState() {
    const s = (BilbaoCalc as any).state;
    if (s && typeof (window as any).saveCalculatorState === 'function') {
      (window as any).saveCalculatorState(s.currentStep, { data: s.data, region: s.region });
    }
  }
  document.querySelectorAll('.wizard-nav-btn-next').forEach(btn => {
    btn.addEventListener('click', saveVitoriaState, true);
  });

  // Restore
  window.addEventListener('calculator:restore', (e: Event) => {
    const ev = e as CustomEvent<{ step: number; state: any }>;
    if (ev.detail?.state) {
      BilbaoCalc.restoreState?.(ev.detail.state);
    }
  });

  // Clear storage on result shown
  const _origShowResult = BilbaoCalc.calculateAndShowResult.bind(BilbaoCalc);
  BilbaoCalc.calculateAndShowResult = function() {
    _origShowResult();
    if (typeof (window as any).clearCalculatorState === 'function') (window as any).clearCalculatorState();
  };
</script>
