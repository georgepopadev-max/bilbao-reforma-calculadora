---
import CityLayout from '../../layouts/CityLayout.astro';
---
<CityLayout title="Reformas en Vitoria-Gasteiz 2026 | Bilbao Reforma" description="Guía completa de reformas en Vitoria-Gasteiz y Álara. Calcula presupuestos y descubre precios." canonical="https://www.bilbaoreforma.es/vitoria/reforma-vitoria.html" city="vitoria">
  <section style="max-width:800px;margin:4rem auto;padding:0 1.5rem;">
    <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.75rem,5vw,2.5rem);margin-bottom:1rem;">Reformas en Vitoria-Gasteiz 2026</h1>
    <p style="font-size:1.1rem;color:#555;margin-bottom:2rem;">Guía completa de reformas en Vitoria-Gasteiz y Álara.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem;">
      <a href="/vitoria/calculadora/index.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
        <h3 style="font-size:1.1rem;margin-bottom:0.5rem;display:flex;align-items:center;gap:0.4rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C45C3E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Reforma Integral
        </h3>
        <p style="font-size:0.9rem;color:#666;">Desde 700 €/m²</p>
      </a>
      <a href="/vitoria/calculadora/index.html" style="padding:1.5rem;background:#f5f5f5;border-radius:12px;text-decoration:none;color:inherit;">
        <h3 style="font-size:1.1rem;margin-bottom:0.5rem;display:flex;align-items:center;gap:0.4rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C45C3E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
          Reforma de Baño
        </h3>
        <p style="font-size:0.9rem;color:#666;">Desde 2.500 €</p>
      </a>
    </div>
    <a href="/vitoria/calculadora/index.html" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.5rem;background:#C45C3E;color:white;border-radius:8px;font-weight:600;text-decoration:none;">Calcular presupuesto →</a>
  </section>
</CityLayout>
