---
/**
 * Reforma Vitoria — City hub
 * A3 Zone — expanded TARE-051
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Reformas Vitoria',
  description: 'Guía completa de reformas en Vitoria-Gasteiz 2026. Precios, empresas y consejos.',
  url: 'https://www.bilbaoreforma.es/vitoria/',
  areaServed: { '@type': 'City', name: 'Vitoria-Gasteiz' },
};

const servicios = [
  { titulo: 'Reforma Integral', descripcion: 'Reconversión completa: electricidad, fontanería, albañilería, pintura y suelos. Vitoria tiene construcciones de los años 60-80 que necesitan actualización.', precio: 'Desde 650 €/m²', href: '/vitoria/calculadora/integral-vitoria.html', icono: '🏠' },
  { titulo: 'Reforma de Baño', descripcion: 'Cambio de sanitarios, platos de ducha, alicatados y fontanería. Los pisos vitorianos suelen tener baños de 3-5 m² con buena札会更好.', precio: 'Desde 2.300 €', href: '/vitoria/calculadora/bano-vitoria.html', icono: '🚿' },
  { titulo: 'Reforma de Cocina', descripcion: 'Cambio de muebles, encimera, electrodomésticos y distribución. Los pisos de Lakua y Salburua suelen tener cocinas de 8-12 m² amplios.', precio: 'Desde 4.800 €', href: '/vitoria/calculadora/cocina-vitoria.html', icono: '🍳' },
  { titulo: 'Pintura Integral', descripcion: 'Paredes, techos y puertas. En Vitoria el aislamiento térmico de los edificios nuevos hace que la pintura sea más económica que en edificios antiguos.', precio: 'Desde 7 €/m²', href: '/vitoria/calculadora/pintura-vitoria.html', icono: '🎨' },
  { titulo: 'Cambio de Suelo', descripcion: 'Parqué, porcelánico o laminado. Los edificios de los 70 en Coronación y San Martín tienen pallanda de madera que puede rehabilitarse.', precio: 'Desde 32 €/m²', href: '/vitoria/calculadora/suelo-vitoria.html', icono: '🪵' },
];

const pasos = [
  { num: '1', titulo: 'Usa la calculadora', descripcion: 'Selecciona el tipo de reforma, introduce los metros cuadrados y responde 5 preguntas sobre el estado actual.' },
  { num: '2', titulo: 'Recibe tu informe', descripcion: 'Recibe un PDF con el desglose por partidas adaptado a precios de Vitoria y recomendaciones de empresas.' },
  { num: '3', titulo: 'Contacta empresas', descripcion: 'Llamas directamente a las empresas recomendadas. Sin intermediarios ni compromiso.' },
];
---

<BaseLayout
  title="Reformas Vitoria 2026: Guía Completa y Precios Orientativos"
  description="Guía completa de reformas en Vitoria-Gasteiz 2026. Calcula presupuestos, compara precios y encuentra empresas verificadas en Álava."
  canonical="https://www.bilbaoreforma.es/vitoria/"
  ogImage="https://www.bilbaoreforma.es/images/og/vitoria-og.jpg"
  ogImageAlt="Reformas Vitoria 2026"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Header city="vitoria" section="reformas" />
  <main id="main-content">

    <section style="background: var(--color-crema); padding: 3rem 1.5rem;">
      <div style="max-width: 900px; margin: 0 auto;">
        <h1 style="font-family: 'Playfair Display', serif; font-size: clamp(1.75rem, 5vw, 2.75rem); color: var(--color-grafito); margin-bottom: 1rem; line-height: 1.25;">Reformas en Vitoria-Gasteiz 2026</h1>
        <p style="font-size: 1.0625rem; color: var(--color-gris); line-height: 1.7; max-width: 640px; margin-bottom: 1.5rem;">Vitoria-Gasteiz tiene uno de los parques inmobiliarios más modernos del País Vasco, pero los edificios de los años 60 a 90 necesitan reformas. Esta guía te ayuda a calcular presupuestos orientativos y encontrar empresas de reformas verificadas en Álava.</p>
        <a href="/vitoria/calculadora/integral-vitoria.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.5rem; background: var(--color-terracota); color: white; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9375rem;">Calcular presupuesto gratis →</a>
      </div>
    </section>

    <section style="max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem;">
      <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(1.375rem, 4vw, 1.875rem); color: var(--color-grafito); margin-bottom: 2rem; text-align: center;">¿Qué tipo de reforma necesitas?</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
        {servicios.map(s => (
          <a href={s.href} style="display: block; padding: 1.5rem; background: var(--color-blanco); border: 1px solid var(--color-beige); border-radius: 12px; text-decoration: none; color: inherit; transition: all 0.2s; box-shadow: 0 2px 8px rgba(45,30,15,.06);">
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">{s.icono}</div>
            <h3 style="font-size: 1rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.5rem;">{s.titulo}</h3>
            <p style="font-size: 0.875rem; color: var(--color-gris); line-height: 1.6; margin-bottom: 0.75rem;">{s.descripcion}</p>
            <p style="font-size: 0.9375rem; font-weight: 700; color: var(--color-terracota);">{s.precio}</p>
          </a>
        ))}
      </div>
    </section>

    <section style="background: var(--color-blanco); padding: 3rem 1.5rem;">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(1.375rem, 4vw, 1.875rem); color: var(--color-grafito); margin-bottom: 2rem; text-align: center;">Cómo funciona</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem;">
          {pasos.map(p => (
            <div style="text-align: center;">
              <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--color-terracota); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.125rem; font-weight: 700; margin: 0 auto 0.75rem;">{p.num}</div>
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--color-grafito); margin-bottom: 0.5rem;">{p.titulo}</h3>
              <p style="font-size: 0.875rem; color: var(--color-gris); line-height: 1.6;">{p.descripcion}</p>
            </div>
          ))}
        </div>
        <div style="text-align: center; margin-top: 2rem;">
          <a href="/vitoria/calculadora/integral-vitoria.html" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.5rem; background: var(--color-terracota); color: white; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9375rem;">Empezar ahora →</a>
        </div>
      </div>
    </section>

    <section style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem;">
      <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(1.375rem, 4vw, 1.875rem); color: var(--color-grafito); margin-bottom: 1.5rem; text-align: center;">Barrios de Vitoria</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;">
        {['Casco Viejo', 'Coronación', 'San Martín', 'Zaramaga', 'Lakua', 'Salburua', 'Eat', 'Mendizorroza', 'Arriaga', 'Adurza'].map(n => (
          <span style="padding: 0.4rem 0.875rem; background: var(--color-crema); border: 1px solid var(--color-beige); border-radius: 999px; font-size: 0.8125rem; color: var(--color-gris);">{n}</span>
        ))}
      </div>
    </section>

  </main>
  <Footer city="vitoria" />
</BaseLayout>
