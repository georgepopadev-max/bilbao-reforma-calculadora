---
import CitySwitcher from './CitySwitcher.astro';

export interface Props {
  city?: 'bilbao' | 'donostia' | 'vitoria';
  section?: 'root' | 'blog' | 'calculadora' | 'empresas';
}

const { city = 'bilbao', section = 'root' } = Astro.props;

// Calculate path depth based on city and current section
// Bilbao root: depth = ''
// Bilbao section (blog/calculadora/empresas): depth = '../'
// Donostia/Vitoria any section: depth = '../../'
const depth = city === 'bilbao' && section === 'root' ? '' :
              city === 'bilbao' && section !== 'root' ? '../' :
              '../../'; // donostia or vitoria, any section

// Build nav links using depth
const calcHref = `${depth}calculadora/index.html`;
const blogHref = `${depth}blog/index.html`;
const empresasHref = `${depth}empresas/index.html`;
const contactoHref = section === 'root' ? 'contacto.html' : `${depth}contacto.html`;

// Logo always goes to city index
const cityIndexHref = city === 'bilbao' ? `${depth}index.html` : `${depth}../index.html`;

// City switcher links
const cities = [
  { name: 'Bilbao', href: city === 'bilbao' ? '#' : '../index.html', active: city === 'bilbao' },
  { name: 'Donostia', href: city === 'donostia' ? '#' : '../donostia/index.html', active: city === 'donostia' },
  { name: 'Vitoria', href: city === 'vitoria' ? '#' : '../vitoria/index.html', active: city === 'vitoria' },
];

const currentPath = Astro.url.pathname;
const isBlogActive = currentPath.includes('/blog');
const isCalcActive = currentPath.includes('/calculadora');
const isEmpresasActive = currentPath.includes('/empresas');
---

<header class="site-header">
  <div class="header-container">
    <a href={cityIndexHref} class="header-logo">
      <svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span class="header-logo-text">Bilbao Reforma</span>
    </a>
    <nav class="header-nav">
      <a href={calcHref} class={`header-nav-link${isCalcActive ? ' header-nav-link-active' : ''}`}>Calculadora</a>
      <a href={blogHref} class={`header-nav-link${isBlogActive ? ' header-nav-link-active' : ''}`}>Blog</a>
      <a href={empresasHref} class={`header-nav-link${isEmpresasActive ? ' header-nav-link-active' : ''}`}>Empresas</a>
      <a href={contactoHref} class="header-nav-link header-nav-link-cta">Contacto</a>
    </nav>
    <button class="header-mobile-toggle" id="mobileToggle" aria-label="Abrir menú" aria-expanded="false">
      <svg class="header-mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <nav class="mobile-nav">
    <a href={calcHref} class="mobile-nav-link">Calculadora</a>
    <a href={blogHref} class="mobile-nav-link">Blog</a>
    <a href={empresasHref} class="mobile-nav-link">Empresas</a>
    <a href={contactoHref} class="mobile-nav-link">Contacto</a>
  </nav>
</div>

<script>
  const toggle = document.getElementById('mobileToggle');
  const menu = document.getElementById('mobileMenu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('open', !expanded);
  });
</script>

<style>
  .site-header {
    background: var(--color-blanco);
    border-bottom: 1px solid var(--color-beige);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-grafito);
  }
  .header-logo-icon {
    width: 28px;
    height: 28px;
    color: var(--color-terracota);
    flex-shrink: 0;
  }
  .header-logo-text {
    font-family: var(--font-playfair);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .header-nav {
    display: none;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .header-nav { display: flex; }
    .header-mobile-toggle { display: none; }
  }
  .header-nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gris);
    text-decoration: none;
    transition: color 0.2s;
  }
  .header-nav-link:hover { color: var(--color-terracota); text-decoration: none; }
  .header-nav-link-active { color: var(--color-terracota); font-weight: 600; }
  .header-nav-link-cta {
    font-size: 0.875rem;
    font-weight: 600;
    background: var(--color-terracota);
    color: var(--color-blanco) !important;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-button);
    text-decoration: none;
  }
  .header-nav-link-cta:hover { background: var(--color-terracota-hover); }
  .header-mobile-toggle {
    padding: 0.5rem;
    color: var(--color-grafito);
    border-radius: var(--radius-button);
  }
  .mobile-menu {
    display: none;
    background: var(--color-blanco);
    border-top: 1px solid var(--color-beige);
    padding: 1rem;
  }
  .mobile-menu.open { display: block; }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .mobile-nav-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-grafito);
    text-decoration: none;
    padding: 0.75rem;
    border-radius: var(--radius-button);
    transition: background 0.2s;
  }
  .mobile-nav-link:hover { background: var(--color-crema); text-decoration: none; }
</style>
