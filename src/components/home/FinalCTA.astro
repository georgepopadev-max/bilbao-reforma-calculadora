    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/calculadora.html" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-terracota); color: white; padding: 1rem 2rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 1rem; box-shadow: 0 4px 14px rgba(196,92,62,0.4);">Calcular presupuesto gratis</a>
      <a href="/empresas.html" style="display: inline-flex; align-items: center; padding: 1rem 2rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 1rem; color: white; border: 2px solid rgba(255,255,255,0.4);">Ver empresas de reformas</a>
    </div>
