---
// WhyUs — "Por qué Bilbao Reforma" differentiators section
interface Props {
  city?: 'bilbao' | 'donostia' | 'vitoria';
}

const { city = 'bilbao' } = Astro.props;

const cityConfig = {
  bilbao: {
    heading: 'Por qué Bilbao Reforma',
    region: 'Bilbao y Bizkaia',
  },
  donostia: {
    heading: '¿Por qué Reforma Donostia?',
    region: 'Donostia y Gipuzkoa',
  },
  vitoria: {
    heading: '¿Por qué Reforma Vitoria?',
    region: 'Vitoria y Álava',
  },
};

const config = cityConfig[city];
---

<section class="home-section home-section-alt">
  <h2 style="font-size: 1.375rem; font-weight: 700; color: #1E293B; font-family: 'Playfair Display', serif; margin-bottom: 1.5rem;">{config.heading}</h2>
  <div class="differentiators-grid">
    <div class="differentiator-card">
      <div class="differentiator-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <h4 class="differentiator-title">Datos locales de {config.region}</h4>
      <p class="differentiator-desc">Precios basados en datos reales de empresas de reformas en {config.region}, no en tablas genéricas de internet.</p>
    </div>
    <div class="differentiator-card">
      <div class="differentiator-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>
      <h4 class="differentiator-title">Resultados inmediatos</h4>
      <p class="differentiator-desc">Sin formularios interminables ni esperas. Introduce tus datos y obtén tu presupuesto en segundos.</p>
    </div>
    <div class="differentiator-card">
      <div class="differentiator-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <path d="M3 9h18"></path>
          <path d="M3 15h18"></path>
          <path d="M9 3v18"></path>
          <path d="M15 3v18"></path>
        </svg>
      </div>
      <h4 class="differentiator-title">Transparencia total</h4>
      <p class="differentiator-desc">Desglose completo por partidas para que sepas exactamente dónde va tu dinero.</p>
    </div>
    <div class="differentiator-card">
      <div class="differentiator-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </div>
      <h4 class="differentiator-title">Empresas verificadas</h4>
      <p class="differentiator-desc">Conectamos con empresas locales recomendadas que han hecho reformas en {config.region}.</p>
    </div>
  </div>
</section>

<style>
  .home-section-alt {
    background: var(--color-crema);
    border-radius: 20px;
    margin: 0 1.5rem 2rem;
    max-width: calc(1200px - 3rem);
  }
  .differentiators-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .differentiators-grid { grid-template-columns: 1fr; }
  }
  .differentiator-card {
    background: white;
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 2px 8px rgba(30,41,59,0.04);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .differentiator-icon {
    width: 48px;
    height: 48px;
    background: var(--color-crema);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-terracota);
  }
  .differentiator-icon svg { width: 24px; height: 24px; }
  .differentiator-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-grafito);
    margin: 0;
  }
  .differentiator-desc {
    font-size: 0.875rem;
    color: var(--color-gris);
    line-height: 1.6;
    margin: 0;
  }
</style>
