---
// FeaturedCities — Bilbao/Donostia/Vitoria cities grid
---
<section style="padding: 3rem 1.5rem; background: white;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <h2 style="font-size: 1.75rem; font-weight: 700; color: #1E293B; font-family: 'Playfair Display', serif; margin-bottom: 0.5rem; text-align: center;">Calculadora de Reformas en el País Vasco</h2>
    <p style="text-align: center; color: #64748b; font-size: 1rem; max-width: 640px; margin: 0 auto 2.5rem; line-height: 1.7;">Usa nuestra herramienta gratuita para calcular presupuestos orientativos en cualquiera de las tres capitales vascas.</p>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
      <!-- Bilbao -->
      <a href="/index.html" style="display: flex; flex-direction: column; padding: 2rem; border-radius: 20px; border: 2px solid var(--color-terracota); background: linear-gradient(135deg, rgba(196,92,62,0.05) 0%, rgba(196,92,62,0.02) 100%); text-decoration: none; position: relative; overflow: hidden;">
        <div style="position: absolute; top: 1rem; right: 1rem; font-size: 0.75rem; font-weight: 600; background: var(--color-terracota); color: white; padding: 0.25rem 0.625rem; border-radius: 999px;">Estás aquí</div>
        <div style="font-size: 2rem; margin-bottom: 0.75rem;">📍</div>
        <h3 style="font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: var(--color-grafito); margin: 0 0 0.375rem;">Bilbao</h3>
        <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0 0 1rem;">Vizcaya · Bizkaia</p>
        <p style="font-size: 0.875rem; color: var(--color-terracota); font-weight: 600; margin: auto 0 0;">Calcular presupuesto →</p>
      </a>
      <!-- Donostia -->
      <a href="/donostia/index.html" style="display: flex; flex-direction: column; padding: 2rem; border-radius: 20px; border: 2px solid #e2e8f0; background: white; text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
        <div style="font-size: 2rem; margin-bottom: 0.75rem;">📍</div>
        <h3 style="font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: var(--color-grafito); margin: 0 0 0.375rem;">Donostia</h3>
        <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0 0 1rem;">Guipúzcoa · Gipuzkoa</p>
        <p style="font-size: 0.875rem; color: var(--color-terracota); font-weight: 600; margin: auto 0 0;">Ver calculadora →</p>
      </a>
      <!-- Vitoria -->
      <a href="/vitoria/index.html" style="display: flex; flex-direction: column; padding: 2rem; border-radius: 20px; border: 2px solid #e2e8f0; background: white; text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
        <div style="font-size: 2rem; margin-bottom: 0.75rem;">📍</div>
        <h3 style="font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: var(--color-grafito); margin: 0 0 0.375rem;">Vitoria-Gasteiz</h3>
        <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0 0 1rem;">Álava · Araba</p>
        <p style="font-size: 0.875rem; color: var(--color-terracota); font-weight: 600; margin: auto 0 0;">Ver calculadora →</p>
      </a>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
  }
  a[style*="border: 2px solid #e2e8f0"]:hover {
    border-color: var(--color-terracota) !important;
    box-shadow: 0 4px 16px rgba(196,92,62,0.12);
  }
</style>
