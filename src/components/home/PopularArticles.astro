---
// PopularArticles — sidebar with 5 popular blog articles, optionally filtered by city
interface Props {
  city?: 'bilbao' | 'donostia' | 'vitoria';
}

const { city = 'bilbao' } = Astro.props;

const articlesByCity = {
  bilbao: [
    { slug: 'precio-reforma-integral-bilbao', title: 'Precio Reforma Integral Bilbao 2026: Guía Completa', read: '8 min', icon: 'home' },
    { slug: 'reforma-cocina-bilbao', title: 'Reforma de Cocina en Bilbao: Precios y Consejos', read: '6 min', icon: 'kitchen' },
    { slug: 'pintar-piso-bilbao', title: 'Pintar un Piso en Bilbao: Cuánto Cuesta en 2026', read: '5 min', icon: 'paint' },
    { slug: 'subvenciones-reformas-bilbao-2026', title: 'Subvenciones para Reformas en Bilbao 2026', read: '7 min', icon: 'money' },
    { slug: 'reformas-casco-viejo-bilbao', title: 'Reformas en el Casco Viejo de Bilbao: Guía Completa', read: '9 min', icon: 'building' },
  ],
  donostia: [
    { slug: 'reforma-bano-donostia', title: 'Reforma de Baño en Donostia: Precios y Consejos', read: '6 min', icon: 'bath' },
    { slug: 'reforma-cocina-donostia', title: 'Reforma de Cocina en Donostia: Precios y Consejos', read: '6 min', icon: 'kitchen' },
    { slug: 'pintar-piso-donostia', title: 'Pintar un Piso en Donostia: Cuánto Cuesta en 2026', read: '5 min', icon: 'paint' },
    { slug: 'cambiar-suelo-donostia', title: 'Cambiar el Suelo en Donostia: Guía de Precios 2026', read: '7 min', icon: 'floor' },
    { slug: 'subvenciones-reformas-donostia', title: 'Subvenciones para Reformas en Donostia 2026', read: '7 min', icon: 'money' },
  ],
  vitoria: [
    { slug: 'reforma-bano-vitoria', title: 'Reforma de Baño en Vitoria: Precios y Consejos', read: '6 min', icon: 'bath' },
    { slug: 'reforma-cocina-vitoria', title: 'Reforma de Cocina en Vitoria: Precios y Consejos', read: '6 min', icon: 'kitchen' },
    { slug: 'pintar-piso-vitoria', title: 'Pintar un Piso en Vitoria: Cuánto Cuesta en 2026', read: '5 min', icon: 'paint' },
    { slug: 'cambiar-suelo-vitoria', title: 'Cambiar el Suelo en Vitoria: Guía de Precios 2026', read: '7 min', icon: 'floor' },
    { slug: 'subvenciones-reformas-vitoria', title: 'Subvenciones para Reformas en Vitoria 2026', read: '7 min', icon: 'money' },
  ],
};

const articles = articlesByCity[city] ?? articlesByCity.bilbao;

const iconSvgs: Record<string, string> = {
  home: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>',
  kitchen: '<path d="M3 11h18M5 11V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6"></path>',
  paint: '<path d="M19 11H5a4 4 0 0 0-4 4v0a4 4 0 0 0 4 4h.5"></path><path d="M12 11V3"></path>',
  money: '<line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>',
  building: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>',
  bath: '<path d="M9 6 Q9 2 12 2 Q15 2 15 6 L15 8 L9 8 Z"></path><rect x="6" y="8" width="12" height="5" rx="1"></rect><path d="M6 13v3h12v-3"></path>',
  floor: '<path d="M3 21h18M3 18h18M3 15h18M3 12h18M3 9h18M3 6h18M3 3h18"></path>',
};
---

<div style="display: flex; flex-direction: column; gap: 0.5rem;">
  <h3 style="font-size: 1.125rem; font-weight: 700; color: #1E293B; font-family: 'Playfair Display', serif; margin-bottom: 1rem;">Artículos populares</h3>
  {articles.map((article) => (
    <a href={`/blog/${article.slug}.html`} style="display: flex; gap: 0.875rem; padding: 0.75rem 0; border-bottom: 1px solid var(--color-beige); text-decoration: none; align-items: flex-start;">
      <div style="width: 44px; height: 44px; background: var(--color-crema); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--color-terracota);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvgs[article.icon] ?? iconSvgs['home']}></svg>
      </div>
      <div>
        <h4 style="font-size: 0.875rem; font-weight: 500; color: var(--color-grafito); line-height: 1.4; margin: 0 0 0.25rem;">{article.title}</h4>
        <span style="font-size: 0.75rem; color: var(--color-gris);">Lectura: {article.read}</span>
      </div>
    </a>
  ))}
  <a href="/blog/index.html" style="display: inline-flex; align-items: center; gap: 0.375rem; color: var(--color-terracota); text-decoration: none; font-size: 0.875rem; font-weight: 600; margin-top: 0.5rem;">Ver todos los artículos <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
</div>
