---
// VerifiedCompaniesCity — Empresas de Reformas Verificadas for Donostia/Vitoria
interface Props {
  city: 'donostia' | 'vitoria';
}

const { city } = Astro.props;

const cityConfig = {
  donostia: {
    region: 'Donostia / Gipuzkoa',
    heading: 'Empresas de Reformas Verificadas en Donostia',
    ctaText: 'Ver directorio de empresas en Bilbao',
    ctaHref: '/empresas/index.html',
  },
  vitoria: {
    region: 'Vitoria-Gasteiz / Álava',
    heading: 'Empresas de Reformas Verificadas en Vitoria',
    ctaText: 'Ver directorio de empresas en Bilbao',
    ctaHref: '/empresas/index.html',
  },
};

const config = cityConfig[city];
---

<section style="padding: 4rem 1.5rem; background: #f8fafc; text-align: center;">
  <div style="max-width: 800px; margin: 0 auto;">
    <h2 style="font-size: 2rem; font-weight: 700; color: #1E293B; font-family: 'Playfair Display', serif; margin-bottom: 1rem;">{config.heading}</h2>
    <p style="max-width: 600px; margin: 1rem auto 2rem; color: #334155; font-size: 1.05rem; line-height: 1.7;">
      Próximamente verificaremos empresas de reformas en {config.region}. Mientras tanto, consulta nuestro directorio de empresas verificadas en Bilbao — 6 empresas con reseñas reales de clientes.
    </p>
    <div style="display: inline-flex; align-items: center; gap: 0.75rem; background: white; border: 1px solid var(--color-beige); border-radius: 12px; padding: 1.5rem 2rem; text-align: left; max-width: 480px; margin-bottom: 2rem;">
      <div style="width: 48px; height: 48px; background: var(--color-crema); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-terracota)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <div>
        <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin: 0 0 0.25rem;">Directorio en preparación</p>
        <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0;">Estamos verificando empresas locales para garantizar reseñas y datos reales.</p>
      </div>
    </div>
    <br />
    <a href={config.ctaHref} style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-terracota); color: white; padding: 1rem 2rem; border-radius: 999px; text-decoration: none; font-weight: 600; box-shadow: 0 2px 8px rgba(196,92,62,0.3); font-size: 1rem;">{config.ctaText} →</a>
  </div>
</section>
