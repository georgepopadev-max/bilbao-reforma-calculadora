---
// VerifiedCompanies — bloque de directorio en la home: enlaza a las páginas de cada tipo de obra
const SERVICIOS = [
  { name: 'Reforma integral', href: '/presupuesto-reforma-integral-bilbao', text: 'Pisos completos con instalaciones, distribución y acabados nuevos.' },
  { name: 'Reforma de baño', href: '/presupuesto-reforma-bano-bilbao', text: 'Cambio de bañera por ducha, sanitarios, alicatado y fontanería.' },
  { name: 'Reforma de cocina', href: '/presupuesto-reforma-cocina-bilbao', text: 'Muebles, encimera, electrodomésticos e instalaciones.' },
  { name: 'Pintura', href: '/presupuesto-pintura-piso-bilbao', text: 'Pintar un piso completo, alisar gotelé y techos.' },
  { name: 'Suelos', href: '/presupuesto-cambio-suelo-bilbao', text: 'Porcelánico, vinílico, laminado o tarima.' },
  { name: 'Calefacción', href: '/calefaccion-bilbao', text: 'Calderas, aerotermia y suelo radiante.' },
];
---
<section style="padding: 4rem 1.5rem; background: #f8fafc; text-align: center;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <h2 style="font-size: 2rem; font-weight: 700; color: #1E293B; font-family: 'Playfair Display', serif; margin-bottom: 1rem;">Empresas de Reformas en Bilbao</h2>
    <p style="max-width: 700px; margin: 1rem auto 2.5rem; color: #334155; font-size: 1.05rem; line-height: 1.7;">Consulta nuestro directorio de empresas de reformas por especialidad y pide presupuesto sin compromiso a varias a la vez, en Bilbao, Donostia y Vitoria.</p>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; max-width: 800px; margin: 0 auto 2rem;">
      {SERVICIOS.map((s) => (
        <a href={s.href} style="display: block; background: white; border-radius: 12px; padding: 1.25rem; box-shadow: 0 2px 6px rgba(30,41,59,0.06); text-align: left; text-decoration: none;">
          <p style="font-weight: 600; font-size: 0.9375rem; color: var(--color-grafito); margin: 0 0 0.25rem;">{s.name}</p>
          <p style="font-size: 0.8125rem; color: var(--color-gris); margin: 0; line-height: 1.5;">{s.text}</p>
        </a>
      ))}
    </div>
    <a href="/empresas" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-terracota); color: white; padding: 1rem 2rem; border-radius: 999px; text-decoration: none; font-weight: 600; box-shadow: 0 2px 8px rgba(196,92,62,0.3); font-size: 1rem;">Ver todas las empresas de reformas →</a>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 480px) {
    div[style*="grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
