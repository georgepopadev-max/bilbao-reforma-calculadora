---
export interface Props {
  caption?: string;
  headers: string[];
  rows: string[][];
  city?: string;
}

const { caption, headers, rows, city = 'bilbao' } = Astro.props;
---
<table class="price-table">
  {caption && <caption>{caption}</caption>}
  <thead>
    <tr>
      {headers.map(h => <th>{h}</th>)}
    </tr>
  </thead>
  <tbody>
    {rows.map(row => (
      <tr>
        {row.map((cell, i) => (
          <td class={i === 0 ? 'city-badge' : ''}>{cell}</td>
        ))}
      </tr>
    ))}
  </tbody>
</table>