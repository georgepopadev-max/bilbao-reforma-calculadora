---
export interface Props {
  items: Array<{ name: string; href: string }>;
}

const { items } = Astro.props;
---
<nav class="article-breadcrumb" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <>
      {i > 0 && <span aria-hidden="true">/</span>}
      {i < items.length - 1 ? (
        <a href={item.href}>{item.name}</a>
      ) : (
        <span>{item.name}</span>
      )}
    </>
  ))}
</nav>