---
/**
 * StepFinal — Shared budget result + Axonflow lead capture.
 * Redesigned 2026-07-06: mobile-first, responsive donut, premium look.
 *
 * Each calculator page sets data-budget-low/high/label on this element before
 * showing it, then StepFinal renders the doughnut, PDF button, and lead form.
 */
---

<div
  class="step-final"
  id="stepFinal"
  data-step="final"
  data-calculator-type={Astro.props.calculatorType}
  data-city={Astro.props.city}
  data-budget-low={Astro.props.budgetLow}
  data-budget-high={Astro.props.budgetHigh}
  data-budget-label={Astro.props.budgetLabel}
>
  <!-- Loading state -->
  <div class="sf-loading" id="stepFinalLoading">
    <div class="sf-spinner"></div>
    <p>Calculando tu presupuesto...</p>
  </div>

  <!-- Revealed after budget is set -->
  <div class="sf-content" id="stepFinalContent" style="display:none;">

    <!-- Header: badge + title + big price range -->
    <header class="sf-header">
      <span class="sf-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        Presupuesto estimado
      </span>
      <h2 class="sf-title">Tu reforma cuesta entre</h2>
      <div class="sf-range" aria-live="polite">
        <span class="sf-range-low" id="finalRangeLow">—</span>
        <span class="sf-range-sep">y</span>
        <span class="sf-range-high" id="finalRangeHigh">—</span>
      </div>
      <p class="sf-meta" id="finalMeta">—</p>
    </header>

    <!-- Donut chart + legend -->
    <div class="sf-chart-wrap" id="finalBudget" aria-label="Desglose del presupuesto"></div>

    <!-- Action buttons -->
    <div class="sf-actions">
      <button class="sf-btn sf-btn-primary" id="downloadPdfBtn" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Descargar PDF
      </button>
      <button class="sf-btn sf-btn-secondary" id="requestQuotesBtn" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Solicitar 3 presupuestos
      </button>
    </div>

    <!-- Lead capture form -->
    <div class="sf-leadform">
      <h3 class="sf-leadform-title">Recibe el desglose completo por email</h3>
      <p class="sf-leadform-desc">Te enviamos un PDF personalizado + 3 cotizaciones de empresas verificadas en tu ciudad.</p>

      <form id="leadCaptureForm" class="lf-form" novalidate>
        <div class="lf-row">
          <label class="lf-field">
            <span class="lf-label">Email</span>
            <input type="email" id="leadEmail" name="email" required placeholder="tu@email.com" autocomplete="email" />
          </label>
          <label class="lf-field">
            <span class="lf-label">Teléfono</span>
            <input type="tel" id="leadPhone" name="phone" required placeholder="+34 600 000 000" autocomplete="tel" pattern="^\+?[0-9\s\-]{8,20}$" />
          </label>
        </div>
        <label class="lf-checkbox">
          <input type="checkbox" id="leadConsent" name="consent" required />
          <span>Acepto recibir el desglose y ofertas de empresas de reformas. Puedo darme de baja en cualquier momento.</span>
        </label>
        <button type="submit" id="leadSubmitBtn" class="lf-submit">
          Recibir desglose completo
        </button>
        <p class="lf-feedback" id="leadFeedback"></p>
      </form>
    </div>

    <!-- Disclaimer -->
    <p class="sf-disclaimer">
      Presupuesto orientativo, basado en precios reales del mercado vasco 2026. Varia +-15% segun caracteristicas especificas. Solicita cotizaciones personalizadas a empresas verificadas.
    </p>

    <!-- Navigation -->
    <nav class="sf-nav">
      <button class="sf-nav-btn sf-nav-btn-back" id="btn-back-final" type="button">
        &#8592; Modificar
      </button>
      <button class="sf-nav-btn sf-nav-btn-next" id="btn-restart-final" type="button">
        Nuevo calculo &#8594;
      </button>
    </nav>
  </div>
</div>

<style>
  /* ============================================================
     STEP FINAL — MOBILE-FIRST PREMIUM RESULT SCREEN
     Breakpoints: 375px base → 640px → 768px → 1024px
     ============================================================ */

  .step-final {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    font-family: var(--font-inter);
  }

  /* ---- LOADING ---- */
  .sf-loading {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-gris);
  }
  .sf-spinner {
    width: 44px;
    height: 44px;
    border: 3px solid var(--color-beige);
    border-top-color: var(--color-terracota);
    border-radius: 50%;
    animation: sf-spin 0.8s linear infinite;
    margin: 0 auto 1rem;
  }
  @keyframes sf-spin { to { transform: rotate(360deg); } }

  /* ---- HEADER ---- */
  .sf-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .sf-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: var(--color-verde-montana-light);
    color: var(--color-verde-montana);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 0.875rem;
    letter-spacing: 0.01em;
  }

  .sf-title {
    font-family: var(--font-playfair);
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--color-grafito);
    margin-bottom: 0.625rem;
    font-weight: 600;
    line-height: 1.25;
  }

  /* Price range — always large and readable */
  .sf-range {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-playfair);
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .sf-range-low {
    color: var(--color-grafito);
  }
  .sf-range-sep {
    font-size: clamp(1.25rem, 3.5vw, 1.875rem);
    color: var(--color-gris);
    font-weight: 400;
  }
  .sf-range-high {
    color: var(--color-verde-montana);
  }

  .sf-meta {
    font-size: 0.8125rem;
    color: var(--color-gris);
    line-height: 1.4;
  }

  /* ---- CHART WRAP ---- */
  /* Mobile-first: stacked (375px) */
  .sf-chart-wrap {
    background: var(--color-blanco);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.5rem 1rem;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .sf-chart-wrap {
      padding: 2rem 1.5rem;
    }
  }

  /* ============================================================
     BUDGET CHART — Donut + Legend (generated by budget-chart.ts)
     ============================================================ */

  :global(.budget-chart) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) {
    :global(.budget-chart) {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
    }
  }

  /* SVG container — holds SVG + center text + tooltip */
  :global(.budget-chart-svg) {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.budget-chart-center) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  :global(.budget-chart-label) {
    font-size: 0.625rem;
    color: var(--color-gris);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-inter);
    font-weight: 600;
  }

  :global(.budget-chart-total) {
    font-family: var(--font-playfair);
    font-size: clamp(1.375rem, 4vw, 1.875rem);
    font-weight: 700;
    color: var(--color-grafito);
    font-feature-settings: "tnum" 1;
    margin-top: 0.2rem;
    line-height: 1.1;
    white-space: nowrap;
  }

  /* Tooltip — clamped inside container */
  :global(.budget-chart-tooltip) {
    position: absolute;
    background: var(--color-grafito);
    color: var(--color-blanco);
    padding: 6px 11px;
    border-radius: 8px;
    font-size: 0.8125rem;
    pointer-events: none;
    transform: translate(-50%, -100%);
    margin-top: -10px;
    white-space: nowrap;
    z-index: 10;
    font-family: var(--font-inter);
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s;
    max-width: min(220px, calc(100vw - 2rem));
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.budget-chart-tooltip.visible) {
    opacity: 1;
  }

  :global(.budget-chart-tooltip::after) {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--color-grafito);
  }

  /* Donut segments */
  :global(.budget-chart-segment) {
    cursor: pointer;
    transition: opacity 0.2s;
  }

  :global(.budget-chart-segment:hover),
  :global(.budget-chart-segment.active) {
    opacity: 0.8;
  }

  /* Legend */
  :global(.budget-legend) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  @media (min-width: 640px) {
    :global(.budget-legend) {
      width: auto;
    }
  }

  :global(.budget-legend-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    min-width: 0;
  }

  :global(.budget-legend-dot) {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  :global(.budget-legend-label) {
    flex: 1;
    color: var(--color-grafito);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  :global(.budget-legend-pct) {
    color: var(--color-gris);
    font-weight: 600;
    font-feature-settings: "tnum" 1;
    flex-shrink: 0;
  }

  :global(.budget-legend-amount) {
    color: var(--color-gris);
    font-size: 0.75rem;
    font-feature-settings: "tnum" 1;
    flex-shrink: 0;
  }


  /* ---- ACTION BUTTONS ---- */
  /* Mobile-first: stacked */
  .sf-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 480px) {
    .sf-actions {
      flex-direction: row;
    }
  }

  .sf-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border: none;
    border-radius: var(--radius-button);
    font-weight: 700;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all var(--transition-base);
    text-decoration: none;
    white-space: nowrap;
  }

  .sf-btn-primary {
    background: var(--color-terracota);
    color: var(--color-blanco);
    box-shadow: 0 4px 14px rgba(196, 92, 62, 0.35);
  }
  .sf-btn-primary:hover {
    background: var(--color-terracota-hover);
    box-shadow: 0 6px 20px rgba(196, 92, 62, 0.4);
    transform: translateY(-1px);
  }
  .sf-btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(196, 92, 62, 0.3);
  }

  .sf-btn-secondary {
    background: var(--color-blanco);
    color: var(--color-grafito);
    border: 2px solid var(--color-beige);
  }
  .sf-btn-secondary:hover {
    border-color: var(--color-terracota);
    color: var(--color-terracota);
    transform: translateY(-1px);
  }

  /* ---- LEAD FORM ---- */
  .sf-leadform {
    background: linear-gradient(135deg, var(--color-verde-montana-light), #EEF5EC);
    border: 1px solid var(--color-verde-montana);
    border-radius: var(--radius-card);
    padding: 1.75rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .sf-leadform-title {
    font-family: var(--font-playfair);
    font-size: 1.1875rem;
    color: var(--color-grafito);
    margin-bottom: 0.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .sf-leadform-desc {
    color: var(--color-gris);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .lf-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 480px) {
    .lf-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lf-field {
    display: block;
  }

  .lf-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-grafito);
    margin-bottom: 0.25rem;
  }

  .lf-form input[type="email"],
  .lf-form input[type="tel"] {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 2px solid var(--color-beige);
    border-radius: var(--radius-button);
    font-size: 0.9375rem;
    color: var(--color-grafito);
    background: var(--color-blanco);
    transition: border-color var(--transition-base);
    font-family: var(--font-inter);
  }

  .lf-form input:focus {
    outline: none;
    border-color: var(--color-verde-montana);
  }

  .lf-form input:invalid:not(:placeholder-shown) {
    border-color: var(--color-terracota);
  }

  .lf-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-gris);
    margin-bottom: 1rem;
    cursor: pointer;
    line-height: 1.45;
  }

  .lf-checkbox input {
    margin-top: 0.15rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .lf-submit {
    width: 100%;
    padding: 1rem 1.5rem;
    background: var(--color-verde-montana);
    color: var(--color-blanco);
    border: none;
    border-radius: var(--radius-button);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: background var(--transition-base);
    font-family: var(--font-inter);
    letter-spacing: 0.01em;
  }

  .lf-submit:hover {
    background: #3D5535;
  }

  .lf-submit:disabled {
    background: var(--color-gris);
    cursor: not-allowed;
    opacity: 0.6;
  }

  .lf-feedback {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    text-align: center;
    min-height: 1.25rem;
  }

  .lf-feedback.success { color: var(--color-verde-montana); }
  .lf-feedback.error   { color: var(--color-terracota); }

  /* ---- DISCLAIMER ---- */
  .sf-disclaimer {
    font-size: 0.8rem;
    color: var(--color-gris);
    text-align: center;
    line-height: 1.55;
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }

  /* ---- NAV ---- */
  .sf-nav {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sf-nav-btn {
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-button);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all var(--transition-base);
    font-family: var(--font-inter);
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .sf-nav-btn-back {
    background: var(--color-blanco);
    color: var(--color-grafito);
    border: 2px solid var(--color-beige);
  }

  .sf-nav-btn-back:hover {
    border-color: var(--color-terracota);
    color: var(--color-terracota);
  }

  .sf-nav-btn-next {
    background: var(--color-terracota);
    color: var(--color-blanco);
    margin-left: auto;
  }

  .sf-nav-btn-next:hover {
    background: var(--color-terracota-hover);
  }
</style>

<script>
  import { generateDoughnutSVG, type BreakdownItem } from './budget-chart';
  import { generateBudgetPDF, type BudgetInfo } from './pdf-generator';

  // ---------------------------------------------------------------------------
  // Breakdown config: label + color + percentage of high budget
  // ---------------------------------------------------------------------------
  const BREAKDOWN_CONFIG: Record<string, Array<{ label: string; color: string; pct: number }>> = {
    bano: [
      { label: 'Albañileria y azulejos', color: '#4A6760', pct: 35 },
      { label: 'Sanitarios y griferia', color: '#C45C3E', pct: 25 },
      { label: 'Fontaneria', color: '#6B8F71', pct: 18 },
      { label: 'Electricidad', color: '#D4A843', pct: 10 },
      { label: 'Mano de obra', color: '#8B7355', pct: 12 },
    ],
    cocina: [
      { label: 'Muebles de cocina', color: '#4A6760', pct: 30 },
      { label: 'Electrodomesticos', color: '#C45C3E', pct: 22 },
      { label: 'Encimera', color: '#6B8F71', pct: 18 },
      { label: 'Albañileria', color: '#D4A843', pct: 15 },
      { label: 'Instalacion', color: '#8B7355', pct: 15 },
    ],
    integral: [
      { label: 'Albañileria', color: '#4A6760', pct: 28 },
      { label: 'Cocina + Baños', color: '#C45C3E', pct: 25 },
      { label: 'Instalaciones', color: '#6B8F71', pct: 18 },
      { label: 'Pintura', color: '#D4A843', pct: 14 },
      { label: 'Suelo', color: '#8B7355', pct: 15 },
    ],
    pintura: [
      { label: 'Mano de obra', color: '#4A6760', pct: 55 },
      { label: 'Materiales', color: '#C45C3E', pct: 30 },
      { label: 'Preparacion paredes', color: '#6B8F71', pct: 15 },
    ],
    suelo: [
      { label: 'Material', color: '#4A6760', pct: 50 },
      { label: 'Instalacion', color: '#C45C3E', pct: 30 },
      { label: 'Retirada suelo existente', color: '#6B8F71', pct: 12 },
      { label: 'Transporte y extras', color: '#D4A843', pct: 8 },
    ],
  };

  const CALCULATOR_LABELS: Record<string, string> = {
    bano: 'Reforma de Baño',
    cocina: 'Reforma de Cocina',
    integral: 'Reforma Integral',
    pintura: 'Pintura',
    suelo: 'Cambio de Suelo',
  };

  const CITY_LABELS: Record<string, string> = {
    bilbao: 'Bilbao',
    donostia: 'Donostia',
    vitoria: 'Vitoria-Gasteiz',
  };

  // ---------------------------------------------------------------------------
  // Init — runs when the page shows this component
  // ---------------------------------------------------------------------------
  function initStepFinal() {
    const el = document.getElementById('stepFinal') as HTMLElement | null;
    const loading = document.getElementById('stepFinalLoading');
    const content = document.getElementById('stepFinalContent');
    if (!el || !loading || !content) return;

    const calculatorType = el.dataset.calculatorType || 'integral';
    const city = (el.dataset.city || 'bilbao') as string;
    const cityLabel = CITY_LABELS[city] || city;
    const calcLabel = CALCULATOR_LABELS[calculatorType] || calculatorType;

    const low = parseInt(el.dataset.budgetLow || '0');
    const high = parseInt(el.dataset.budgetHigh || '0');
    const budgetLabel = el.dataset.budgetLabel || calcLabel;

    if (low <= 0 || high <= 0) {
      // Budget not set yet — parent will call reveal()
      return;
    }

    reveal(low, high, budgetLabel, calculatorType, city, cityLabel, el);
  }

  function reveal(
    low: number,
    high: number,
    budgetLabel: string,
    calculatorType: string,
    city: string,
    cityLabel: string,
    el: HTMLElement
  ) {
    const loading = document.getElementById('stepFinalLoading');
    const content = document.getElementById('stepFinalContent');
    if (!loading || !content) return;

    // Hide loading, show content
    loading.style.display = 'none';
    content.style.display = 'block';

    // Set budget range values
    const lowEl = document.getElementById('finalRangeLow');
    const highEl = document.getElementById('finalRangeHigh');
    const metaEl = document.getElementById('finalMeta');

    if (lowEl) lowEl.textContent = formatCurrency(low) + ' EUR';
    if (highEl) highEl.textContent = formatCurrency(high) + ' EUR';
    if (metaEl) {
      metaEl.textContent = budgetLabel + '  |  ' + cityLabel + '  |  ' +
        new Date().toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
    }

    // Build breakdown
    const config = BREAKDOWN_CONFIG[calculatorType] || BREAKDOWN_CONFIG['integral'];
    const breakdown: BreakdownItem[] = config.map(item => ({
      label: item.label,
      value: item.pct, // porcentaje (0-100) para el chart
      color: item.color,
      amount: Math.round(high * item.pct / 100), // euros absolutos para el PDF y tooltip
    }));

    // Render doughnut SVG
    const budgetDiv = document.getElementById('finalBudget');
    if (budgetDiv) {
      // Use a size that looks great on mobile (220px) and scales up on larger screens
      const chartSize = getChartSize();
      budgetDiv.innerHTML = generateDoughnutSVG(breakdown, chartSize);

      // Set total in the center
      const totalEl = budgetDiv.querySelector('[data-budget-total]') as HTMLElement | null;
      if (totalEl) totalEl.textContent = formatCurrency(high);

      // Tooltip: click-to-show, clamped to container
      const tooltip = budgetDiv.querySelector('.budget-chart-tooltip') as HTMLElement | null;
      budgetDiv.querySelectorAll('.budget-chart-segment').forEach(segment => {
        segment.addEventListener('click', (e) => {
          const seg = e.currentTarget as Element;
          if (!tooltip) return;
          tooltip.textContent = seg.dataset.tooltip || '';
          tooltip.classList.add('visible');

          // Position tooltip, clamp to container edges
          const containerRect = budgetDiv.getBoundingClientRect();
          const segRect = seg.getBoundingClientRect();
          let left = segRect.left + segRect.width / 2 - containerRect.left;
          const tooltipWidth = tooltip.offsetWidth || 160;
          left = Math.max(tooltipWidth / 2, Math.min(left, containerRect.width - tooltipWidth / 2));
          tooltip.style.left = left + 'px';
          tooltip.style.top = (segRect.top - containerRect.top) + 'px';
        });
      });

      budgetDiv.addEventListener('click', (e) => {
        const target = e.target as Element;
        if (!target.closest('.budget-chart-segment') && tooltip) {
          tooltip.classList.remove('visible');
        }
      });
    }

    // PDF button
    const pdfBtn = document.getElementById('downloadPdfBtn');
    pdfBtn?.addEventListener('click', async () => {
      const { generateBudgetPDF } = await import('./pdf-generator');
      const budget: BudgetInfo = {
        city: cityLabel,
        calculatorType: calculatorType as BudgetInfo['calculatorType'],
        calculatorLabel: budgetLabel,
        min: low,
        max: high,
        breakdown,
      };
      generateBudgetPDF(budget);
    });

    // Request quotes button
    const quotesBtn = document.getElementById('requestQuotesBtn');
    quotesBtn?.addEventListener('click', () => {
      window.location.href = '/empresas/';
    });

    // Back button
    const backBtn = document.getElementById('btn-back-final');
    backBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('stepfinal:back', { detail: { calculatorType } }));
    });

    // New calculation button
    const restartBtn = document.getElementById('btn-restart-final');
    restartBtn?.addEventListener('click', () => {
      window.location.reload();
    });

    // Lead capture form
    setupLeadForm(low, high, calculatorType, cityLabel, budgetLabel);
  }

  /** Choose chart SVG size based on viewport width */
  function getChartSize(): number {
    if (typeof window === 'undefined') return 220;
    if (window.innerWidth >= 1024) return 280;
    if (window.innerWidth >= 768) return 260;
    if (window.innerWidth >= 640) return 240;
    return 220;
  }

  // ---------------------------------------------------------------------------
  // Lead capture — Axonflow integration
  // ---------------------------------------------------------------------------
  function setupLeadForm(
    low: number,
    high: number,
    calculatorType: string,
    city: string,
    calcLabel: string
  ) {
    const form = document.getElementById('leadCaptureForm') as HTMLFormElement | null;
    const feedback = document.getElementById('leadFeedback');
    const submitBtn = document.getElementById('leadSubmitBtn') as HTMLButtonElement | null;
    if (!form || !feedback || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const emailInput = document.getElementById('leadEmail') as HTMLInputElement;
      const phoneInput = document.getElementById('leadPhone') as HTMLInputElement;
      const consentInput = document.getElementById('leadConsent') as HTMLInputElement;

      if (!form.checkValidity()) {
        feedback.textContent = 'Por favor, completa todos los campos correctamente.';
        feedback.className = 'lf-feedback error';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      feedback.textContent = '';

      const payload = {
        email: emailInput.value.trim(),
        phone: phoneInput.value.trim(),
        source: 'bilbao-reforma-calculadora',
        calculator_type: calculatorType,
        city: city,
        budget_min: low,
        budget_max: high,
        budget_label: calcLabel,
        consent: consentInput.checked,
        utm_source: new URLSearchParams(window.location.search).get('utm_source') || '',
      };

      try {
        const res = await fetch('https://api.axonflow.es/public/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          feedback.textContent = 'Datos enviados. Te contactaremos pronto con tu desglose.';
          feedback.className = 'lf-feedback success';
          form.reset();
        } else {
          feedback.textContent = 'Error al enviar. Intentalo de nuevo o llamanos.';
          feedback.className = 'lf-feedback error';
        }
      } catch {
        feedback.textContent = 'Error de conexion. Verifica tu red e intentalo de nuevo.';
        feedback.className = 'lf-feedback error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Recibir desglose completo';
      }
    });
  }

  // ---------------------------------------------------------------------------
  // Public API — called by parent calculator page after computing budget
  // ---------------------------------------------------------------------------
  (window as any).stepFinalReveal = reveal;

  // Auto-init when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStepFinal);
  } else {
    initStepFinal();
  }

  function formatCurrency(n: number): string {
    return n.toLocaleString('es-ES');
  }
</script>
