<script>
  // ============================================================
  // IMPROVEMENTS 1 & 2: Progress bar + localStorage persistence
  // ============================================================

  (function initCalculatorShell() {
    const wizard = document.querySelector('.calculator-wizard') as HTMLElement | null;
    if (!wizard) return;

    const calculatorType = wizard.dataset.calculatorType || 'integral';
    const city = wizard.dataset.city || 'bilbao';
    const STORAGE_KEY = `bilbao-reforma-calc-${calculatorType}-${city}`;

    const progressBar = document.getElementById('progressBar');
    const progressBarText = document.getElementById('progressBarText');
    const progressBarPct = document.getElementById('progressBarPct');
    const progressBarFill = document.getElementById('progressBarFill');

    // Count real wizard steps dynamically (works for both 7-step Bilbao and 6-step Donostia/Vitoria)
    const wizardSteps = document.querySelectorAll('.wizard-step');
    const stepperSteps = document.querySelectorAll('.stepper-step');
    const totalSteps = wizardSteps.length || stepperSteps.length;

    // ---- Progress bar update ----
    function updateProgressBar(currentStep: number) {
      if (!progressBar || !progressBarText || !progressBarPct || !progressBarFill) return;
      const pct = Math.round(((currentStep - 1) / (totalSteps - 1)) * 100);
      progressBar.setAttribute('aria-valuenow', String(currentStep));
      progressBarText.textContent = `Paso ${currentStep} de ${totalSteps}`;
      progressBarPct.textContent = `${pct}%`;
      progressBarFill.style.width = `${pct}%`;
    }

    // Expose to pages so they can call updateProgressBar on step change
    (window as any).updateCalcProgress = updateProgressBar;

    // ---- localStorage helpers ----
    function getStorageData(): { step: number; state: any } | null {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        return JSON.parse(raw);
      } catch { return null; }
    }

    function saveStateToStorage(step: number, state: any) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ step, state }));
      } catch { /* storage blocked */ }
    }

    function clearStorage() {
      try { localStorage.removeItem(STORAGE_KEY); } catch { /* noop */ }
    }

    // Expose save/clear for pages
    (window as any).saveCalculatorState = (step: number, state: any) => saveStateToStorage(step, state);
    (window as any).clearCalculatorState = () => clearStorage();

    // ---- Restore modal ----
    const restoreModal = document.getElementById('restoreModal');
    const restoreBtn = document.getElementById('restoreBtn');
    const restartBtn = document.getElementById('restartBtn');
    let pendingRestore: { step: number; state: any } | null = null;

    function showRestoreModal(saved: { step: number; state: any }) {
      if (!restoreModal) return;
      pendingRestore = saved;
      restoreModal.removeAttribute('hidden');
      // Focus trap
      restoreBtn?.focus();
    }

    function hideRestoreModal() {
      if (!restoreModal) return;
      restoreModal.setAttribute('hidden', '');
      pendingRestore = null;
    }

    function applyRestore() {
      if (!pendingRestore) return;
      // Dispatch custom event that pages listen to
      window.dispatchEvent(new CustomEvent('calculator:restore', {
        detail: { step: pendingRestore.step, state: pendingRestore.state }
      }));
      hideRestoreModal();
    }

    restoreBtn?.addEventListener('click', applyRestore);
    restartBtn?.addEventListener('click', () => { clearStorage(); hideRestoreModal(); });

    // Close on ESC / overlay click
    restoreModal?.addEventListener('click', (e) => {
      if (e.target === restoreModal) { clearStorage(); hideRestoreModal(); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && restoreModal && !restoreModal.hasAttribute('hidden')) {
        clearStorage(); hideRestoreModal();
      }
    });

    // Check for saved state on load
    const saved = getStorageData();
    if (saved && saved.step > 1) {
      showRestoreModal(saved);
    }

    // Listen for wizard complete to clear storage
    window.addEventListener('stepfinal:back', clearStorage);
  })();
</script>
