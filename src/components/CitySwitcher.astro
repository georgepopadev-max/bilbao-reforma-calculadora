---
export interface Props {
  currentCity?: 'bilbao' | 'donostia' | 'vitoria';
  depth?: string;
}
const { currentCity = 'bilbao', depth = '' } = Astro.props;

const cities = [
  { id: 'bilbao', name: 'Bilbao', subpath: '' },
  { id: 'donostia', name: 'Donostia', subpath: 'donostia' },
  { id: 'vitoria', name: 'Vitoria', subpath: 'vitoria' },
];
---
<div class="city-switcher">
  <span class="city-switcher-label">Ciudad:</span>
  <div class="city-switcher-buttons">
    {cities.map(city => (
      <a
        href={city.subpath ? `${depth}${city.subpath}/index.html` : `${depth}index.html`}
        class={`city-btn ${currentCity === city.id ? 'city-btn-active' : ''}`}
        aria-current={currentCity === city.id ? 'page' : undefined}
      >
        {city.name}
      </a>
    ))}
  </div>
</div>

<style>
  .city-switcher {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }
  .city-switcher-label {
    color: var(--color-gris);
    font-weight: 500;
  }
  .city-switcher-buttons {
    display: flex;
    gap: 0.375rem;
  }
  .city-btn {
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 500;
    color: var(--color-gris);
    background: var(--color-crema);
    border: 1px solid var(--color-beige);
    transition: all 0.2s;
    font-size: 0.75rem;
  }
  .city-btn:hover {
    color: var(--color-terracota);
    border-color: var(--color-terracota-light);
    text-decoration: none;
  }
  .city-btn-active {
    background: var(--color-terracota);
    color: var(--color-blanco) !important;
    border-color: var(--color-terracota);
  }
</style>