---
/**
 * Caja que lleva a la calculadora. Se usa en landings (variant "hero")
 * y dentro de los artículos del blog (variant "inline").
 * data-cta permite distinguir cada caja en GA4.
 */
export interface Props {
  href: string;
  title: string;
  text?: string;
  button?: string;
  formHref?: string;
  dataCta: string;
  variant?: 'hero' | 'inline';
  points?: string[];
}
const {
  href,
  title,
  text,
  button = 'Calcular mi presupuesto',
  formHref,
  dataCta,
  variant = 'inline',
  points = [],
} = Astro.props;
---

<aside class={`calc-cta calc-cta--${variant}`} aria-label="Calculadora de presupuesto">
  <p class="calc-cta-title">{title}</p>
  {text && <p class="calc-cta-text">{text}</p>}
  {points.length > 0 && (
    <ul class="calc-cta-points">
      {points.map((pt) => <li>{pt}</li>)}
    </ul>
  )}
  <div class="calc-cta-actions">
    <a class="calc-cta-btn" href={href} data-cta={dataCta}>{button} →</a>
    {formHref && <a class="calc-cta-link" href={formHref} data-cta={`${dataCta}-form`}>o pide 3 presupuestos gratis</a>}
  </div>
</aside>

<style>
  .calc-cta {
    background: #FFF6F1;
    border: 1px solid #EDD5CA;
    border-left: 4px solid #C45C3E;
    border-radius: 12px;
    padding: 1.25rem 1.25rem 1.375rem;
    margin: 1.75rem 0;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .calc-cta--hero {
    max-width: 760px;
    margin: 1.5rem auto 2rem;
    border-left-width: 1px;
    text-align: center;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 2px 10px rgba(45, 30, 15, 0.06);
  }
  .calc-cta-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.1875rem;
    font-weight: 700;
    color: #2D2D2D;
    line-height: 1.3;
    margin: 0 0 0.375rem;
  }
  .calc-cta--hero .calc-cta-title { font-size: 1.375rem; }
  .calc-cta-text {
    font-size: 0.9375rem;
    color: #5A5A5A;
    line-height: 1.55;
    margin: 0 0 0.875rem;
  }
  .calc-cta-points {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .calc-cta-points li {
    background: #fff;
    border: 1px solid #EDD5CA;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: #2D2D2D;
  }
  .calc-cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .calc-cta--hero .calc-cta-actions { justify-content: center; }
  .calc-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.5rem;
    background: #C45C3E;
    color: #fff !important;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none !important;
  }
  .calc-cta-btn:hover { background: #A94B30; }
  .calc-cta-link {
    color: #C45C3E;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .calc-cta-btn { width: 100%; }
    .calc-cta-actions { justify-content: center; }
  }
</style>
