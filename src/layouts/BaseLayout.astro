---
import '../styles/tailwind.css';
import '../styles/components.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  jsonSchemas?: any[];
}

const {
  title,
  description = 'Bilbao Reforma - La calculadora de presupuestos de reformas más completa para Bilbao y Bizkaia.',
  canonical,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogLocale = 'es_ES',
  ogImage,
  ogImageWidth = '1200',
  ogImageHeight = '630',
  ogImageAlt,
  noindex = false,
  jsonSchemas = [],
} = Astro.props;

const siteUrl = 'https://www.bilbaoreforma.es';
const fullTitle = title.includes('Bilbao Reforma') ? title : `${title} | Bilbao Reforma`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
// Default og:image — falls back to the home OG image; pages can override via ogImage prop.
const defaultOgImage = `${siteUrl}/images/og/home-og.jpg`;
const resolvedOgImage = ogImage || defaultOgImage;
const resolvedOgImageAlt = ogImageAlt || fullTitle;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <!-- hreflang for multi-city SEO -->
  <link rel="alternate" hreflang="es-ES" href={canonicalUrl}>
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`}>
  <link rel="alternate" hreflang="eu-ES" href={`${siteUrl}/donostia`}>
  <link rel="alternate" hreflang="es-ES" href={`${siteUrl}/donostia`}>
  <link rel="alternate" hreflang="eu-ES" href={`${siteUrl}/vitoria`}>
  <link rel="alternate" hreflang="es-ES" href={`${siteUrl}/vitoria`}>

  <!-- Open Graph -->
  <meta property="og:title" content={ogTitle || fullTitle}>
  <meta property="og:description" content={ogDescription || description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content={ogLocale}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="Bilbao Reforma">
  <meta property="og:image" content={resolvedOgImage}>
  <meta property="og:image:width" content={ogImageWidth}>
  <meta property="og:image:height" content={ogImageHeight}>
  <meta property="og:image:alt" content={resolvedOgImageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={resolvedOgImage}>

  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MJNJJ3L6');
  </script>

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- JSON-LD Schemas -->
  {jsonSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Named head slot for page-specific injected scripts (e.g. BreadcrumbList) -->
  <slot name="head" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MJNJJ3L6"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <slot />

  <!-- Mobile menu: handled by src/scripts/header-mobile.js -->
</body>
</html>