---
import '../styles/tailwind.css';
import '../styles/components.css';
import { SITE_URL, absoluteUrl } from '../lib/urls';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  jsonSchemas?: any[];
}

const {
  title,
  description = 'Bilbao Reforma - La calculadora de presupuestos de reformas más completa para Bilbao y Bizkaia.',
  canonical,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogLocale = 'es_ES',
  ogImage,
  ogImageWidth = '1200',
  ogImageHeight = '630',
  ogImageAlt,
  noindex = false,
  jsonSchemas = [],
} = Astro.props;

const siteUrl = SITE_URL;
// La marca solo se añade si el título sigue cabiendo en ~60 caracteres
const BRAND_SUFFIX = ' | Bilbao Reforma';
const fullTitle = title.includes('Bilbao Reforma') || title.length + BRAND_SUFFIX.length > 60 ? title : `${title}${BRAND_SUFFIX}`;
// Siempre el formato canónico (sin .html ni barra final), aunque la página pase otro
const canonicalUrl = absoluteUrl(canonical || Astro.url.pathname);
// Default og:image — falls back to the home OG image; pages can override via ogImage prop.
const defaultOgImage = `${siteUrl}/images/og/home-og.jpg`;
const resolvedOgImage = ogImage || defaultOgImage;
const resolvedOgImageAlt = ogImageAlt || fullTitle;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph -->
  <meta property="og:title" content={ogTitle || fullTitle}>
  <meta property="og:description" content={ogDescription || description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content={ogLocale}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="Bilbao Reforma">
  <meta property="og:image" content={resolvedOgImage}>
  <meta property="og:image:width" content={ogImageWidth}>
  <meta property="og:image:height" content={ogImageHeight}>
  <meta property="og:image:alt" content={resolvedOgImageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={resolvedOgImage}>

  <!-- Google tag (gtag.js) — loaded dynamically only after cookie consent -->

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- JSON-LD Schemas -->
  {jsonSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Named head slot for page-specific injected scripts (e.g. BreadcrumbList) -->
  <slot name="head" />
</head>
<body>
  <slot />

  <!-- Cookie Consent Banner -->
  <div id="cookie-banner" style="display:none;">
    <div class="cb-inner">
      <p class="cb-text">
        Usamos cookies analíticas (Google Analytics) solo si las aceptas.
        <a href="/politica-privacidad">Más información</a>
      </p>
      <div class="cb-actions">
        <button id="cookie-reject" class="cb-btn cb-reject" type="button">Rechazar</button>
        <button id="cookie-accept" class="cb-btn cb-accept" type="button">Aceptar</button>
      </div>
    </div>
  </div>
  <style is:global>
    /* Banner compacto: en móvil ocupaba ~20% de la pantalla y tapaba la calculadora */
    #cookie-banner { position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999; background: #FAF7F2; border-top: 1px solid #E8E2D9; padding: 0.625rem 1rem; box-shadow: 0 -2px 8px rgba(45,30,15,0.08); font-family: 'Inter', system-ui, sans-serif; }
    #cookie-banner .cb-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    #cookie-banner .cb-text { margin: 0; color: #2D2D2D; font-size: 0.8125rem; line-height: 1.4; flex: 1; min-width: 0; }
    #cookie-banner .cb-text a { color: #C45C3E; text-decoration: underline; }
    #cookie-banner .cb-actions { display: flex; gap: 0.5rem; flex-shrink: 0; }
    #cookie-banner .cb-btn { border: none; border-radius: 8px; padding: 0.5rem 0.75rem; cursor: pointer; font-size: 0.8125rem; font-family: inherit; font-weight: 500; min-height: 40px; }
    #cookie-banner .cb-reject { background: #6B6B6B; color: #fff; }
    #cookie-banner .cb-accept { background: #C45C3E; color: #fff; }
  </style>

  <script is:inline>
    (function() {
      var banner = document.getElementById('cookie-banner');
      var btnAccept = document.getElementById('cookie-accept');
      var btnReject = document.getElementById('cookie-reject');

      function loadGtag() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-STSLR4MMDQ');
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-STSLR4MMDQ';
        document.head.appendChild(script);
      }

      function showBanner() {
        if (banner) banner.style.display = 'block';
      }

      function hideBanner() {
        if (banner) banner.style.display = 'none';
      }

      function handleAccept() {
        localStorage.setItem('cookie_consent', 'accepted');
        hideBanner();
        loadGtag();
      }

      function handleReject() {
        localStorage.setItem('cookie_consent', 'rejected');
        hideBanner();
      }

      // Init
      var consent = localStorage.getItem('cookie_consent');
      if (consent === 'accepted') {
        hideBanner();
        loadGtag();
      } else if (consent === 'rejected') {
        hideBanner();
      } else {
        showBanner();
      }

      if (btnAccept) btnAccept.addEventListener('click', handleAccept);
      if (btnReject) btnReject.addEventListener('click', handleReject);
    })();
  </script>

  <!-- Mobile menu: handled by src/scripts/header-mobile.js -->
</body>
</html>