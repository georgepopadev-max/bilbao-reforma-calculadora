---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import ArticleMeta from '../components/ArticleMeta.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  category?: string;
  city?: string;
  date?: string;
  readTime?: string;
  breadcrumbs: Array<{ name: string; href: string }>;
  faqs?: Array<{ q: string; a: string }>;
  jsonSchemas?: any[];
}

const {
  title,
  description,
  canonical,
  category,
  city = 'bilbao',
  date,
  readTime,
  breadcrumbs,
  faqs = [],
  jsonSchemas = [],
} = Astro.props;

// Build FAQPage schema
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
} : null;

// Breadcrumb schema
const breadcrumbSchema = BreadcrumbSchema ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: crumb.href.startsWith('http') ? crumb.href : `https://www.bilbaoreforma.es${crumb.href}`,
  })),
} : null;

const allSchemas = [breadcrumbSchema, faqSchema, ...jsonSchemas].filter(Boolean);
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonSchemas={allSchemas}
>
  <Header city={city} />
  <slot />
  <Footer city={city} />
</BaseLayout>