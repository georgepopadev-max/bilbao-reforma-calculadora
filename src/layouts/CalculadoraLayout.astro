---
/**
 * CalculadoraLayout — Para páginas de calculadora
 *
 * Extends BaseLayout.astro y usa los componentes Astro <Header> y <Footer>
 * (que sí generan los data-astro-cid-* y estilos scoped correctos)
 */

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  city?: 'bilbao' | 'donostia' | 'vitoria';
  calculatorType?: 'integral' | 'bano' | 'cocina' | 'pintura' | 'suelo';
  minPrice?: number;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  canonical,
  city = 'bilbao',
  calculatorType = 'integral',
  minPrice,
  ogImage,
  ogImageAlt,
} = Astro.props;

const calculatorLabels: Record<string, string> = {
  integral: 'Reforma Integral',
  bano: 'Reforma de Baño',
  cocina: 'Reforma de Cocina',
  pintura: 'Pintura',
  suelo: 'Cambio de Suelo',
};

const currentCalculator = calculatorLabels[calculatorType] ?? 'Reforma';
---

<BaseLayout
  title={title.includes("Bilbao Reforma") ? title : `${title} | Bilbao Reforma`}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <Header city={city} section="calculadora" />

  <main id="main-content" class="calculator-main">
    <slot />

    {minPrice && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: currentCalculator,
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'Web',
        offers: {
          '@type': 'Offer',
          price: minPrice,
          priceCurrency: 'EUR',
        },
        areaServed: {
          '@type': 'City',
          name: city.charAt(0).toUpperCase() + city.slice(1),
        },
      })} />
    )}
  </main>

  <Footer city={city} />
</BaseLayout>
