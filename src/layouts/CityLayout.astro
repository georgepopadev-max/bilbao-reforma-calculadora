---
/**
 * CityLayout — Para páginas de Donostia y Vitoria
 *
 * Extends BaseLayout.astro y usa componentes Astro <Header> y <Footer>
 * (que sí generan los `data-astro-cid-*` y estilos scoped correctos)
 */

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  city: 'donostia' | 'vitoria';
  section?: 'root' | 'blog' | 'calculadora' | 'empresas';
  schemaData?: Record<string, any>;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  canonical,
  city,
  section = 'root',
  schemaData,
  ogImage,
  ogImageAlt,
} = Astro.props;

const cityNames: Record<string, string> = {
  donostia: 'Donostia-San Sebastián',
  vitoria: 'Vitoria-Gasteiz',
};

const citySlugs: Record<string, string> = {
  donostia: 'donostia',
  vitoria: 'vitoria',
};

const currentCity = cityNames[city] ?? city;

const schema = schemaData ?? {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `Reforma ${currentCity}`,
  description: description ?? `Calculadora de presupuestos de reformas en ${currentCity} y ${city === 'donostia' ? 'Gipuzkoa' : 'Álava'}.`,
  url: `https://www.bilbaoreforma.es/${citySlugs[city]}/`,
  areaServed: {
    '@type': 'State',
    name: city === 'donostia' ? 'Gipuzkoa' : 'Álava',
  },
};
---

<BaseLayout
  title={title.includes("Bilbao Reforma") ? title : `${title} | Bilbao Reforma`}
  description={description}
  canonical={canonical}
  jsonSchemas={[schema]}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <Header city={city} section={section} />

  <!-- Main Content -->
  <main id="main-content">
    <slot />
  </main>

  <Footer city={city} />
</BaseLayout>
