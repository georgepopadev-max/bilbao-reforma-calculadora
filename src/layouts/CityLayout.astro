---
/**
 * CityLayout — Para páginas de Donostia y Vitoria
 * A3 Zone
 * 
 * Extends BaseLayout.astro y añade:
 * - Header con city switcher
 * - Schema LocalBusiness dinámico por ciudad
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  city: 'donostia' | 'vitoria';
  schemaData?: Record<string, any>;
}

const {
  title,
  description,
  canonical,
  city,
  schemaData,
} = Astro.props;

const cityNames: Record<string, string> = {
  donostia: 'Donostia-San Sebastián',
  vitoria: 'Vitoria-Gasteiz',
};

const citySlugs: Record<string, string> = {
  donostia: 'donostia',
  vitoria: 'vitoria',
};

const currentCity = cityNames[city] ?? city;

const schema = schemaData ?? {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `Reforma ${currentCity}`,
  description: description ?? `Calculadora de presupuestos de reformas en ${currentCity} y ${city === 'donostia' ? 'Gipuzkoa' : 'Álava'}.`,
  url: `https://www.bilbaoreforma.es/${citySlugs[city]}/`,
  areaServed: {
    '@type': city === 'donostia' ? 'State' : 'State',
    name: city === 'donostia' ? 'Gipuzkoa' : 'Álava',
  },
};
---

<BaseLayout
  title={title.includes("Bilbao Reforma") ? title : `${title} | Bilbao Reforma`}
  description={description}
  canonical={canonical}
  jsonSchemas={[schema]}
>
  <!-- Header -->
  <header class="site-header">
    <div class="header-container">
      <a href={`/${citySlugs[city]}/index.html`} class="header-logo">
        <svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span class="header-logo-text">Bilbao Reforma</span>
      </a>
      <div class="header-divider" aria-hidden="true"></div>
      
      <!-- City Switcher -->
      <nav class="city-switcher" aria-label="Cambiar de ciudad">
        <button type="button" class="city-switcher-toggle" id="citySwitcherToggle" aria-expanded="false" aria-haspopup="true">
          <span class="city-switcher-pin" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </span>
          <span class="city-switcher-label">Cubrimos</span>
          <span class="city-switcher-current">{currentCity}</span>
          <svg class="city-switcher-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="city-switcher-menu" id="citySwitcherMenu" role="menu">
          <div class="city-switcher-menu-header">
            <span class="city-switcher-menu-title">Elige tu ciudad</span>
            <span class="city-switcher-menu-subtitle">Cobertura completa en las 3 capitales</span>
          </div>
          <a href="/index.html" class="city-switcher-link" role="menuitem">
            <span class="city-switcher-link-icon" aria-hidden="true">📍</span>
            <span class="city-switcher-link-content">
              <span class="city-switcher-link-name">Bilbao</span>
              <span class="city-switcher-link-region">Vizcaya · Bizkaia</span>
            </span>
          </a>
          {city !== 'vitoria' && (
            <a href="/vitoria/index.html" class="city-switcher-link" role="menuitem">
              <span class="city-switcher-link-icon" aria-hidden="true">📍</span>
              <span class="city-switcher-link-content">
                <span class="city-switcher-link-name">Vitoria-Gasteiz</span>
                <span class="city-switcher-link-region">Álava · Araba</span>
              </span>
            </a>
          )}
          {city !== 'donostia' && (
            <a href="/donostia/index.html" class="city-switcher-link" role="menuitem">
              <span class="city-switcher-link-icon" aria-hidden="true">📍</span>
              <span class="city-switcher-link-content">
                <span class="city-switcher-link-name">Donostia-San Sebastián</span>
                <span class="city-switcher-link-region">Guipúzcoa · Gipuzkoa</span>
              </span>
            </a>
          )}
        </div>
      </nav>

      <nav class="header-nav" aria-label="Navegación principal" style="display: flex; gap: 2rem; align-items: center;">
        <a href={`/${citySlugs[city]}/calculadora/index.html`} class="header-nav-link" style="padding: 0.5rem 0;">Calculadora</a>
        <a href={`/${citySlugs[city]}/blog/index.html`} class="header-nav-link" style="padding: 0.5rem 0;">Blog</a>
        <a href={`/${citySlugs[city]}/empresas/index.html`} class="header-nav-link" style="padding: 0.5rem 0;">Empresas</a>
        <a href="/contacto.html" class="header-nav-link header-nav-link-cta" style="padding: 0.5rem 0;">Contacto</a>
      </nav>

      <button class="header-mobile-toggle" id="mobileToggle" aria-label="Abrir menú" aria-expanded="false">
        <svg class="header-mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-nav">
      <a href={`/${citySlugs[city]}/calculadora/index.html`} class="mobile-nav-link">Calculadora</a>
      <a href={`/${citySlugs[city]}/blog/index.html`} class="mobile-nav-link">Blog</a>
      <a href={`/${citySlugs[city]}/empresas/index.html`} class="mobile-nav-link">Empresas</a>
      <a href="/contacto.html" class="mobile-nav-link">Contacto</a>
    </nav>
  </div>

  <!-- Main Content -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-grid">
        <div class="footer-col footer-col-brand">
          <a href="/index.html" class="footer-logo">
            <svg class="footer-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Bilbao Reforma</span>
          </a>
          <p class="footer-brand-desc">Directorio de empresas de reformas verificadas y calculadora de presupuestos online para Bilbao, Donostia y Vitoria-Gasteiz.</p>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Navegación</h4>
          <nav class="footer-nav">
            <a href={`/${citySlugs[city]}/calculadora/index.html`} class="footer-nav-link">Calculadora</a>
            <a href={`/${citySlugs[city]}/blog/index.html`} class="footer-nav-link">Blog</a>
            <a href={`/${citySlugs[city]}/empresas/index.html`} class="footer-nav-link">Empresas</a>
            <a href="/contacto.html" class="footer-nav-link">Contacto</a>
          </nav>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Ciudades</h4>
          <nav class="footer-nav">
            <a href="/index.html" class="footer-nav-link">Bilbao</a>
            <a href="/donostia/index.html" class="footer-nav-link">Donostia</a>
            <a href="/vitoria/index.html" class="footer-nav-link">Vitoria-Gasteiz</a>
          </nav>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Legal</h4>
          <nav class="footer-nav">
            <a href="/aviso-legal.html" class="footer-nav-link">Aviso legal</a>
            <a href="/politica-privacidad.html" class="footer-nav-link">Política de privacidad</a>
          </nav>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Contacto</h4>
          <p class="footer-contact-info">
            <a href="tel:+34642147856" style="color:inherit;text-decoration:none;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              +34 642 147 856
            </a>
          </p>
          <p class="footer-contact-info">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            info@bilbaoreforma.es
          </p>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">© 2025–2026 Bilbao Reforma. Todos los derechos reservados.</p>
        <p class="footer-disclaimer">Precios orientativos. Consulta con empresas locales para presupuestos personalizados.</p>
      </div>
    </div>
  </footer>

  <!-- City switcher script -->
  <script>
    const toggle = document.getElementById('citySwitcherToggle');
    const menu = document.getElementById('citySwitcherMenu');
    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu?.classList.toggle('is-open', !expanded);
    });
    document.addEventListener('click', (e) => {
      if (!toggle?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
        toggle?.setAttribute('aria-expanded', 'false');
        menu?.classList.remove('is-open');
      }
    });
  </script>
</BaseLayout>
