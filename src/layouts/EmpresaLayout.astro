---
/**
 * EmpresaLayout — Para fichas de empresa individual
 * A3 Zone
 * 
 * Extends BaseLayout.astro y añade:
 * - Schema LocalBusiness/Organization con datos de la empresa
 * - Rating stars
 * - Servicios list
 * - Contacto CTA
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  empresa: {
    name: string;
    slug: string;
    phone: string;
    email?: string;
    address: string;
    services: string[];
    description: string;
    location: string;
    ratingValue?: string;
    reviewCount?: string;
    coordinates?: { lat: number; lng: number };
  };
}

const { empresa } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: empresa.name,
  description: empresa.description,
  url: `https://www.bilbaoreforma.es/empresas/${empresa.slug}.html`,
  telephone: empresa.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: empresa.location,
    addressRegion: 'Bizkaia',
    addressCountry: 'ES',
    streetAddress: empresa.address,
  },
  ...(empresa.coordinates && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: empresa.coordinates.lat,
      longitude: empresa.coordinates.lng,
    },
  }),
  ...(empresa.ratingValue && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: empresa.ratingValue,
      reviewCount: empresa.reviewCount ?? '0',
      bestRating: '5',
      worstRating: '1',
    },
  }),
  priceRange: '€€',
  areaServed: [
    { '@type': 'Place', name: empresa.location },
    { '@type': 'Place', name: 'Bilbao' },
    { '@type': 'Place', name: 'Bizkaia' },
  ],
  ...(empresa.services && empresa.services.length > 0 && {
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de reforma',
      itemListElement: empresa.services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s },
      })),
    },
  }),
};
---

<BaseLayout
  title={`${empresa.name} | Reformas en ${empresa.location} | Bilbao Reforma`}
  description={empresa.description}
  canonical={`https://www.bilbaoreforma.es/empresas/${empresa.slug}.html`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <!-- Header -->
  <header class="site-header">
    <div class="header-container">
      <a href="/index.html" class="header-logo">
        <svg class="header-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span class="header-logo-text">Bilbao Reforma</span>
      </a>
      <nav class="header-nav" aria-label="Navegación principal" style="display: flex; gap: 2rem; align-items: center;">
        <a href="/calculadora/index.html" class="header-nav-link" style="padding: 0.5rem 0;">Calculadora</a>
        <a href="/blog/index.html" class="header-nav-link" style="padding: 0.5rem 0;">Blog</a>
        <a href="/empresas/index.html" class="header-nav-link header-nav-link-active" style="padding: 0.5rem 0;">Empresas</a>
        <a href="/contacto.html" class="header-nav-link header-nav-link-cta" style="padding: 0.5rem 0;">Contacto</a>
      </nav>
      <button class="header-mobile-toggle" id="mobileToggle" aria-label="Abrir menú" aria-expanded="false">
        <svg class="header-mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-nav">
      <a href="/calculadora/index.html" class="mobile-nav-link">Calculadora</a>
      <a href="/blog/index.html" class="mobile-nav-link">Blog</a>
      <a href="/empresas/index.html" class="mobile-nav-link">Empresas</a>
      <a href="/contacto.html" class="mobile-nav-link">Contacto</a>
    </nav>
  </div>

  <!-- Main Content -->
  <main id="main-content" class="empresa-main">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/index.html">Bilbao Reforma</a>
          </li>
          <li class="breadcrumb-sep" aria-hidden="true">›</li>
          <li class="breadcrumb-item">
            <a href="/empresas/index.html">Empresas</a>
          </li>
          <li class="breadcrumb-sep" aria-hidden="true">›</li>
          <li class="breadcrumb-item is-current" aria-current="page">{empresa.name}</li>
        </ol>
      </nav>

      <!-- Empresa Hero -->
      <div class="empresa-hero">
        <div class="empresa-hero-content">
          <h1 class="empresa-name">{empresa.name}</h1>
          
          {empresa.ratingValue && (
            <div class="empresa-rating">
              <span class="rating-stars" aria-label={`${empresa.ratingValue} de 5`}>
                {'★'.repeat(Math.round(parseFloat(empresa.ratingValue)))}
                {'☆'.repeat(5 - Math.round(parseFloat(empresa.ratingValue)))}
              </span>
              <span class="rating-value">{empresa.ratingValue}/5</span>
              <span class="rating-count">({empresa.reviewCount} reseñas)</span>
            </div>
          )}

          <p class="empresa-description">{empresa.description}</p>

          <div class="empresa-contact-row">
            <a href={`tel:${empresa.phone.replace(/\s/g, '')}`} class="empresa-contact-btn empresa-contact-btn--phone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              {empresa.phone}
            </a>
            {empresa.email && (
              <a href={`mailto:${empresa.email}`} class="empresa-contact-btn empresa-contact-btn--email">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Enviar email
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Services -->
      <section class="empresa-services">
        <h2 class="empresa-section-title">Servicios</h2>
        <ul class="empresa-services-list">
          {empresa.services.map((service) => (
            <li class="empresa-service-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {service}
            </li>
          ))}
        </ul>
      </section>

      <!-- Info Grid -->
      <section class="empresa-info-grid">
        <div class="empresa-info-card">
          <h3 class="empresa-info-card-title">Dirección</h3>
          <p class="empresa-info-card-value">{empresa.address}</p>
        </div>
        <div class="empresa-info-card">
          <h3 class="empresa-info-card-title">Zona</h3>
          <p class="empresa-info-card-value">{empresa.location} y Bilbao</p>
        </div>
        <div class="empresa-info-card">
          <h3 class="empresa-info-card-title">Teléfono</h3>
          <p class="empresa-info-card-value">
            <a href={`tel:${empresa.phone.replace(/\s/g, '')}`}>{empresa.phone}</a>
          </p>
        </div>
        {empresa.email && (
          <div class="empresa-info-card">
            <h3 class="empresa-info-card-title">Email</h3>
            <p class="empresa-info-card-value">
              <a href={`mailto:${empresa.email}`}>{empresa.email}</a>
            </p>
          </div>
        )}
      </section>

      <!-- CTA -->
      <section class="empresa-cta">
        <h2 class="empresa-cta-title">¿Quieres un presupuesto?</h2>
        <p class="empresa-cta-text">Contacta con {empresa.name} directamente o usa nuestra calculadora para obtener un presupuesto orientativo.</p>
        <div class="empresa-cta-buttons">
          <a href={`tel:${empresa.phone.replace(/\s/g, '')}`} class="cta-button cta-button-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            Llamar ahora
          </a>
          <a href="/calculadora/index.html" class="cta-button cta-button-secondary">
            Calcular presupuesto
          </a>
        </div>
      </section>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-grid">
        <div class="footer-col footer-col-brand">
          <a href="/index.html" class="footer-logo">
            <svg class="footer-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Bilbao Reforma</span>
          </a>
          <p class="footer-brand-desc">Directorio de empresas de reformas verificadas y calculadora de presupuestos online.</p>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Navegación</h4>
          <nav class="footer-nav">
            <a href="/calculadora/index.html" class="footer-nav-link">Calculadora</a>
            <a href="/blog/index.html" class="footer-nav-link">Blog</a>
            <a href="/empresas/index.html" class="footer-nav-link">Empresas</a>
            <a href="/contacto.html" class="footer-nav-link">Contacto</a>
          </nav>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Legal</h4>
          <nav class="footer-nav">
            <a href="/aviso-legal.html" class="footer-nav-link">Aviso legal</a>
            <a href="/politica-privacidad.html" class="footer-nav-link">Política de privacidad</a>
          </nav>
        </div>
        <div class="footer-col">
          <h4 class="footer-col-title">Contacto</h4>
          <p class="footer-contact-info">
            <a href="tel:+34642147856" style="color:inherit;text-decoration:none;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              +34 642 147 856
            </a>
          </p>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">© 2025–2026 Bilbao Reforma. Todos los derechos reservados.</p>
        <p class="footer-disclaimer">Precios orientativos. Consulta con empresas locales para presupuestos personalizados.</p>
      </div>
    </div>
  </footer>
</BaseLayout>
