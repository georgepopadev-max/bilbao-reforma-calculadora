---
/**
 * EmpresaLayout — Para fichas de empresa individual
 * A3 Zone
 * 
 * Extends BaseLayout.astro y añade:
 * - Schema LocalBusiness/Organization con datos de la empresa
 * - Rating stars
 * - Servicios list
 * - Contacto CTA
 * - Historia / About section
 */

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  empresa: {
    name: string;
    slug: string;
    phone: string;
    email?: string;
    address: string;
    services: string[];
    description: string;
    history?: string;
    location: string;
    ratingValue?: string;
    reviewCount?: string;
    coordinates?: { lat: number; lng: number };
    areas?: string[];
  };
  ogImage?: string;
  ogImageAlt?: string;
}

const { empresa, ogImage, ogImageAlt } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: empresa.name,
  description: empresa.description,
  url: `https://www.bilbaoreforma.es/empresas/${empresa.slug}.html`,
  telephone: empresa.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: empresa.location,
    addressRegion: 'Bizkaia',
    addressCountry: 'ES',
    streetAddress: empresa.address,
  },
  ...(empresa.coordinates && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: empresa.coordinates.lat,
      longitude: empresa.coordinates.lng,
    },
  }),
  ...(empresa.ratingValue && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: empresa.ratingValue,
      reviewCount: empresa.reviewCount ?? '0',
      bestRating: '5',
      worstRating: '1',
    },
  }),
  priceRange: '€€',
  areaServed: [
    { '@type': 'Place', name: empresa.location },
    { '@type': 'Place', name: 'Bilbao' },
    { '@type': 'Place', name: 'Bizkaia' },
    ...(empresa.areas ? empresa.areas.map(a => ({ '@type': 'Place', name: a })) : []),
  ],
  ...(empresa.services && empresa.services.length > 0 && {
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de reforma',
      itemListElement: empresa.services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s },
      })),
    },
  }),
};
---

<BaseLayout
  title={`${empresa.name} | ${empresa.location} 2026`}
  description={`${empresa.description} Tel y servicios. Reseñas verificadas.`}
  canonical={`https://www.bilbaoreforma.es/empresas/${empresa.slug}.html`}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <!-- Header -->
  <Header city="bilbao" section="empresas" />

  <!-- Main Content -->
  <main id="main-content" class="empresa-main">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/index.html">Bilbao Reforma</a>
          </li>
          <li class="breadcrumb-sep" aria-hidden="true">›</li>
          <li class="breadcrumb-item">
            <a href="/empresas/index.html">Empresas</a>
          </li>
          <li class="breadcrumb-sep" aria-hidden="true">›</li>
          <li class="breadcrumb-item is-current" aria-current="page">{empresa.name}</li>
        </ol>
      </nav>

      <!-- Empresa Hero -->
      <div class="empresa-hero">
        <div class="empresa-hero-content">
          <h1 class="empresa-name">{empresa.name}</h1>
          
          {empresa.ratingValue && (
            <div class="empresa-rating">
              <span class="rating-stars" aria-label={`${empresa.ratingValue} de 5`}>
                {'★'.repeat(Math.round(parseFloat(empresa.ratingValue)))}
                {'☆'.repeat(5 - Math.round(parseFloat(empresa.ratingValue)))}
              </span>
              <span class="rating-value">{empresa.ratingValue}/5</span>
              <span class="rating-count">({empresa.reviewCount} reseñas)</span>
            </div>
          )}

          <p class="empresa-description">{empresa.description}</p>

          <div class="empresa-contact-row">
            <a href={`tel:${empresa.phone.replace(/\s/g, '')}`} class="empresa-contact-btn empresa-contact-btn--phone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              {empresa.phone}
            </a>
            {empresa.email && (
              <a href={`mailto:${empresa.email}`} class="empresa-contact-btn empresa-contact-btn--email">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Enviar email
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Historia / About -->
      {empresa.history && (
        <section class="empresa-about">
          <h2 class="empresa-section-title">Sobre {empresa.name}</h2>
          <p class="empresa-history">{empresa.history}</p>
        </section>
      )}

      <!-- Services -->
      <section class="empresa-services">
        <h2 class="empresa-section-title">Servicios</h2>
        <ul class="empresa-services-list">
          {empresa.services.map((service) => (
            <li class="empresa-service-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {service}
            </li>
          ))}
        </ul>
      </section>

      <!-- Info Grid -->
      <section class="empresa-info-grid">
        <div class="empresa-info-card">
          <h3 class="empresa-info-card-title">Dirección</h3>
          <p class="empresa-info-card-value">{empresa.address}</p>
        </div>
        <div class="empresa-info-card">
          <h3 class="empresa-info-card-title">Zona de actuación</h3>
          <p class="empresa-info-card-value">{empresa.location} y Bilbao{empresa.areas ? ', ' + empresa.areas.join(', ') : ''}</p>
        </div>
        <div class="empresa-info-card">
          <h3 class="empresa-info-card-title">Teléfono</h3>
          <p class="empresa-info-card-value">
            <a href={`tel:${empresa.phone.replace(/\s/g, '')}`}>{empresa.phone}</a>
          </p>
        </div>
        {empresa.email && (
          <div class="empresa-info-card">
            <h3 class="empresa-info-card-title">Email</h3>
            <p class="empresa-info-card-value">
              <a href={`mailto:${empresa.email}`}>{empresa.email}</a>
            </p>
          </div>
        )}
      </section>

      <!-- CTA -->
      <section class="empresa-cta">
        <h2 class="empresa-cta-title">¿Quieres un presupuesto?</h2>
        <p class="empresa-cta-text">Contacta con {empresa.name} directamente o usa nuestra calculadora para obtener un presupuesto orientativo.</p>
        <div class="empresa-cta-buttons">
          <a href={`tel:${empresa.phone.replace(/\s/g, '')}`} class="cta-button cta-button-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            Llamar ahora
          </a>
          <a href="/calculadora/index.html" class="cta-button cta-button-secondary">
            Calcular presupuesto
          </a>
        </div>
      </section>
    </div>
  </main>

  <!-- Footer -->
  <Footer city="bilbao" />
</BaseLayout>

<style>
  .empresa-main {
    background: var(--color-crema);
    min-height: 100vh;
  }
  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .breadcrumb-list {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--color-gris);
  }
  .breadcrumb-item a {
    color: var(--color-terracota);
    text-decoration: none;
  }
  .breadcrumb-item.is-current {
    color: var(--color-gris);
  }
  .breadcrumb-sep {
    color: var(--color-gris);
  }
  .empresa-hero {
    background: var(--color-blanco);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(45,30,15,.08);
    margin-bottom: 1.5rem;
  }
  .empresa-hero-content {
    text-align: center;
  }
  .empresa-name {
    font-family: var(--font-playfair);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-grafito);
    margin-bottom: 0.75rem;
  }
  .empresa-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }
  .rating-stars {
    color: #F5A623;
    letter-spacing: 2px;
  }
  .rating-value {
    font-weight: 600;
    color: var(--color-grafito);
  }
  .rating-count {
    color: var(--color-gris);
    font-size: 0.8125rem;
  }
  .empresa-description {
    font-size: 1rem;
    color: var(--color-gris);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  .empresa-contact-row {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .empresa-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .empresa-contact-btn--phone {
    background: var(--color-terracota);
    color: var(--color-blanco);
  }
  .empresa-contact-btn--phone:hover {
    background: #a84a32;
  }
  .empresa-contact-btn--email {
    background: var(--color-verde-montana);
    color: var(--color-blanco);
  }
  .empresa-contact-btn--email:hover {
    background: #3a5e30;
  }
  .empresa-about {
    background: var(--color-blanco);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    box-shadow: 0 2px 8px rgba(45,30,15,.08);
    margin-bottom: 1.5rem;
  }
  .empresa-section-title {
    font-family: var(--font-playfair);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-grafito);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-beige);
  }
  .empresa-history {
    font-size: 0.9375rem;
    color: var(--color-gris);
    line-height: 1.7;
    margin: 0;
  }
  .empresa-services {
    background: var(--color-blanco);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    box-shadow: 0 2px 8px rgba(45,30,15,.08);
    margin-bottom: 1.5rem;
  }
  .empresa-services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }
  .empresa-service-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-grafito);
  }
  .empresa-service-item svg {
    color: var(--color-verde-montana);
    flex-shrink: 0;
  }
  .empresa-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .empresa-info-card {
    background: var(--color-blanco);
    border-radius: 12px;
    padding: 1.25rem;
    box-shadow: 0 2px 8px rgba(45,30,15,.08);
  }
  .empresa-info-card-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gris);
    margin-bottom: 0.375rem;
  }
  .empresa-info-card-value {
    font-size: 0.9375rem;
    color: var(--color-grafito);
    font-weight: 500;
    margin: 0;
  }
  .empresa-info-card-value a {
    color: var(--color-terracota);
    text-decoration: none;
  }
  .empresa-cta {
    background: var(--color-terracota);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    color: var(--color-blanco);
    margin-bottom: 2rem;
  }
  .empresa-cta-title {
    font-family: var(--font-playfair);
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
    color: var(--color-blanco);
  }
  .empresa-cta-text {
    font-size: 0.9375rem;
    opacity: 0.9;
    margin-bottom: 1.25rem;
  }
  .empresa-cta-buttons {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .cta-button-primary {
    background: var(--color-blanco);
    color: var(--color-terracota);
  }
  .cta-button-primary:hover {
    background: var(--color-crema);
  }
  .cta-button-secondary {
    background: transparent;
    color: var(--color-blanco);
    border: 2px solid rgba(255,255,255,0.5);
  }
  .cta-button-secondary:hover {
    border-color: var(--color-blanco);
    background: rgba(255,255,255,0.1);
  }
  @media (max-width: 640px) {
    .empresa-cta-buttons {
      flex-direction: column;
    }
    .empresa-contact-row {
      flex-direction: column;
    }
  }
</style>
